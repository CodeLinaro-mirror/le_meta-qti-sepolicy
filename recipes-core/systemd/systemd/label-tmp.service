[Unit]
Description=label /tmp directory
ConditionSecurity=selinux
BindsTo=tmp.mount
DefaultDependencies=no
ConditionPathIsMountPoint=/tmp
RequiresMountsFor=/tmp

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
ExecStart=/sbin/restorecon -RD /tmp

[Install]
WantedBy=default.target
