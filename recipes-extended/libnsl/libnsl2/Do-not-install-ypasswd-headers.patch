From f10557e0e0a8fc2ca0bfb1cfccef0a62ce6ed231 Mon Sep 17 00:00:00 2001
From: Dennis Cagle <dcagle@codeaurora.org>
Date: Tue, 13 Nov 2018 17:32:34 -0800
Subject: [PATCH] Do not install ypasswd headers

The ypasswd header installs conflict with glibc

Change-Id: I154b7a3ba6ab25acb7e01ae55082561318584461
---
 src/Makefile.am | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/Makefile.am b/src/Makefile.am
index 792d846..d9de40c 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -19,10 +19,10 @@ AM_CPPFLAGS = -I$(srcdir) @TIRPC_CFLAGS@ -DLOCALEDIR=\"$(localedir)\"
 rpcsvc_HEADERS = rpcsvc/ypclnt.h rpcsvc/ypupd.h rpcsvc/yp_prot.h \
 	rpcsvc/yp.x rpcsvc/yp.h rpcsvc/nis_callback.h rpcsvc/nis.h \
 	rpcsvc/nis_object.x rpcsvc/nis.x rpcsvc/nis_callback.x \
-	rpcsvc/nislib.h rpcsvc/nis_tags.h rpcsvc/yppasswd.x \
-	rpcsvc/yppasswd.h
+	rpcsvc/nislib.h rpcsvc/nis_tags.h
 
-noinst_HEADERS = internal.h libc-lock.h nisplus/nis_intern.h nisplus/nis_xdr.h
+noinst_HEADERS = internal.h libc-lock.h nisplus/nis_intern.h \
+	nisplus/nis_xdr.h rpcsvc/yppasswd.x rpcsvc/yppasswd.h
 
 lib_LTLIBRARIES = libnsl.la
 
-- 
1.9.1

