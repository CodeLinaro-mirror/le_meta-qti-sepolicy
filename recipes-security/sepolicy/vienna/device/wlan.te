gen_require(`
    type wlan_initrc_t;
    type kernel_t;
    type wifi_data_t;
    type mount_t;
    type initrc_t;
    type data_t;
    type perf_hal_socket_t;
    type perf_hal_t;
')

type cnss_socket_t;
files_type(cnss_socket_t)

type cnss_sock_dir_t;
files_type(cnss_sock_dir_t)

type cnss_diag_conf_t;
files_type(cnss_diag_conf_t)

type qsahara_log_data_t;
files_type(qsahara_log_data_t)

type qsahara_dump_data_t;
files_type(qsahara_dump_data_t)

init_daemon_domain(wlan_initrc_t, wlan_initrc_exec_t)

allow wlan_initrc_t kernel_t:unix_dgram_socket sendto;

allow wlan_initrc_t wifi_data_t:dir rw_dir_perms;
allow wlan_initrc_t wifi_data_t:file rw_file_perms;

# Dir permissions needed to create/remove a socket file
allow wlan_initrc_t cnss_sock_dir_t:dir { write add_name remove_name search };

# Allow socket creation and removal (unlink needed on reboot when stale socket persists)
allow wlan_initrc_t cnss_socket_t:sock_file { create getattr unlink };

# Restrict transition only to this socket name (after restorecon labels dir as cnss_sock_dir_t)
type_transition wlan_initrc_t cnss_sock_dir_t:sock_file cnss_socket_t "cnss_user_server";

# cnss_daemon runs as mount_t; allow it to create and access cnss_socket_t sock_files
allow mount_t cnss_sock_dir_t:dir { write add_name search read };
allow mount_t cnss_socket_t:sock_file { create getattr };

# explicit process transition
allow initrc_t wlan_initrc_exec_t:file { read open getattr execute map };
allow initrc_t wlan_initrc_t:process transition;
type_transition initrc_t wlan_initrc_exec_t:process wlan_initrc_t;
allow wlan_initrc_t wlan_initrc_exec_t:file entrypoint;

# initrc_t path for cnss_diag.conf
allow initrc_t data_t:dir { add_name search };
type_transition initrc_t data_t:file cnss_diag_conf_t "cnss_diag.conf";

# keep the mount_t boot-time path
allow mount_t data_t:dir { add_name search };
type_transition mount_t data_t:file cnss_diag_conf_t "cnss_diag.conf";
allow mount_t cnss_diag_conf_t:file { create open read write append getattr setattr };

# wlan_initrc_t (cnss_diag) needs to read/append to cnss_diag.conf
allow wlan_initrc_t cnss_diag_conf_t:file { read append open getattr };

# initrc_t path for QSahara.log (qsaharaserver redirects stdout/stderr here)
type_transition initrc_t data_t:file qsahara_log_data_t "QSahara.log";
allow initrc_t qsahara_log_data_t:file { create write open getattr append };

# initrc_t path for FW dump files
type_transition initrc_t data_t:file qsahara_dump_data_t "meson_core.bin";
type_transition initrc_t data_t:file qsahara_dump_data_t "meson_mwss.bin";
type_transition initrc_t data_t:file qsahara_dump_data_t "meson_cmem.bin";
type_transition initrc_t data_t:file qsahara_dump_data_t "meson_dram.bin";
type_transition initrc_t data_t:file qsahara_dump_data_t "meson_iram.bin";
allow initrc_t qsahara_dump_data_t:file { create write open getattr append };

# cnss_daemon (wlan_initrc_t) reads FW dump files QSaharaServer creates
allow wlan_initrc_t qsahara_dump_data_t:file { read open getattr };

# cnss_daemon (wlan_initrc_t) writes to the perf HAL socket "perfservice"
allow wlan_initrc_t perf_hal_socket_t:sock_file write;
allow wlan_initrc_t perf_hal_t:unix_stream_socket connectto;
