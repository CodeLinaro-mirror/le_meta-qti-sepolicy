policy_module(dspload, 1.0)

type etc_start_dsp_t;
files_type(etc_start_dsp_t);

gen_require(`
    type mount_t;
    type adsprpcd_t;
')

allow mount_t etc_start_dsp_t:dir manage_dir_perms;
allow mount_t etc_start_dsp_t:file manage_file_perms;
allow mount_t etc_start_dsp_t:file execute;





