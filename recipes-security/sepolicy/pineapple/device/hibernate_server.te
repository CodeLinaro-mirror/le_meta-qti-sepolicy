policy_module(hibernate_server, 1.0)

type hibernate_server_t;
type hibernate_server_exec_t;
type hibernate_utility_exec_t;
type vendor_power_state_dev_t;
type hibernate_swap_partition_t;
dev_node(vendor_power_state_dev_t);
dev_node(hibernate_swap_partition_t);
dev_rw_sysfs(hibernate_server_t);

init_vendor_domain(hibernate_server_t, hibernate_server_exec_t);
init_vendor_domain(hibernate_server_t, hibernate_utility_exec_t);
logging_send_syslog_msg(hibernate_server_t);

mls_file_read_all_levels(hibernate_server_t);
mls_file_write_all_levels(hibernate_server_t);

# Socket management
type hibernate_socket_t;
type hibernate_notify_socket_t;
files_type(hibernate_socket_t);
files_type(hibernate_notify_socket_t);
dev_node(hibernate_socket_t);
dev_node(hibernate_notify_socket_t);
device_manage_socket_file(hibernate_server_t, hibernate_socket_t, "hibernate");
device_manage_socket_file(hibernate_server_t, hibernate_notify_socket_t,"hibernate_notify");

device_search_sockets(hibernate_server_t);

gen_require(`
    type sysctl_t;
    type sysctl_vm_t;
')

allow hibernate_server_t self:socket create;
allow hibernate_server_t self:socket rw_socket_perms;
allow hibernate_server_t hibernate_socket_t:dir manage_dir_perms;
allow hibernate_server_t hibernate_socket_t:file manage_file_perms;
allow hibernate_server_t hibernate_socket_t:sock_file manage_sock_file_perms;

allow hibernate_server_t hibernate_notify_socket_t:dir manage_dir_perms;
allow hibernate_server_t hibernate_notify_socket_t:file manage_file_perms;
allow hibernate_server_t hibernate_notify_socket_t:sock_file manage_sock_file_perms;

allow hibernate_socket_t device_t:filesystem associate;
allow hibernate_notify_socket_t device_t:filesystem associate;

userdebug_or_eng(`
    gen_require(`
        class dbus send_msg;
        type unconfined_t;
    ')

    allow unconfined_t initrc_t:dbus send_msg;
    allow initrc_t unconfined_t:dbus send_msg;
    allow hibernate_server_t unconfined_t:dbus send_msg;
')

ifdef(`init_systemd', `
    gen_require(`
        type firmware_t;
        type system_dbusd_var_run_t;
        type system_dbusd_t;
        type socket_device_t;
        type image_size_sysfs_t;
        type debugfs_t;
        class dbus acquire_svc;
    ')

    init_dbus_chat(hibernate_server_t);
    systemd_dbus_chat_logind(hibernate_server_t);
    dbus_system_bus_client(hibernate_server_t);

    init_read_state(hibernate_server_t);
    kernel_read_system_state(hibernate_server_t);

    allow hibernate_server_t system_dbusd_var_run_t:dir search;
    allow hibernate_server_t system_dbusd_var_run_t:sock_file write;

    allow hibernate_server_t system_dbusd_t:unix_stream_socket connectto;
    allow hibernate_server_t system_dbusd_t:dbus acquire_svc;

    allow hibernate_server_t vendor_power_state_dev_t:chr_file { open read write ioctl };

    allow hibernate_server_t firmware_t:dir search;
    allow hibernate_server_t firmware_t:file { open read };

    allow hibernate_server_t self:unix_stream_socket { connectto listen accept };
    allow hibernate_server_t self:capability { sys_nice sys_admin };

    allow hibernate_server_t sysctl_t:dir search;
    allow hibernate_server_t sysctl_vm_t:dir search;
    allow hibernate_server_t sysctl_vm_t:file write_file_perms;

    allow hibernate_server_t hibernate_swap_partition_t:blk_file { getattr open read write };
    allow hibernate_server_t self:lockdown integrity;

    allow hibernate_server_t image_size_sysfs_t:dir add_name;
    allow hibernate_server_t image_size_sysfs_t:file { create open getattr write };
    allow hibernate_server_t debugfs_t:dir search;

')
