gen_require(`
    attribute file_type;
    attribute user_data;
    attribute system_data;
    type mount_copybind_t;
    type unconfined_mount_t;
    type mount_t;
    type alsa_etc_t;
    type data_t;
    type system_dbusd_var_lib_t;
    type var_lib_t;
    type var_t;
    type wifi_data_t;
    type hwfde_conf_file_t;
    type overlay_t;
    type var_spool_t;
    type default_context_t;
')

#for overlayfs
allow mount_t hwfde_conf_file_t:file read_file_perms;

allow mount_t self:capability { dac_read_search };
allow mount_t wifi_data_t:sock_file manage_sock_file_perms;

allow mount_t overlay_t:chr_file { delete_chr_file_perms unlink };
allow mount_t overlay_t:dir manage_dir_perms;
allow mount_t overlay_t:file manage_file_perms;
allow mount_t var_t:chr_file unlink;
allow mount_t var_t:dir manage_dir_perms;
allow mount_t var_t:file manage_file_perms;

allow mount_t etc_t:dir mounton;
allow mount_copybind_t default_context_t:dir search;
allow mount_copybind_t var_spool_t:dir getattr;

allow mount_t data_t:dir manage_dir_perms;
allow mount_t data_t:file manage_file_perms;
allow mount_t data_t:chr_file { delete_chr_file_perms };

mls_process_read_to_clearance(unconfined_mount_t)
mls_process_write_to_clearance(unconfined_mount_t)
