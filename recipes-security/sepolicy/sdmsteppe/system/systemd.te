gen_require(`
    type post_boot_script_t;
    type overlay_t;
')

dontaudit systemd_modules_load_t kernel_t:process setsched;
dontaudit post_boot_script_t self:capability dac_override;
dontaudit systemd_update_done_t self:capability sys_admin; 
dontaudit systemd_modules_load_t self:capability sys_admin;
allow systemd_update_done_t overlay_t:dir rw_dir_perms;
allow systemd_logind_t proc_psi_t:file write;
