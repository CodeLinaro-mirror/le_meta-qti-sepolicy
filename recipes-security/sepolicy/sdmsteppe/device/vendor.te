type ashmem_devices_t;
dev_node(ashmem_devices_t);

gen_require(`
    type sysctl_irq_t;
    type kmsg_device_t;
    type leprop_t;
')

mls_file_write_to_clearance(post_boot_script_t)
allow post_boot_script_t kmsg_device_t:chr_file { open write };
allow post_boot_script_t leprop_t:unix_stream_socket connectto;
allow post_boot_script_t self:capability dac_override;
allow post_boot_script_t self:unix_stream_socket { read write };
allow post_boot_script_t sysctl_irq_t:dir { add_name search write };
allow post_boot_script_t sysctl_irq_t:file { create open write };
allow post_boot_script_t sysfs_t:dir { add_name write };
allow post_boot_script_t sysfs_t:file create;

allow sysctl_irq_t proc_t:filesystem associate;
