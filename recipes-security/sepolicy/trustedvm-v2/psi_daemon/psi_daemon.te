policy_module(psi_daemon, 1.0)

gen_require(`
    type proc_t;
')

type psi_daemon_t;
type psi_daemon_exec_t;

init_vendor_domain(psi_daemon_t, psi_daemon_exec_t)

# allow read/write for kernel procfs files
allow psi_daemon_t proc_t:file { read write open };
