policy_module(gstreamer, 1.0)

type gstd_t;
type gstd_exec_t;
init_vendor_domain(gstd_t, gstd_exec_t)

gen_require(`
    type gst_data_t;
')

# Keep gstd data access scoped to the dedicated gst_data_t label.
manage_user_data_files(gstd_t, gst_data_t)
allow gstd_t gst_data_t:file map;

# Restrict execmem to gstd domain instead of broad initrc_t.
allow gstd_t self:process execmem;
