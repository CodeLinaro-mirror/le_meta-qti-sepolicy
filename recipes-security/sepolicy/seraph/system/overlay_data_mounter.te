policy_module(overlay_data_mounter, 1.0)
########################################
#
# Declarations
#
########################################
type overlay_data_mounter_t;
type overlay_data_mounter_exec_t;
# overlay_mounter_exec_t: shared exec label for /usr/libexec/overlay-mounter.
# All three mounter domains enter through this binary; systemd service units
# use SELinuxContext= to select the correct domain at launch.
type overlay_mounter_exec_t;
# Primary domain transition: direct exec of the binary (no SELinuxContext=)
# lands in overlay_data_mounter_t and grants init_t execute on the shared
# overlay_mounter_exec_t file label.
init_daemon_domain(overlay_data_mounter_t, overlay_mounter_exec_t)
########################################
#
# overlay_data_mounter_t policy
#
########################################
gen_require(`
    type overlay_t;
    type data_t;
    type fs_t;
    type wifi_data_t;
    type time_data_t;
    type tombstone_data_t;
    type tombstone_rfs_data_t;
    type audio_data_file_t;
    type perf_hal_data_t;
    type etc_sensors_t;
    type qseecomd_data_t;
    type reboot_cookie_data_t;
    type leprop_system_data_t;
    type adbd_system_data_t;
    type qwes_data_t;
    type bt_data_t;
    attribute domain_can_read_userdata;
    attribute domain_can_write_userdata;
    attribute qwes_data_writer;
')
# Neverallow exception attributes for user_data access
typeattribute overlay_data_mounter_t domain_can_read_userdata;
typeattribute overlay_data_mounter_t domain_can_write_userdata;
typeattribute overlay_data_mounter_t qwes_data_writer;
########################################
# Phase 1: mount(2) syscall and capabilities
########################################
allow overlay_data_mounter_t self:capability { sys_admin chown fowner dac_override dac_read_search fsetid };
allow overlay_data_mounter_t fs_t:filesystem { mount getattr relabelfrom };
# Overlay mountpoint: /data
allow overlay_data_mounter_t data_t:dir { mounton list_dir_perms relabelfrom relabelto };
allow overlay_data_mounter_t data_t:filesystem { mount relabelfrom relabelto };
# /overlay partition: upperdir and workdir
allow overlay_data_mounter_t overlay_t:dir manage_dir_perms;
allow overlay_data_mounter_t overlay_t:file manage_file_perms;
allow overlay_data_mounter_t overlay_t:chr_file manage_chr_file_perms;
########################################
# Phase 2: copy-up (stashed credential second-check)
########################################
# /data overlay: direct data_t file, directory and symlink access
allow overlay_data_mounter_t data_t:file { manage_file_perms relabel_file_perms };
allow overlay_data_mounter_t data_t:dir manage_dir_perms;
allow overlay_data_mounter_t data_t:lnk_file manage_lnk_file_perms;
# /data overlay: full manage + relabel on copy-up target directories.
allow overlay_data_mounter_t { wifi_data_t time_data_t bt_data_t qwes_data_t
                               tombstone_data_t tombstone_rfs_data_t
                               audio_data_file_t perf_hal_data_t
                               etc_sensors_t qseecomd_data_t }:dir { manage_dir_perms relabel_dir_perms };
# /data overlay: full manage + relabel on copy-up target files.
allow overlay_data_mounter_t { wifi_data_t audio_data_file_t perf_hal_data_t
                               etc_sensors_t qseecomd_data_t qwes_data_t bt_data_t
                               reboot_cookie_data_t }:file { manage_file_perms relabel_file_perms };
# /data/wifi overlay: cnss_daemon socket operations
allow overlay_data_mounter_t wifi_data_t:sock_file { create getattr unlink };

########################################
# MLS: overlay mount needs to read/write across all sensitivity levels.
# Copy-up and relabel operations require cross-level access.
########################################
mls_file_read_all_levels(overlay_data_mounter_t)
mls_file_write_all_levels(overlay_data_mounter_t)
mls_file_downgrade(overlay_data_mounter_t)
mls_file_upgrade(overlay_data_mounter_t)
########################################
# Dontaudit: suppress harmless noise
########################################
# system_data types: neverallow prevents granting access; denials are harmless
dontaudit overlay_data_mounter_t { leprop_system_data_t adbd_system_data_t }:file { manage_file_perms relabel_file_perms };
