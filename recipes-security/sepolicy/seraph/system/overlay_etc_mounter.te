policy_module(overlay_etc_mounter, 1.0)
########################################
#
# Declarations
#
########################################
type overlay_etc_mounter_t;
type overlay_etc_mounter_exec_t;
init_daemon_domain(overlay_etc_mounter_t, overlay_etc_mounter_exec_t)
# Allow entry through the shared /usr/libexec/overlay-mounter binary.
# systemd uses SELinuxContext= to transition into this domain; the entrypoint
# check requires the domain to accept the shared exec label.
# read/execute/map are also required: init_daemon_domain() only wires up these
# permissions for the primary domain (overlay_data_mounter_t).  Domains that
# enter via SELinuxContext= skip the normal domain-transition path, so the
# kernel still checks read+execute+map on the file against this domain at
# exec(2) time.  Without them the service fails to start in enforcing mode.
gen_require(`
    type overlay_mounter_exec_t;
')
allow overlay_etc_mounter_t overlay_mounter_exec_t:file { entrypoint mmap_exec_file_perms };
# overlay_t, audio_data_file_t, perf_hal_data_t are user_data_files_type;
# the neverallow in data.te requires membership in these attributes.
gen_require(`
    attribute domain_can_read_userdata;
    attribute domain_can_write_userdata;
    attribute overlay_stash_mounter;

')
typeattribute overlay_etc_mounter_t domain_can_read_userdata;
typeattribute overlay_etc_mounter_t domain_can_write_userdata;
typeattribute overlay_etc_mounter_t overlay_stash_mounter;
########################################
#
# overlay_etc_mounter_t policy
#
########################################
gen_require(`
    type overlay_t;
    type etc_t;
    type fs_t;
    type net_conf_t;
    type systemd_unit_t;
    type udev_rules_t;
    type dbusd_etc_t;
    type dnsmasq_etc_t;
    type chronyd_conf_t;
    type cert_t;
    type etc_runtime_t;
    type modules_conf_t;
    type perf_hal_etc_t;
    type default_context_t;
    type file_context_t;
    type wifi_system_data_t;
    type bluetooth_conf_t;
    type selinux_config_t;
    type shadow_t;
    type dhcp_etc_t;
    type alsa_etc_t;
    type audio_hal_etc_t;
    type thermal_etc_t;
    type syslog_conf_t;
    type systemd_update_run_t;
    type wlan_initrc_exec_t;
    type sfs_config_initrc_exec_t;
    type leprop_system_data_t;
    type adbd_system_data_t;
    type etc_sensors_t;
    type wifi_data_t;
    type qmi_sec_config_t;
    type post_boot_script_exec_t;
    type policy_config_t;
    type reset_reboot_initrc_exec_t;

')
########################################
# Phase 1: mount(2) syscall and capabilities
########################################
allow overlay_etc_mounter_t self:capability { sys_admin chown fowner dac_override dac_read_search fsetid };
allow overlay_etc_mounter_t fs_t:filesystem { mount getattr relabelfrom };
# Overlay mountpoint: /etc
allow overlay_etc_mounter_t etc_t:dir { mounton list_dir_perms relabelfrom relabelto };
allow overlay_etc_mounter_t etc_t:filesystem { mount relabelfrom relabelto };
# /overlay partition: upperdir and workdir
allow overlay_etc_mounter_t overlay_t:dir manage_dir_perms;
allow overlay_etc_mounter_t overlay_t:file manage_file_perms;
allow overlay_etc_mounter_t overlay_t:chr_file manage_chr_file_perms;
########################################
# Phase 2: copy-up (stashed credential second-check)
########################################
# /etc overlay: full manage + relabel on copy-up target directories.
allow overlay_etc_mounter_t { etc_t wifi_system_data_t adbd_system_data_t
                              systemd_update_run_t bluetooth_conf_t leprop_system_data_t etc_sensors_t audio_hal_etc_t }:dir { manage_dir_perms relabel_dir_perms };
# /etc overlay: full manage + relabel on copy-up target files.
allow overlay_etc_mounter_t { etc_t etc_runtime_t systemd_update_run_t leprop_system_data_t etc_sensors_t
                              bluetooth_conf_t adbd_system_data_t audio_hal_etc_t }:file { manage_file_perms relabel_file_perms };
# /etc overlay: execute init scripts through overlay
allow overlay_etc_mounter_t etc_t:file execute;
# /etc overlay: symlink management
allow overlay_etc_mounter_t etc_t:lnk_file manage_lnk_file_perms;

allow overlay_etc_mounter_t reset_reboot_initrc_exec_t:file { getattr execute read open };


# /etc overlay: lower-inode directory traversal (second-check)
allow overlay_etc_mounter_t { udev_rules_t modules_conf_t net_conf_t
                              systemd_unit_t dbusd_etc_t dnsmasq_etc_t
                              cert_t alsa_etc_t }:dir list_dir_perms;
# /etc overlay: lower-inode file reads (second-check)
allow overlay_etc_mounter_t { udev_rules_t modules_conf_t net_conf_t
                              dbusd_etc_t dnsmasq_etc_t chronyd_conf_t
                              thermal_etc_t perf_hal_etc_t cert_t dhcp_etc_t
                              syslog_conf_t alsa_etc_t
                              default_context_t file_context_t }:file read_file_perms;
# /etc overlay: net_conf_t symlink reads
allow overlay_etc_mounter_t net_conf_t:lnk_file read_lnk_file_perms;
# /etc/selinux overlay: directory listing
allow overlay_etc_mounter_t selinux_config_t:dir list_dir_perms;
allow overlay_etc_mounter_t selinux_config_t:file read_file_perms;
# /etc overlay: second-check for wifi libnl config directory
allow overlay_etc_mounter_t wifi_data_t:dir { getattr };
# /etc overlay: second-check for QMI security config file
allow overlay_etc_mounter_t qmi_sec_config_t:file { getattr };

# /etc overlay: SELinux context directory traversal
allow overlay_etc_mounter_t { default_context_t file_context_t }:dir manage_dir_perms;
# /etc overlay: shadow_t getattr
allow overlay_etc_mounter_t shadow_t:file getattr;
# The overlayfs stashed-credential second-check uses overlay_etc_mounter_t when any
# process opens /etc/shadow through the /etc overlay. auth_read_shadow() adds this
# domain to can_read_shadow_passwords and grants read_file_perms, satisfying the
# kernel second-check without violating the authlogin neverallow.
# NOTE: This replaces the original dontaudit shadow_t:file { read open } which
# would cause silent failures in enforcing mode.
auth_read_shadow(overlay_etc_mounter_t)
# /etc/initscripts overlay: WLAN and sfs_config init script execution
allow overlay_etc_mounter_t { wlan_initrc_exec_t sfs_config_initrc_exec_t }:file { getattr execute read open };
########################################
# MLS: overlay mount needs to read/write across all sensitivity levels.
# Copy-up and relabel operations require cross-level access.
########################################

mls_file_read_all_levels(overlay_etc_mounter_t)
mls_file_write_all_levels(overlay_etc_mounter_t)
mls_file_downgrade(overlay_etc_mounter_t)
mls_file_upgrade(overlay_etc_mounter_t)
