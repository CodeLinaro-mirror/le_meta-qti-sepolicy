policy_module(audio_console_app, 1.0)
type audio_console_app_t;
type audio_console_app_exec_t;

#domain transition if started from init
init_vendor_domain(audio_console_app_t, audio_console_app_exec_t)

gen_require(`
    type data_t;
    type etc_t;
    type sdcard_t;
')

#domain transition if started from adb shell
transition_to_confined_domain(audio_console_app_t, audio_console_app_exec_t)

#Save recordings to and play files from /data partition
manage_user_data_files(audio_console_app_t, data_t)

#Audio services
telux_allow_audio(audio_console_app_t)

#Allow setting secondary groups
allow audio_console_app_t self:capability setgid;
allow audio_console_app_t etc_t:file read_file_perms;

#Save recordings to and play files from sdcard's root directory
files_search_mnt(audio_console_app_t)
allow audio_console_app_t sdcard_t:dir { write search read create open getattr add_name };
allow audio_console_app_t sdcard_t:file { write create open read getattr unlink };
allow audio_console_app_t sdcard_t:filesystem getattr;
allow audio_console_app_t sdcard_t:lnk_file read;

#API access control permissions
telux_allow_audio_voice(audio_console_app_t)
telux_allow_audio_play(audio_console_app_t)
telux_allow_audio_capture(audio_console_app_t)
telux_allow_audio_transcode(audio_console_app_t)
telux_allow_audio_factory_test(audio_console_app_t)
telux_allow_audio_voice_data(audio_console_app_t)

# Allow signals to this process
allow audio_console_app_t self:process signal;
