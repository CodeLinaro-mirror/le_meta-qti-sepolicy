policy_module(rilmuxd, 1.0)
type rilmuxd_t;
type rilmuxd_exec_t;

init_vendor_domain(rilmuxd_t, rilmuxd_exec_t)

gen_require(`
    type rild_t;
    type qmux_radio_sock_t;
    type socket_device_t;
')

logging_send_syslog_msg(rilmuxd_t)

allow rilmuxd_t rild_t:unix_stream_socket connectto;
allow rilmuxd_t self:unix_dgram_socket create;

allow rilmuxd_t socket_device_t:dir search;
allow rilmuxd_t qmux_radio_sock_t:dir { add_name write search remove_name};
allow rilmuxd_t qmux_radio_sock_t:sock_file { create rw_sock_file_perms unlink setattr };
allow rilmuxd_t self:process signal;
allow rilmuxd_t self:qipcrtr_socket { read write create getattr setopt };
allow rilmuxd_t self:unix_stream_socket { accept listen };

allow rilmuxd_t self:socket { create setopt getattr read write };
access_telux_files(rilmuxd_t);
