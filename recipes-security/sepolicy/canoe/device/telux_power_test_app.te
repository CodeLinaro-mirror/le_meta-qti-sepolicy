policy_module(telux_power_test_app, 1.0)
type telux_power_app_t;
type telux_power_app_exec_t;

#domain transition if started from init
init_vendor_domain(telux_power_app_t, telux_power_app_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(telux_power_app_t, telux_power_app_exec_t)

#Telsdk Logging
access_telux_files(telux_power_app_t)

#Power Management services
telux_allow_power(telux_power_app_t)

gen_require(`
        type etc_t;
')
#Allow setting secondary groups
allow telux_power_app_t self:capability setgid;
allow telux_power_app_t etc_t:file read_file_perms;

#Allow setting TCU activity state
telux_allow_power_control_state(telux_power_app_t)