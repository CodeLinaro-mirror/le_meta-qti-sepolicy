policy_module(telux_audio_server, 1.0)

type telux_audio_server_t;
type telux_audio_server_exec_t;

gen_require(`
    type audio_device_t;
    type audio_hal_etc_acdb_t;
    type audio_hal_etc_t;
    class dbus send_msg;
    type agm_server_t;
    type data_t;
    type default_t;
    type systemd_logind_var_run_t;
    type system_dbusd_t;
    type system_dbusd_var_run_t;
    type servicemanager_t;
    type binderfs_t;
    type binder_device_t;
    type locale_t;
    type sysfs_t;
    type system_dmabuf_device_t;
    type etc_t;
')

init_vendor_domain(telux_audio_server_t, telux_audio_server_exec_t)

# Gives permissions to access to hal devices such as sound devices,
# hal files such as acdb, mixer files
audio_hal_access(telux_audio_server_t)
#auto_audio_hal_access(telux_audio_server_t)

# The below interface gives access for files which are not owned by
# audio hal but used by audio hal. Eg: debugfs, diag_dev, sysfs, etc.
non_audio_hal_access(telux_audio_server_t)

# Gives permissions to manage files in "/data/audio/*"
audio_data_files_access(telux_audio_server_t)

dontaudit telux_audio_server_t default_t:dir search;

# Permission required for a QCSI application.
allow telux_audio_server_t self:capability net_bind_service;
allow telux_audio_server_t self:socket create_socket_perms;
# Signalling for ssr whenever required
allow telux_audio_server_t self:process signal;
device_search_sockets(telux_audio_server_t);
# Permissions required for topologies in debug tools
userdebug_or_eng(`
    kernel_read_debugfs(telux_audio_server_t)
')
kernel_read_system_state(telux_audio_server_t);

# Permissions required for telsdk config file access
access_telux_files(telux_audio_server_t)

# Permissions required for telsdk audio supplemantary groups
telux_allow_group(telux_audio_server_t)

# Allow logging to syslog
logging_send_syslog_msg(telux_audio_server_t);

# Dbus communication permissions
#Manage Dbus sockets
ifdef(`init_systemd',`
    dbus_system_bus_client(telux_audio_server_t)
    init_dbus_chat(telux_audio_server_t)
    allow telux_audio_server_t self:dbus send_msg;
    rw_sock_files_pattern(telux_audio_server_t, systemd_logind_var_run_t, systemd_logind_var_run_t)
')
allow telux_audio_server_t { system_dbusd_var_run_t var_run_t }:dir search_dir_perms;
allow telux_audio_server_t system_dbusd_var_run_t:sock_file write_sock_file_perms;
allow telux_audio_server_t system_dbusd_t:unix_stream_socket connectto;
allow telux_audio_server_t agm_server_t:dbus send_msg;
allow telux_audio_server_t var_run_t:dir search_dir_perms;
allow telux_audio_server_t var_run_t:lnk_file read_lnk_file_perms;
allow telux_audio_server_t servicemanager_t:binder { call transfer };
allow telux_audio_server_t binderfs_t:dir search;
allow telux_audio_server_t binder_device_t:chr_file { rw_chr_file_perms map};
allow telux_audio_server_t agm_server_t:binder { call transfer };
#########################################################
allow telux_audio_server_t etc_t:file { read getattr open };
allow telux_audio_server_t locale_t:dir search;
allow telux_audio_server_t locale_t:file { getattr open read };
allow telux_audio_server_t sysfs_t:file append;
allow telux_audio_server_t system_dmabuf_device_t:chr_file { ioctl open read };
allow telux_audio_server_t etc_t:lnk_file read;
