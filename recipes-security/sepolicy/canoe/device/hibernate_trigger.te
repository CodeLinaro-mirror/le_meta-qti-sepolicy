policy_module(hibernate_trigger, 1.0);

type hibernate_trigger_t;
type hibernate_trigger_exec_t;

init_vendor_domain(hibernate_trigger_t, hibernate_trigger_exec_t);

gen_require(`
    type shell_exec_t;
    type system_dbusd_runtime_t;
    type system_dbusd_t;
    type hibernate_server_t;
    class dbus { acquire_svc send_msg };
')

allow hibernate_trigger_t self:netlink_kobject_uevent_socket connected_socket_perms;
allow hibernate_trigger_t shell_exec_t:file exec_file_perms;
allow hibernate_trigger_t system_dbusd_runtime_t:dir search_dir_perms;
allow hibernate_trigger_t system_dbusd_runtime_t:sock_file write_sock_file_perms;
allow hibernate_trigger_t system_dbusd_t:unix_stream_socket connectto;
allow hibernate_trigger_t hibernate_server_t:dbus send_msg;
allow hibernate_trigger_t system_dbusd_t:dbus send_msg;
