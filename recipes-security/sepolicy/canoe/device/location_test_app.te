policy_module(location_test_app, 1.0)
type location_test_app_t;
type location_test_app_exec_t;

#domain transition if started from init
init_vendor_domain(location_test_app_t, location_test_app_exec_t)

#domain transition if started from adb shell
transition_to_confined_domain(location_test_app_t, location_test_app_exec_t)

#Location services
telux_allow_loc(location_test_app_t)

gen_require(`
        type etc_t;
        type user_home_dir_t;
        type sysctl_t;
')
#Allow setting secondary groups
allow location_test_app_t self:capability setgid;
allow location_test_app_t self:process signal;
allow location_test_app_t etc_t:file read_file_perms;
allow location_test_app_t user_home_dir_t:dir search;
allow location_test_app_t user_home_dir_t:file { read open };
dontaudit location_test_app_t sysctl_t:dir search;

#Allow Location permissions.
telux_allow_loc_data(location_test_app_t)
telux_allow_loc_config(location_test_app_t)
telux_allow_loc_consent(location_test_app_t)
