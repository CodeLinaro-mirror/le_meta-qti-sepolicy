#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_client_config',`
    gen_require(`
        type telux_access_data_client_config_t;
    ')
    allow $1 telux_access_data_client_config_t:file {getattr};
')

# Interface to get access for data QoS APIs.
# @brief: This interface allows the client to add/delete traffic class and QoS filter.
