##################################################################################################
# Interfaces to control access for Data related APIs in SDK
##################################################################################################

# Interface to get access for data subsystem settings APIs.
# @brief: This interface allows the client to change data subsystem settings.
# The operations supported are setting default routing, allow/disallow PDN connection when device
# is in roaming area, configuring N79 5G/Wlan 5 GHz interference priority, setting backhaul
# preference, and allow/disallow data call bring-up on WWAN backhaul.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_setting',`
    gen_require(`
        type telux_access_data_setting_t;
    ')
    allow $1 telux_access_data_setting_t:file {getattr};
')

# Interface to get access for data call operations APIs.
# @brief: This interface allows the client to perform data call operation.
# The operations supported are Start/Stop data call, get active data call list, data call status
# change indication, and data call traffic flow template status change indication.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_call_ops',`
    gen_require(`
        type telux_access_data_call_ops_t;
    ')
    allow $1 telux_access_data_call_ops_t:file {getattr};
')

# Interface to get access for data call properties APIs.
# @brief: This interface allows the client to alter data call properties.
# The operations supported are resetting data call statistics.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_call_props',`
    gen_require(`
        type telux_access_data_call_props_t;
    ')
    allow $1 telux_access_data_call_props_t:file {getattr};
')

# Interface to get access for data profile properties APIs.
# @brief: This interface allows the client to change/create/delete data profiles.
# The operations supported are create, modify and delete data profiles.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_profile_ops',`
    gen_require(`
        type telux_access_data_profile_ops_t;
    ')
    allow $1 telux_access_data_profile_ops_t:file {getattr};
')

# Interface to get access for data filter APIs.
# @brief: This interface allows the client to restrict/add/remove data filter.
# The operations supported are restrict, add, and remove data filters.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_filter_ops',`
    gen_require(`
        type telux_access_data_filter_ops_t;
    ')
    allow $1 telux_access_data_filter_ops_t:file {getattr};
')

# Interface to get access for data networking APIs.
# @brief: This interface allows the client to create/change/remove data networking configurations.
# The operations supported are change/create configurations for Vlan, firewall, NAT, L2TP, and Socks
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_network_config',`
    gen_require(`
        type telux_access_data_network_config_t;
    ')
    allow $1 telux_access_data_network_config_t:file {getattr};
')

# Interface to get access for data serving system APIs.
# @brief: This interface allows the client to change data serving system configurations.
# The operations supported are change/create configurations for data serving system
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_service_mgmt',`
    gen_require(`
        type telux_access_data_service_mgmt_t;
    ')
    allow $1 telux_access_data_service_mgmt_t:file {getattr};
')

# Interface to get access for data link manager APIs, for link information.
# @brief: This interface allows the client to listen and update Eth mode.
# The operations supported are listen Eth mode change status and get Eth capability.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_link_info',`
    gen_require(`
        type telux_access_data_link_info_t;
    ')
    allow $1 telux_access_data_link_info_t:file {getattr};
')

# Interface to get access for data link manager APIs, for link configuration.
# @brief: This interface allows the client to update Eth mode.
# The operations supported are listen to Eth mode change request and update Eth mode.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_data_link_config',`
    gen_require(`
        type telux_access_data_link_config_t;
        type sysfs_t;
    ')
    allow $1 telux_access_data_link_config_t:file {getattr};
    allow $1 sysfs_t:file {write};
')

# Interface to get access for data client APIs.
# @brief: This interface allows the user to get info about devices and clients connected to MDM via
