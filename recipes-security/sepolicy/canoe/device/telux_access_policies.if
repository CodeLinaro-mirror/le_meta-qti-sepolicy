##################################################################################################
# Interfaces to control access for Telephony related APIs in SDK
##################################################################################################

# Interface to get access for card related APIs.
# @brief: This interface allows the client to perform card related operations like
# power on/off the SIM card.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_tel_card_power',`
    gen_require(`
        type telux_access_tel_card_power_t;
    ')
    allow $1 telux_access_tel_card_power_t:file { getattr };
')

# Interface to get access for card related APIs.
# @brief: This interface allows the client to perform card related operations like open/close a
# logical channel to the SIM, transmit an APDU to the ICC card over a logical channel, exchange
# APDUs with the SIM on a basic channel and perform SIM IO operations.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_tel_card_ops',`
    gen_require(`
        type telux_access_tel_card_ops_t;
    ')
    allow $1 telux_access_tel_card_ops_t:file { getattr };
')

# Interface to get access for card privilege related APIs.
# @brief: This interface allows the client to perform card related operations like change
# the password used in PIN1/PIN2 lock, unlock the SIM card for an app by entering PUK/PIN
# pin and enable or disable FDN or Pin1 lock.
#
# Parameters:
#    1) Domain context.

interface(`telux_allow_tel_card_privileged_ops',`
    gen_require(`
        type telux_access_tel_card_privileged_ops_t;
    ')
    allow $1 telux_access_tel_card_privileged_ops_t:file { getattr };
')

