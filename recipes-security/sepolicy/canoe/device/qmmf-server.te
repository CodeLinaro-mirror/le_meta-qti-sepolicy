########################################
#
# Declarations
#

type dev_hdmi_bdg_irq_handler_t;
dev_node(dev_hdmi_bdg_irq_handler_t);
allow qmmf_server_t dev_hdmi_bdg_irq_handler_t:chr_file read_chr_file_perms;

type dev_dri_t;
dev_node(dev_dri_t);
allow qmmf_server_t dev_dri_t:dir search;

#needed for /dev/dri dir's s15 context which is accessed by libdrm
mls_file_read_all_levels(qmmf_server_t)

gen_require(`
 type tmpfs_t;
 type initrc_var_run_t;
 type syslogd_var_run_t;
 type user_runtime_root_t;
 type unlabeled_t;
 type gpumodel_t;
 type perf_hal_socket_t;
 type perf_hal_t;
 type unlabeled_t;
 type vendor_dmabuf_system_heap_device_t;
 type xdsp_device_t;
 type initrc_t;
 type kernel_t;
 type fs_t;
 type rfsa_adsp_lib_t;
')

#For hvx
optional_policy(`
    adsprpcd_files_access(qmmf_server_t)
')

#For camera performance
fs_manage_cgroup_dirs(qmmf_server_t)
fs_manage_cgroup_files(qmmf_server_t)

userdebug_or_eng(`
    gen_require(`
        type unconfined_t;
        class service {start stop status};
    ')
    #systemctl start/stop/status qmmf-server
    allow unconfined_t qmmf_server_exec_t:service { status start stop };
')

#For v4l related files
gen_require(`
  type v4l_device_t;
')
rw_chr_files_pattern(qmmf_server_t, device_t, v4l_device_t)

# self
allow qmmf_server_t self:unix_dgram_socket create_socket_perms;
allow qmmf_server_t self:unix_stream_socket create_stream_socket_perms;
allow qmmf_server_t self:process {getsched setsched};
allow qmmf_server_t self:lockdown confidentiality;


# Allow search /run/
gen_require(`
 type var_run_t;
')

allow qmmf_server_t var_run_t:dir search_dir_perms;

#Allow search /run/systemd/
#init_search_pids(qmmf_server_t)

# other context
allow qmmf_server_t sysfs_t:file { read getattr open };

# Weston Socket
allow qmmf_server_t weston_t:unix_stream_socket connectto;
kernel_read_vm_overcommit_sysctl(qmmf_server_t)

allow qmmf_server_t binder_device_t:chr_file { read write map };
allow qmmf_server_t self:capability {dac_override dac_read_search };
allow qmmf_server_t gpu_device_t:chr_file map;
allow qmmf_server_t self:qipcrtr_socket { create getattr read setopt write };
allow qmmf_server_t sysfs_t:lnk_file read;
allow qmmf_server_t tmp_t:dir search;
allow qmmf_server_t tmpfs_t:dir search;
allow qmmf_server_t initrc_var_run_t:dir search;
allow qmmf_server_t syslogd_var_run_t:dir search;
allow qmmf_server_t user_runtime_root_t:dir search;
allow qmmf_server_t gpumodel_t:file read_file_perms;
allow qmmf_server_t perf_hal_socket_t:sock_file write_sock_file_perms;
allow qmmf_server_t perf_hal_t:unix_stream_socket connectto;
allow qmmf_server_t self:process getsched;
allow qmmf_server_t vendor_dmabuf_system_heap_device_t:chr_file { read_chr_file_perms write };
allow qmmf_server_t adsprpcd_t:dir watch;
allow qmmf_server_t xdsp_device_t:chr_file read_chr_file_perms;
allow qmmf_server_t binderfs_t:dir search;
allow qmmf_server_t initrc_t:binder call;
allow qmmf_server_t kernel_t:unix_dgram_socket sendto;
allow qmmf_server_t fs_t:filesystem getattr;
allow qmmf_server_t rfsa_adsp_lib_t:dir { watch list_dir_perms };

gen_require(`
    type weston_runtime_t;
    type servicemanager_t;
')
manage_sock_files_pattern(qmmf_server_t, weston_runtime_t, weston_runtime_t)

#todo: /dev/binder label is coming as unlabeled_t.
# Once binder label is corrected, the following will be changed to right binder label
allow qmmf_server_t unlabeled_t:dir search;
allow qmmf_server_t unlabeled_t:chr_file ioctl;
allow servicemanager_t unlabeled_t:chr_file ioctl;
allow initrc_t qmmf_data_file_t:dir search;
allow initrc_t qmmf_server_t:binder { call transfer };
allow initrc_t rfsa_adsp_lib_t:dir { watch list_dir_perms };
