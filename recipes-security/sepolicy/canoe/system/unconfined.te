#### workaround for FOTA /usr/bin/recovery

userdebug_or_eng(`

    gen_require(`
        type cpu_scaling_freq_t;
        type cpu_sysfs_t;
        type sysfs_panel0_backlight_bl_power_t;
        type sysfs_cpu_present;
        type binderfs_t;
        type qseecomd_exec_t;
        type telux_audio_server_exec_t;
        type pulseaudio_t;
        class service { status start stop };
        type fbe_secure_data_t;
        type hwfde_conf_file_t;
        type install_evict_t;
    ')

    allow unconfined_t self:lockdown integrity;
    allow unconfined_t cpu_sysfs_t:file rw_file_perms;
    allow unconfined_t cpu_sysfs_t:dir { open read search getattr };
    allow unconfined_t sysfs_panel0_backlight_bl_power_t:file getattr;
    allow unconfined_t cpu_scaling_freq_t:file { getattr read open };
    allow unconfined_t self:lockdown confidentiality;
    allow unconfined_t binderfs_t:filesystem getattr;
    allow unconfined_t fbe_secure_data_t:dir search_dir_perms;
    allow unconfined_t fbe_secure_data_t:file read_file_perms;
    allow unconfined_t hwfde_conf_file_t:file read_file_perms;
    allow unconfined_t install_evict_t:file exec_file_perms;
    allow unconfined_t pulseaudio_t:binder { call transfer };

    gen_require(`
        type dev_dri_t;
        type perf_hal_socket_t;
        type touch_input_device_t;
        type tuicoreservice_dev_t;
        type zs_handle_sysfs_t;
        type zspage_sysfs_t;
    ')
    #For catf, which is internal test tool for audio
    allow unconfined_t cpu_scaling_freq_t:file write_file_perms;
    allow unconfined_t sysfs_cpu_capacity:file { read_file_perms };
    allow unconfined_t sysfs_cpu_present:file { read_file_perms };
    allow unconfined_t qseecomd_exec_t:service { status start stop };
    allow unconfined_t telux_audio_server_exec_t:service { status start stop };

    allow unconfined_t binderfs_t:file getattr;
    allow unconfined_t dev_dri_t:dir getattr;
    allow unconfined_t perf_hal_socket_t:sock_file getattr;
    allow unconfined_t touch_input_device_t:file getattr;
    allow unconfined_t tuicoreservice_dev_t:chr_file getattr;
    allow unconfined_t zs_handle_sysfs_t:dir getattr;
    allow unconfined_t zspage_sysfs_t:dir getattr;
    allow unconfined_t rfsa_adsp_lib_t:dir { watch list_dir_perms };
    allow unconfined_t rfsa_adsp_lib_t:file exec_file_perms;

')
