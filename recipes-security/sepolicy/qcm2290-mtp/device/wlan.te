gen_require(`
type default_t;
type wlan_initrc_t;
type kernel_t;
type modules_object_t;
type modules_dep_t;
')

allow wlan_initrc_t default_t:file read_file_perms;
allow wlan_initrc_t kernel_t:unix_dgram_socket sendto;
allow wlan_initrc_t modules_object_t:dir list_dir_perms;
allow wlan_initrc_t modules_dep_t:file read_file_perms;
