gen_require(`
    type system_dbusd_var_run_t;
    type system_dbusd_t;
    type btapp_t;
    type wifi_data_t;
    type NetworkManager_t;
    type dsmd_t;
    type tmp_t;
    type socket_device_t;
    type dsmd_sock_t;
    type init_t;
    type conn_mgr_initrc_t;
    type proc_t;
    type var_run_t;
    type NetworkManager_var_run_t;
')
manage_user_data_files(conn_mgr_initrc_t, wifi_data_t)
allow conn_mgr_initrc_t system_dbusd_var_run_t:dir search_dir_perms; #/run/dbus
allow conn_mgr_initrc_t system_dbusd_var_run_t:sock_file write_sock_file_perms;
allow conn_mgr_initrc_t system_dbusd_t:unix_stream_socket connectto;

## for DBus
ifdef(`init_systemd', `
   dbus_connect_system_bus(conn_mgr_initrc_t)
   dbus_send_system_bus(conn_mgr_initrc_t)
')
allow conn_mgr_initrc_t init_t:unix_stream_socket rw_stream_socket_perms;
allow conn_mgr_initrc_t proc_t:file read_file_perms;
allow conn_mgr_initrc_t self:unix_stream_socket create_socket_perms;
allow conn_mgr_initrc_t var_run_t:dir search_dir_perms;
allow conn_mgr_initrc_t wifi_data_t:dir add_entry_dir_perms;
allow conn_mgr_initrc_t wifi_data_t:file manage_file_perms;
allow conn_mgr_initrc_t socket_device_t:dir search_dir_perms;
allow conn_mgr_initrc_t socket_device_t:sock_file write_sock_file_perms;
allow conn_mgr_initrc_t btapp_t:unix_stream_socket connectto;
allow conn_mgr_initrc_t var_run_t:lnk_file read_lnk_file_perms;
allow conn_mgr_initrc_t NetworkManager_var_run_t:dir search_dir_perms;
allow conn_mgr_initrc_t NetworkManager_var_run_t:sock_file write_sock_file_perms;
allow conn_mgr_initrc_t NetworkManager_t:unix_dgram_socket sendto;
allow conn_mgr_initrc_t self:udp_socket connected_socket_perms;
allow conn_mgr_initrc_t tmp_t:dir search_dir_perms;
allow conn_mgr_initrc_t dsmd_sock_t:sock_file write_sock_file_perms;
allow conn_mgr_initrc_t dsmd_t:unix_stream_socket connectto;
allow conn_mgr_initrc_t self:process signal_perms;
allow conn_mgr_initrc_t btapp_t:dbus send_msg;
allow btapp_t conn_mgr_initrc_t:dbus send_msg;
