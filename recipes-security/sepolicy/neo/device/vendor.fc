# dev node
/dev/ashmem       gen_context(system_u:object_r:ashmem_devices_t,s0)
/etc/init.qti.debug.sh  -- gen_context(system_u:object_r:init_qti_debug_t,s0)

/dev/dri(/.*)?    gen_context(system_u:object_r:dev_dri_t,s0)

### synx_device ###
/dev/synx_device           -c  gen_context(system_u:object_r:synx_device_t,s0)

### DMA HEAP Types ###
/dev/dma_heap/qcom,lsr_.*  -c gen_context(system_u:object_r:vendor_dmabuf_lsr_heap_device_t,s0)
/dev/dma_heap/qcom,audio-ml -c   gen_context(system_u:object_r:vendor_dmabuf_audioml_heap_device_t,s0)

### MEM_BUF_VM devices ###
/dev/mem_buf_vm/qcom,cp_bitstream -c gen_context(system_u:object_r:vendor_vm_cpbitstream_device_t,s0)

### misc file ###
/etc/video_system_specs.json   -- gen_context(system_u:object_r:video_system_specs_t,s0)
/etc/qgl_config.txt            -- gen_context(system_u:object_r:qglconfig_data_t,s0)

### voice config ###
/etc/voiceui_conf.xml        -- gen_context(system_u:object_r:voice_data_t,s0)
/etc/asr_nlp_files(/.*)?        gen_context(system_u:object_r:nlp_data_t,s0)
