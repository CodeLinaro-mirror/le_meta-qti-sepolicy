policy_module(sscrpcd , 1.0)

########################################
#
# Declarations
#

type sscrpcd_t;
type sscrpcd_exec_t;
files_type(sscrpcd_exec_t);

type sensors_persist_data_t;
files_type(sensors_persist_data_t)

init_daemon_domain(sscrpcd_t, sscrpcd_exec_t)
files_mountpoint(sensors_persist_data_t)

allow sscrpcd_t self:capability chown;

gen_require(`
    type ion_device_t;
    type qdsp_device_t;
    type xdsp_device_t;
    type unconfined_t;
    type sysdevice_sysfs_t;
	type system_dmabuf_device_t;
	type image_variant_sysfs_t;
	type lib_t;
	type adsprpcd_t;
')

#allow sscrpcd_t to acces /dev/adsprpcd-smd-secure
allow sscrpcd_t xdsp_device_t:chr_file rw_chr_file_perms;
allow sscrpcd_t system_dmabuf_device_t:chr_file read_chr_file_perms;
allow sscrpcd_t image_variant_sysfs_t:file read_file_perms;
allow sscrpcd_t image_variant_sysfs_t:dir search_dir_perms;
allow sscrpcd_t lib_t:dir { watch };
allow sscrpcd_t adsprpcd_t:dir { watch };
leprop_rw_props(sscrpcd_t)

allow sscrpcd_t self:unix_dgram_socket { read write create bind listen ioctl connect };
userdebug_or_eng(`
        gen_require(`
            type debugfs_t;
            type system_dir_t;
            type sysfs_t;
            type persist_t;
        ')
        allow sscrpcd_t debugfs_t:dir search_dir_perms;
')

dev_rw_sysfs(sscrpcd_t)
allow sscrpcd_t persist_t:dir search_dir_perms;
allow sscrpcd_t system_dir_t:dir { search open read getattr};
allow sscrpcd_t system_dir_t:file read_file_perms;
allow sscrpcd_t sysdevice_sysfs_t:file { read open getattr };

files_search_mnt(sscrpcd_t)
files_search_default(sscrpcd_t)
device_search_sockets(sscrpcd_t)

adsprpcd_files_access(sscrpcd_t);

#allow sscrpcd_t to acces /dev/ion
rw_chr_files_pattern(sscrpcd_t, device_t, ion_device_t);
#allow sscrpcd_t to acces /dev/adsprpcd-smd
rw_chr_files_pattern(sscrpcd_t, device_t, qdsp_device_t);

manage_system_data_files(sscrpcd_t, sensors_persist_data_t)

# Manage private files inside /data
data_filetrans(sscrpcd_t, sensors_persist_data_t, { file dir })

