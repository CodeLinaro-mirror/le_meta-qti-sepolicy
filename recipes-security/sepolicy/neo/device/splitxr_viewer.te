policy_module(splitxr_viewer, 1.0)
type splitxr_viewer_t;
type splitxr_viewer_exec_t;
init_vendor_domain(splitxr_viewer_t, splitxr_viewer_exec_t)

userdebug_or_eng(`
   gen_require(`
      type debugfs_t;
   ')

   allow splitxr_viewer_t debugfs_t:dir search_dir_perms;
')

gen_require(`
    type event_device_t;
    type leprop_sock_t;
    type leprop_t;
    type qvr_config_t;
    type qvrd_socket_t;
    type qvrd_t;
    type socket_device_t;
    type system_dir_t;
    type initrc_t;
    type dev_dri_t;
')

allow splitxr_viewer_t event_device_t:chr_file rw_chr_file_perms;
allow splitxr_viewer_t leprop_sock_t:sock_file write;
allow splitxr_viewer_t leprop_t:unix_stream_socket connectto;
allow splitxr_viewer_t qvr_config_t:dir search_dir_perms;
allow splitxr_viewer_t qvr_config_t:file read_file_perms;
allow splitxr_viewer_t qvrd_socket_t:sock_file write;
allow splitxr_viewer_t qvrd_t:fd use;
allow splitxr_viewer_t qvrd_t:unix_stream_socket connectto;
allow splitxr_viewer_t socket_device_t:dir search_dir_perms;
allow splitxr_viewer_t system_dir_t:dir search_dir_perms;

#access to /dev/dri
allow splitxr_viewer_t dev_dri_t:dir search_dir_perms;
#needed for /dev/dri dir's s15 context which is accessed by libdrm
mls_file_read_all_levels(splitxr_viewer_t)


allow initrc_t qvrd_socket_t:sock_file write;
