######################################
## <summary>xrcommservice daemon</summary>

########################################
## <summary>
##       Allow service to connect to xrcomm
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed access.
##      </summary>
## </param>
#
interface(`connect_to_xrcommserviced',`
    gen_require(`
    type xrcommservice_t;
    ')

    allow $1 xrcommservice_t:fifo_file { write read };
    allow $1 xrcommservice_t:fd use;
    allow $1 xrcommservice_t:unix_stream_socket connectto;
')
