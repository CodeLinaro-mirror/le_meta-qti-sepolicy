gen_require(`
    type dev_dri_t;
    type udev_t;
')

allow splitxr_service_t dev_dri_t:dir search_dir_perms;
#needed for /dev/dri dir's s15 context which is accessed by libdrm
mls_file_read_all_levels(splitxr_service_t)

allow udev_t dev_dri_t:dir { create add_name remove_name write search_dir_perms };
allow udev_t dev_dri_t:lnk_file { create relabelto rw_lnk_file_perms };
