gen_require(`
    type nsfs_t;
    type adbd_t;
    type lib_t;
')
mls_key_write_to_clearance(kmod_t)
allow kmod_t nsfs_t:file read_file_perms;
allow kmod_t adbd_t:unix_stream_socket { read write getattr };

userdebug_or_eng(`
    allow kmod_t lib_t:system { module_load };
')
