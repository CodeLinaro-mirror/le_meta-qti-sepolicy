userdebug_or_eng(`
    gen_require(`
        type qmmf_server_t;
    ')

    servicemanager_binder_call(unconfined_t, qmmf_server_t)

    gen_require(`
        type usb_dev_t;
        type data_t;
        type policy_config_t;
        type proc_kmsg_t;
        type rebootd_pipe_t;
        type image_variant_sysfs_t;
        type fbe_secure_data_t;
        type hwfde_conf_file_t;
        type install_evict_t;
        type proc_sched_t;
        type snd_card_state_t;
        type aud_dev_sysfs_t;
        type cpu_scaling_freq_t;
        type sysfs_cpu_capacity;
        type cpu_sysfs_t;
        type weston_exec_t;
    ')

    mls_file_read_all_levels(unconfined_t)
    mls_file_write_all_levels(unconfined_t)
    storage_raw_read_fixed_disk(unconfined_t)
    storage_raw_write_fixed_disk(unconfined_t)
    dev_read_kmsg(unconfined_t)
    kernel_mounton_message_if(unconfined_t)
    allow unconfined_t data_t:chr_file getattr_chr_file_perms;
    allow unconfined_t policy_config_t:dir list_dir_perms;
    allow unconfined_t policy_config_t:file getattr_file_perms;
    allow unconfined_t proc_sched_t:file getattr_file_perms;
    allow unconfined_t proc_sched_t:dir list_dir_perms;
    allow unconfined_t proc_sched_t:file rw_file_perms;
    allow unconfined_t rebootd_pipe_t:fifo_file getattr_fifo_file_perms;
    allow unconfined_t usb_dev_t:dir list_dir_perms;
    allow unconfined_t snd_card_state_t:file rw_file_perms;

    # cpu_scaling_min/max can be set from user shell in testing
    allow unconfined_t cpu_scaling_freq_t:file read_file_perms;
    allow unconfined_t sysfs_cpu_capacity:file read_file_perms;
    allow unconfined_t cpu_sysfs_t:file rw_file_perms;

    gen_require(`
        type recovery_exec_t;
        type brightness_t;
        type tuicoreservice_dev_t;
        type NetworkManager_exec_t;
        class service { start status stop };
    ')
    allow unconfined_t recovery_exec_t:file exec_file_perms;
    allow unconfined_t brightness_t:file write_file_perms;
    allow unconfined_t tuicoreservice_dev_t: chr_file read_chr_file_perms;
    allow unconfined_t image_variant_sysfs_t:dir list_dir_perms;
    allow unconfined_t image_variant_sysfs_t:file manage_file_perms;
    allow unconfined_t fbe_secure_data_t:dir search_dir_perms;
    allow unconfined_t fbe_secure_data_t:file read_file_perms;
    allow unconfined_t hwfde_conf_file_t:file read_file_perms;
    allow unconfined_t install_evict_t:file exec_file_perms;
    allow unconfined_t NetworkManager_exec_t:service { status start stop};

    gen_require(`
        type panel_illumination_t;
        type panel_pixel_shift_t;
        type rfsa_adsp_lib_t;
    ')

    allow unconfined_t panel_illumination_t:dir { search_dir_perms read write};
    allow unconfined_t panel_illumination_t:file rw_file_perms;
    allow unconfined_t panel_pixel_shift_t:dir { search_dir_perms read write};
    allow unconfined_t panel_pixel_shift_t:file rw_file_perms;
    allow unconfined_t weston_exec_t:service { start stop status };
    allow unconfined_t rfsa_adsp_lib_t:dir { watch manage_dir_perms };
    allow unconfined_t rfsa_adsp_lib_t:file { manage_file_perms exec_file_perms };
')
