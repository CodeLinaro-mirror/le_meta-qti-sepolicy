#policy_module(pulseaudio, 1.0)

########################################
#
# Declarations
#

gen_require(`
        type socket_device_t;
        type system_dmabuf_device_t;
        type vendor_dmabuf_audioml_heap_device_t;
')

user_data_files_type(audio_data_file_t);
manage_user_data_files(pulseaudio_t, audio_data_file_t);

allow pulseaudio_t socket_device_t:sock_file write;
allow pulseaudio_t system_dmabuf_device_t:chr_file read_chr_file_perms;
allow pulseaudio_t vendor_dmabuf_audioml_heap_device_t:chr_file read_chr_file_perms;

userdebug_or_eng(`
    gen_require(`
        type unconfined_t;
    ')
    allow pulseaudio_t unconfined_t:unix_stream_socket connectto;
')
