policy_module(nfdlna, 1.0)

########################################
#
# Declarations
#

type nfdlna_t;
type nfdlna_exec_t;
type nfdlna_data_t;

#files_type(nfdlna_data_t)

init_daemon_domain(nfdlna_t, nfdlna_exec_t)

gen_require(`
	type lib_t;
	type etc_t;
	type var_t;
	type proc_t;
	type sysfs_t;
	type home_root_t;
	type user_home_dir_t;
	type node_t;
	type init_var_run_t;
	type udev_var_run_t;
	type usr_t;
')

manage_system_data_files(nfdlna_t, nfdlna_data_t)
data_filetrans(nfdlna_t, nfdlna_data_t, { file dir })

allow nfdlna_t etc_t:file { open read getattr };
kernel_read_system_state(nfdlna_t)

#policy required for gstreamer
allow nfdlna_t lib_t:file execute_no_trans;

allow nfdlna_t init_var_run_t:dir search;
allow nfdlna_t home_root_t:dir {search getattr };
allow nfdlna_t self:fifo_file { read write open getattr };
allow nfdlna_t self:capability { net_raw net_admin };
allow nfdlna_t node_t:udp_socket node_bind;
allow nfdlna_t self:udp_socket { write ioctl setopt read bind create };

allow nfdlna_t self:netlink_kobject_uevent_socket { read write ioctl create bind getattr setopt };
allow nfdlna_t self:unix_dgram_socket { create write };
allow nfdlna_t self:netlink_route_socket { create bind getattr read };
allow nfdlna_t sysfs_t:dir read;
allow nfdlna_t udev_var_run_t:dir search;
allow nfdlna_t user_home_dir_t:dir { search getattr };
allow nfdlna_t user_home_dir_t:file { read write getattr open };
allow nfdlna_t usr_t:file { read write getattr open };

###########################

corecmd_exec_shell(nfdlna_t)
corecmd_exec_bin(nfdlna_t)

dev_read_sound(nfdlna_t)
dev_write_sound(nfdlna_t)

## for DBus
ifdef(`init_systemd', `
    init_dbus_chat(nfdlna_t)
    dbus_system_domain(nfdlna_t, nfdlna_exec_t)
    #allow nfdlna_t audio_manager_t:dbus send_msg;
    adk_audio_manager_dbus_chat(nfdlna_t);
')
