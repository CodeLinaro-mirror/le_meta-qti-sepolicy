policy_module(overlay, 1.0)

gen_require(`
    type proc_t;
    type init_t;
    attribute mountpoint;
')

type overlay_t;
typeattribute overlay_t mountpoint;
user_data_files_type(overlay_t)

type overlay_initrc_t;
type overlay_initrc_exec_t;

init_script_domain(overlay_initrc_t, overlay_initrc_exec_t)
manage_overlay_data_files(overlay_initrc_t)
allow overlay_initrc_t proc_t:file read_file_perms; #/proc/filesystems
allow overlay_initrc_t init_t:unix_stream_socket { read write connectto };
