policy_module(port_bridge, 1.0)

type port_bridge_t;
type port_bridge_exec_t;
type port_bridge_data_usb_t;

user_data_files_type(port_bridge_data_usb_t)
init_vendor_domain(port_bridge_t, port_bridge_exec_t)

gen_require(`
    type debugfs_t;
    type dataqti_ppp_device_t;
')

type modem_glink_device_t;
dev_node(modem_glink_device_t)
modem_rw_modem_glink_dev(port_bridge_t)
files_rw_qcmap_etc_data_files(port_bridge_t)
dev_read_sysfs(port_bridge_t)

type port_bridge_usb_device_t;
dev_node(port_bridge_usb_device_t)
allow port_bridge_t port_bridge_usb_device_t:chr_file rw_file_perms;

type port_bridge_mhi_device_t;
dev_node(port_bridge_mhi_device_t)
allow port_bridge_t port_bridge_mhi_device_t:chr_file rw_file_perms;

allow port_bridge_t self:fifo_file rw_fifo_file_perms;
corecmd_exec_shell(port_bridge_t)
kernel_read_system_state(port_bridge_t)

allow port_bridge_t self:capability { setuid setgid };
dontaudit port_bridge_t debugfs_t:dir search;

type port_bridge_data_t;
user_data_files_type(port_bridge_data_t)
data_filetrans(port_bridge_t, port_bridge_data_t, { file dir })
manage_user_data_files(port_bridge_t, port_bridge_data_t)

allow port_bridge_t dataqti_ppp_device_t:chr_file rw_chr_file_perms; #/dev/smd8
allow port_bridge_t port_bridge_data_usb_t:file { open read write getattr }; #/data/usb/at_w_dun
