policy_module(splitxr_service, 1.0)

type splitxr_service_t;
type splitxr_service_exec_t;

init_vendor_domain(splitxr_service_t, splitxr_service_exec_t);

userdebug_or_eng(`
   gen_require(`
      type debugfs_t;
   ')

   allow splitxr_service_t debugfs_t:dir search_dir_perms;
')

gen_require(`
   type socket_device_t;
   type sxr_data_t;
   type leprop_sock_t;
   type leprop_t;
   type video_device_t;
   type firmware_t;
   type ion_device_t;
   type dri_device_t;
   type gpumodel_t;
   type sysfs_t;
   type tmp_t;
')

allow splitxr_service_t socket_device_t:dir search_dir_perms;
allow splitxr_service_t sxr_data_t:dir add_entry_dir_perms;
allow splitxr_service_t sxr_data_t:file manage_file_perms;
allow splitxr_service_t self:unix_stream_socket create_stream_socket_perms;
allow splitxr_service_t leprop_sock_t:sock_file write_sock_file_perms;
allow splitxr_service_t leprop_t:unix_stream_socket connectto;
allow splitxr_service_t video_device_t:chr_file rw_chr_file_perms;
allow splitxr_service_t firmware_t:dir search_dir_perms;
allow splitxr_service_t firmware_t:file read_file_perms;
allow splitxr_service_t ion_device_t:chr_file rw_chr_file_perms;
allow splitxr_service_t dri_device_t:chr_file rw_chr_file_perms;
allow splitxr_service_t sysfs_t:lnk_file read;
allow splitxr_service_t gpumodel_t:file read_file_perms;
allow splitxr_service_t tmp_t:dir search_dir_perms;
