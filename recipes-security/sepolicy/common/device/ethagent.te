policy_module(ethagent, 1.0)
type ethagent_t;
type ethagent_exec_t;
init_vendor_domain(ethagent_t, ethagent_exec_t)

logging_send_syslog_msg(ethagent_t)
dev_read_sysfs(ethagent_t);
files_rw_qcmap_etc_data_files(ethagent_t);

gen_require(`
    type proc_t;
    type sysfs_t;
    type syslogd_t;
    type unconfined_t;
    class service {status start stop};
    type wifi_data_t;
    type debugfs_t;
    type kernel_t;
    type proc_net_t;
    type qcmap_cm_t;
    type qcmap_var_run_t;
    type shell_exec_t;
    type socket_device_t;
    type var_run_t;
')
manage_user_data_files(ethagent_t, wifi_data_t)

allow ethagent_t  wifi_data_t:dir {search getattr read open};
allow ethagent_t  wifi_data_t:file {getattr read};
allow ethagent_t  qcmap_etc_data_t:dir search;
allow ethagent_t  qcmap_etc_data_t:file { read getattr open };
allow ethagent_t  wifi_data_t:file open;
allow ethagent_t  qcmap_cm_t:dir search;
allow ethagent_t  qcmap_cm_t:file { read open };
allow ethagent_t  qcmap_cm_t:lnk_file read;
allow ethagent_t  qcmap_var_run_t:dir search;
allow ethagent_t  qcmap_var_run_t:sock_file write;
allow ethagent_t  self:fifo_file { getattr ioctl };
allow ethagent_t  self:netlink_route_socket{ create read bind write getattr setopt nlmsg_read };
userdebug_or_eng(`
kernel_read_debugfs(ethagent_t)
')
kernel_read_network_state(ethagent_t)
allow ethagent_t  self:capability { net_admin };
dev_read_sysfs(ethagent_t)
allow ethagent_t  self:fifo_file { read write };
allow ethagent_t  self:qipcrtr_socket create;
allow ethagent_t  self:netlink_socket { read bind create };
allow ethagent_t  self:unix_stream_socket { read write create connect };
corecmd_exec_shell(ethagent_t)
allow ethagent_t  socket_device_t:dir search;
allow ethagent_t  var_run_t:dir search;
allow ethagent_t  var_run_t:lnk_file read;
allow ethagent_t  self:process signal;
allow ethagent_t  self:udp_socket { create ioctl };
kernel_read_system_state(ethagent_t)

sprhd_use_unix_stream_sockets(ethagent_t)
sprhd_rw_netlink_sockets(ethagent_t)

type ethagent_initrc_exec_t;
type ethagent_initrc_t;

init_script_domain(ethagent_initrc_t, ethagent_initrc_exec_t)
files_rw_qcmap_etc_data_files(ethagent_initrc_t);
kernel_read_system_state(ethagent_initrc_t)
allow ethagent_initrc_t self:fifo_file { read write };
dev_read_sysfs(ethagent_initrc_t)
domtrans_pattern(ethagent_initrc_t, ethagent_exec_t, ethagent_t)
logging_send_syslog_msg(ethagent_initrc_t)
manage_user_data_files(ethagent_initrc_t, wifi_data_t);
dontaudit ethagent_initrc_t domain:dir search;
userdebug_or_eng(`
allow unconfined_t ethagent_exec_t:service { status start stop };
dev_write_kmsg(ethagent_initrc_t)
mls_file_write_all_levels(ethagent_initrc_t)
')



