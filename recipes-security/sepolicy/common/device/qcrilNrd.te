policy_module(qcrilNrd, 1.0)

gen_require(`
    type default_t;
    type diag_device_t;
    type device_t;
    type tmpfs_t;
    type qcmap_etc_data_t;
    type netmgrd_socket_device_t;
    type qnetmgrd_t;
    type qnetmgrd_data_t;
    type sysctl_t;
')

type qcrilNrd_t;
type qcrilNrd_exec_t;

init_vendor_domain(qcrilNrd_t, qcrilNrd_exec_t)

type vendor_radio_vendor_data_file_t;
type vendor_mbn_data_file_t;

logging_send_syslog_msg(qcrilNrd_t)

allow qcrilNrd_t self:{ socket udp_socket } create_socket_perms;
allow qcrilNrd_t self:netlink_route_socket { create_socket_perms nlmsg_read };
allow qcrilNrd_t self:fifo_file rw_fifo_file_perms;
allow qcrilNrd_t self:{ netlink_socket qipcrtr_socket } { create getattr write read setopt bind};
allow qcrilNrd_t self:unix_stream_socket { connectto sendto listen accept };
allow qcrilNrd_t self:process { setcap signal };
allow qcrilNrd_t self:capability { net_admin net_raw };

#Read/Write /dev/subsys_modem
rw_subsys_modem_dev(qcrilNrd_t)

#/dev/socket/qcrild/ access
type qcrilNrd_sock_t;

files_type(qcrilNrd_sock_t);
dev_node(qcrilNrd_sock_t);

device_manage_socket_file(qcrilNrd_t, qcrilNrd_sock_t)
manage_dirs_pattern(qcrilNrd_t, qcrilNrd_sock_t, qcrilNrd_sock_t);
allow qcrilNrd_t socket_device_t:dir { search };

#access for /data/vendor/ files
user_data_files_type(vendor_radio_vendor_data_file_t)
user_data_files_type(vendor_mbn_data_file_t)

manage_user_data_files(qcrilNrd_t, vendor_radio_vendor_data_file_t)
manage_user_data_files(qcrilNrd_t, vendor_mbn_data_file_t)
allow qcrilNrd_t vendor_radio_vendor_data_file_t:file map;

#permissions for /sys/power/wake_lock /sys/power/wake_unlock
dev_rw_sysfs(qcrilNrd_t)

#access to /dev/shm/
type qcrilNrd_tmp_t;
files_type(qcrilNrd_tmp_t)

allow qcrilNrd_t tmpfs_t:filesystem getattr;
fs_tmpfs_filetrans(qcrilNrd_t, qcrilNrd_tmp_t, { dir file })
manage_files_pattern(qcrilNrd_t,qcrilNrd_tmp_t,qcrilNrd_tmp_t);
allow qcrilNrd_t qcrilNrd_tmp_t:file { map };

#proc access
dontaudit qcrilNrd_t sysctl_t:dir search;

dev_read_urand(qcrilNrd_t)
dev_write_urand(qcrilNrd_t)

#rules for /proc/sys/vm
kernel_read_vm_overcommit_sysctl(qcrilNrd_t)

#Data module policies
data_rw_system_data_files(qcrilNrd_t, qcmap_etc_data_t)
device_rw_socket_files(qcrilNrd_t, netmgrd_socket_device_t)
allow qcrilNrd_t qnetmgrd_t:unix_stream_socket { connectto };
allow qcrilNrd_t qnetmgrd_data_t:sock_file { write };

userdebug_or_eng(`
rw_chr_files_pattern(qcrilNrd_t, device_t, diag_device_t)
gen_require(`
type unconfined_t;
class service { start status stop };
')
allow unconfined_t qcrilNrd_exec_t:service { status start stop};
')
