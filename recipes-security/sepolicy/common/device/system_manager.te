policy_module(system_manager, 1.0)

########################################
#
# Declarations
#

type system_manager_t;
type system_manager_exec_t;

init_daemon_domain(system_manager_t, system_manager_exec_t)

#============= system_manager_t ==============
ifdef(`init_systemd', `
  init_dbus_chat(system_manager_t);
  dbus_system_domain(system_manager_t, system_manager_exec_t);
  unconfined_dbus_chat(system_manager_t);
')

gen_require(`
  type init_t;
  type init_var_run_t;
  type power_unit_t;
  type systemd_logind_var_run_t;
  class service { start status stop enable disable reload };
')

# most of these rules are required because the system manager performs an exec
# in order to invoke systemctl

# needed by systemctl to get the current runlevel status from init
init_read_state(system_manager_t);
allow system_manager_t init_t:unix_stream_socket connectto;

# used by systemctl to access /run/systemd/private
write_sock_files_pattern(system_manager_t,init_var_run_t,init_var_run_t);

# systemctl allows
allow system_manager_t power_unit_t:service { start stop status enable disable reload };
kernel_read_system_state(system_manager_t)
allow system_manager_t self:capability net_admin;
write_sock_files_pattern(system_manager_t,systemd_logind_var_run_t,systemd_logind_var_run_t);
