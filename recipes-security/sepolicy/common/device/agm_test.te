policy_module(agm_test, 1.0)

gen_require(`
    type boot_kpi_values_t;
    type agm_server_t;
    type usr_t;
    type audio_hal_etc_t;
    type socket_device_t;
    type sysfs_t;
    type syslogd_runtime_t;
    type devlog_t;
    type system_dmabuf_device_t;
    type syslogd_t;
    type adsprpcd_t;
    type tmp_t;
    type binderfs_t;
    type binder_device_t;
    type debugfs_t;
    type servicemanager_t;
    type etc_t;
    type unconfined_t;
    type pmsg_device_t;
')

# agmplay
type agmplay_t;
type agmplay_exec_t;
init_vendor_domain(agmplay_t, agmplay_exec_t)

allow agmplay_t boot_kpi_values_t:file { open write };
allow agmplay_t agm_server_t:binder { call transfer };
allow agmplay_t usr_t:file { read open getattr };
allow agmplay_t audio_hal_etc_t:file { read open getattr };
allow agmplay_t self:qipcrtr_socket { create bind read write setopt getattr };
allow agmplay_t socket_device_t:dir { search getattr };
allow agmplay_t sysfs_t:dir { read search open getattr };
allow agmplay_t sysfs_t:file { read open getattr };
allow agmplay_t syslogd_runtime_t:dir { search getattr };
allow agmplay_t devlog_t:sock_file { write getattr };
allow agmplay_t system_dmabuf_device_t:chr_file { read write open ioctl getattr };
allow agmplay_t syslogd_t:unix_dgram_socket sendto;
allow agmplay_t adsprpcd_t:dir { read open getattr search watch };
allow agmplay_t tmp_t:dir { search getattr write add_name };
allow agmplay_t tmp_t:file { create open read write getattr};
allow agmplay_t binderfs_t:dir { search read write getattr };
allow agmplay_t binder_device_t:chr_file { read write open map ioctl getattr };
allow agmplay_t self:process { signal getsched };
allow agmplay_t debugfs_t:dir { search getattr };
allow agmplay_t servicemanager_t:binder { call transfer };
allow agmplay_t etc_t:file { read open getattr map };
allow agmplay_t self:fifo_file rw_fifo_file_perms;
allow agmplay_t pmsg_device_t:chr_file { open write getattr };
domtrans_pattern(unconfined_t, agmplay_exec_t, agmplay_t)

