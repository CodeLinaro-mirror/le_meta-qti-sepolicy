allow agmhostless_t socket_device_t:dir { search getattr };
allow agmhostless_t sysfs_t:dir { read search open getattr };
allow agmhostless_t sysfs_t:file { read open getattr };
allow agmhostless_t syslogd_runtime_t:dir { search getattr };
allow agmhostless_t devlog_t:sock_file { write getattr };
allow agmhostless_t system_dmabuf_device_t:chr_file { read write open ioctl getattr };
allow agmhostless_t syslogd_t:unix_dgram_socket sendto;
