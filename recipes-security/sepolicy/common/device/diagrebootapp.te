policy_module(diagrebootapp, 1.0)

########################################
#
# Declarations
#
type diagrebootapp_t;
type diagrebootapp_exec_t;

init_vendor_domain(diagrebootapp_t, diagrebootapp_exec_t)

gen_require(`
    type sysfs_t;
    type rebootd_pipe_t;
    type overlay_t;
')

allow diagrebootapp_t rebootd_pipe_t:chr_file { read write ioctl open };
allow diagrebootapp_t self:capability { setuid setgid chown };
allow diagrebootapp_t rebootd_pipe_t:fifo_file { open write };
allow diagrebootapp_t self:unix_stream_socket create;
userdebug_or_eng(`
    rw_diag_dev(diagrebootapp_t)
    reboot_write_fifo_files_reboot_device(diagrebootapp_t)
    dev_rw_sysfs(diagrebootapp_t)
')

device_search_sockets(diagrebootapp_t)
allow diagrebootapp_t sysfs_t:file setattr;
allow diagrebootapp_t sysfs_t:lnk_file read;

allow diagrebootapp_t overlay_t:dir search_dir_perms;
