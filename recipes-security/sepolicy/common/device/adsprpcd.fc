/dsp(/.*)?                              gen_context(system_u:object_r:adsprpcd_t,s0)
/data/persist/sensors(/.*)?             gen_context(system_u:object_r:sensors_persist_data_t,s0)
/data/vendor/sensors(/.*)?              gen_context(system_u:object_r:sensors_vendor_data_t,s0)

/usr/bin/adsprpcd                       gen_context(system_u:object_r:adsprpcd_exec_t,s0)
/usr/bin/sensors\.qti                   gen_context(system_u:object_r:sensors_qti_exec_t,s0)
/usr/sbin/chgrp-sensors-see             gen_context(system_u:object_r:sensors_initrc_exec_t,s0)

/usr/lib/rfsa/adsp(/.*)?                gen_context(system_u:object_r:rfsa_adsp_lib_t,s0)
