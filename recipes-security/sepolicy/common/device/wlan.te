policy_module(wlan, 1.0)

########################################
#
# Declarations
#

type wlan_service_t;
type wlan_service_exec_t;
type wlan_service_tmp_t;

init_vendor_domain(wlan_service_t, wlan_service_exec_t)
inittab_domtrans(wlan_service_t, wlan_service_exec_t)

gen_require(`
type socket_device_t;
type default_t;
type wlan_initrc_t;
type modules_object_t;
type initrc_t;
type system_data_t;
')

userdebug_or_eng(`
    rw_diag_dev(wlan_service_t)
')

files_tmp_file(wlan_service_tmp_t)

allow wlan_service_t self:capability net_admin;
allow wlan_service_t self:fifo_file rw_fifo_file_perms;
allow wlan_service_t self:netlink_socket create_socket_perms;
allow wlan_service_t self:{socket qipcrtr_socket} create_socket_perms;
allow initrc_t system_data_t:lnk_file { read };
allow initrc_t system_data_t:dir { search };
search_dirs_pattern(wlan_service_t, socket_device_t, socket_device_t)
search_dirs_pattern(wlan_service_t, default_t, default_t)
userdom_manage_user_tmp_files(wlan_service_t)

manage_files_pattern(wlan_service_t, wlan_service_tmp_t, wlan_service_tmp_t)
files_tmp_filetrans(wlan_service_t, wlan_service_tmp_t, { file lnk_file dir })
dev_read_sysfs(wlan_service_t)
kernel_rw_net_sysctls(wlan_service_t)

networkmanager_read_wifi_sysdata_files(kernel_t)
allow kernel_t wifi_system_data_t:dir search_dir_perms;
allow wlan_initrc_t modules_object_t:file {getattr read};
