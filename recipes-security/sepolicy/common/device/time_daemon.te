policy_module(time_daemon, 1.0)

type time_daemon_t;
type time_daemon_exec_t;
type time_data_t;

init_vendor_domain(time_daemon_t, time_daemon_exec_t)

gen_require(`
    type default_t;
    type syslogd_var_run_t;
    type qmi_fw_vendor_t;
')

logging_send_syslog_msg(time_daemon_t)
dev_read_realtime_clock(time_daemon_t)
allow time_daemon_t time_data_t:dir { search write };
manage_user_data_files(time_daemon_t, time_data_t)
userdebug_or_eng(`
  rw_diag_dev(time_daemon_t);
')
allow time_daemon_t self:capability sys_time;
dontaudit time_daemon_t default_t:dir search;
allow time_daemon_t self:socket create_socket_perms;
user_data_files_type(time_data_t)
device_search_sockets(time_data_t)
data_filetrans(time_daemon_t, time_data_t, file)
allow time_daemon_t self:fifo_file rw_fifo_file_perms;
allow time_daemon_t socket_device_t:dir search;
allow time_daemon_t self:process signal;
allow time_daemon_t self:qipcrtr_socket { write read create getattr setopt };
allow time_daemon_t self:unix_stream_socket { accept listen };
allow time_daemon_t syslogd_var_run_t:dir search;
allow time_daemon_t qmi_fw_vendor_t:file read_file_perms;
