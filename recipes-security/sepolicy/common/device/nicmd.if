## <summary>Policy interfaces for nicmd.</summary>

########################################
## <summary>
##      Send and receive netlink messages from nicmd.
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed access.
##      </summary>
## </param>
#
interface(`nicmd_rw_netlink_sockets',`
    gen_require(`
        type nicmd_t;
    ')

    allow $1 nicmd_t:{
        netlink_route_socket
        netlink_socket
        netlink_xfrm_socket
        netlink_generic_socket
    } rw_socket_perms;
')