policy_module(display_manager, 1.0)

########################################
#
# Declarations
#

type display_manager_t;
type display_manager_exec_t;
type display_manager_data_t;

# Manage private files inside /data
user_data_files_type(display_manager_data_t)
manage_user_data_files(display_manager_t, display_manager_data_t)
data_filetrans(display_manager_t, display_manager_data_t, { file dir })

init_daemon_domain(display_manager_t, display_manager_exec_t)

gen_require(`
  type debugfs_t;
  type device_t;
  type etc_t;
  type fonts_cache_t;
  type fonts_t;
  type fs_t;
  type gpu_device_t;
  type home_root_t;
  type init_var_run_t;
  type initrc_t;
  type initrc_var_run_t;
  type ion_device_t;
  type node_t;
  type proc_t;
  type sysctl_t;
  type sysctl_vm_overcommit_t;
  type sysctl_vm_t;
  type systemd_logind_var_run_t;
  type systemd_resolved_var_run_t;
  type tmp_t;
  type tmpfs_t;
  type urandom_device_t;
  type user_home_dir_t;
  type user_runtime_root_t;
  type usr_t;
')

#============= display_manager_t ==============

ifdef(`init_systemd', `
  init_dbus_chat(display_manager_t);
  dbus_system_domain(display_manager_t, display_manager_exec_t);
  unconfined_dbus_chat(display_manager_t);
')

miscfiles_read_generic_certs(display_manager_t);
corenet_tcp_connect_cslistener_port(display_manager_t);
corenet_tcp_bind_cslistener_port(display_manager_t);
allow display_manager_t debugfs_t:dir search;
can_exec(display_manager_t,display_manager_exec_t);
manage_files_pattern(display_manager_t,etc_t,etc_t);
manage_lnk_files_pattern(display_manager_t,etc_t,etc_t);
manage_files_pattern(display_manager_t,fonts_cache_t,fonts_cache_t);
manage_files_pattern(display_manager_t,fonts_t,fonts_t);
allow display_manager_t fs_t:filesystem getattr;
manage_chr_files_pattern(display_manager_t,device_t,gpu_device_t);
getattr_dirs_pattern(display_manager_t,home_root_t,home_root_t);
stream_connect_pattern(display_manager_t,initrc_var_run_t,initrc_var_run_t,initrc_t);
manage_chr_files_pattern(display_manager_t,device_t,ion_device_t);
leprop_rw_props(display_manager_t);
allow display_manager_t node_t:tcp_socket node_bind;
kernel_read_system_state(display_manager_t);
allow display_manager_t self:capability net_raw;
allow display_manager_t self:fifo_file { read write };
allow display_manager_t self:netlink_route_socket { bind create getopt write read getattr setopt nlmsg_read };
allow display_manager_t self:tcp_socket { read create connect write getopt setopt accept bind listen shutdown };
allow display_manager_t self:unix_dgram_socket { write create connect };
allow display_manager_t sysctl_t:dir search;
allow display_manager_t sysctl_vm_overcommit_t:file { read open };
allow display_manager_t sysctl_vm_t:dir search;
allow display_manager_t systemd_logind_var_run_t:sock_file write;
manage_files_pattern(display_manager_t,tmp_t,tmp_t);
manage_lnk_files_pattern(display_manager_t,tmp_t,tmp_t);
manage_files_pattern(display_manager_t,tmpfs_t,tmpfs_t);
allow display_manager_t tmpfs_t:filesystem getattr;
allow display_manager_t urandom_device_t:chr_file { open write read getattr };
allow display_manager_t user_home_dir_t:dir { getattr search };
allow display_manager_t user_runtime_root_t:sock_file write;
manage_files_pattern(display_manager_t,usr_t,usr_t);
allow display_manager_t init_var_run_t:dir search;
allow display_manager_t init_var_run_t:file getattr;
allow display_manager_t systemd_resolved_var_run_t:file getattr;

# execmem is required by the Webkit Javascript JIT compiler
allow display_manager_t self:process { execmem getsched signal setcap };

