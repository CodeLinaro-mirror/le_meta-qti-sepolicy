policy_module(ota, 1.0)

gen_require(`
	type recovery_t;
	type recovery_exec_t;
	type tmp_t;
	type mtd_device_t;
	type system_dir_t;
	type unlabeled_t;
	type var_lib_t;
	type root_t;
	type shell_exec_t;
	type cache_t;
')

init_domain(recovery_t, recovery_exec_t)

mls_file_write_all_levels(recovery_t)
mls_file_read_all_levels(recovery_t)

fs_mount_xattr_fs(recovery_t)
fs_unmount_xattr_fs(recovery_t)

device_search_sockets(recovery_t)
data_mount_user_dir(recovery_t)

# mkfs.ubifs
device_read_ubi_device(recovery_t)

allow recovery_t self:capability {
	# mount/unmount
	sys_admin
	# to set file metadata
	chown fowner setfcap
	# makedevs
	fsetid mknod
	sys_boot
};
allow recovery_t self:fifo_file { read write getattr };

# call mkfs.ubifs
fstools_domtrans(recovery_t)

# extract to /tmp/update_binary and execute
allow recovery_t tmp_t:dir create_dir_perms;
allow recovery_t tmp_t:file { create_file_perms exec_file_perms };
allow recovery_t data_t:file map;
# makedevs
allow recovery_t unlabeled_t:{ blk_file chr_file } { create setattr };

# not covered by files_* macros. explicitly allow here.
auth_rw_shadow(recovery_t)
auth_relabelto_shadow(recovery_t)
seutil_relabelto_bin_policy(recovery_t)

files_manage_all_files(recovery_t)
files_relabel_all_files(recovery_t)

dev_manage_all_dev_nodes(recovery_t)

# To update recovery and recovery partitions using /dev/mtd
allow recovery_t mtd_device_t:chr_file rw_chr_file_perms;

relabel_all_data_files(recovery_t, data_t)
manage_user_data_files(recovery_t, data_t)
manage_system_data_files(recovery_t, system_data)

allow recovery_t shell_exec_t:file { execute execute_no_trans };
allow recovery_t recovery_exec_t:file execute_no_trans;
allow recovery_t { system_dir_t cache_t }:dir mounton;

selinux_get_fs_mount(recovery_t)

# Workaround updater-script quirks
# recursively label /system as var_lib_t
allow recovery_t var_lib_t:{ chr_file blk_file } { setattr relabelto };
# recursively label /system/dev as fixed_disk_device_t
allow recovery_t fixed_disk_device_t:dir { getattr setattr relabelto relabelfrom };
# labelling files under /system/home as user_u:user_home_t/user_home_dir_t,
# which violates constraint
domain_obj_id_change_exemption(recovery_t)
