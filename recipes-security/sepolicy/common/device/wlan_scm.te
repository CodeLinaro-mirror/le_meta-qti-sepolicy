policy_module(wlan_scm, 1.0)

type wlan_scm_t;
type wlan_scm_exec_t;
type etc_wlan_service_exec_t;
type scm_kernel_module_t;

init_vendor_domain(wlan_scm_t, wlan_scm_exec_t)
init_script_file(scm_kernel_module_t)

gen_require(`
type default_t;
type ifconfig_t;
type ifconfig_exec_t;
type wifi_system_data_t;
type kmod_t;
type kmod_exec_t;
ifdef(`init_systemd',`
  type system_dbusd_var_run_t;
  type systemd_logind_var_run_t;
  class service { start status stop reload };
  class dbus send_msg;
')
type modules_dep_t;
type hostapd_cli_qcmap_exec_t;
type hostapd_cli_qcmap_t;
type NetworkManager_t;
type NetworkManager_exec_t;
type NetworkManager_var_run_t;
type wpa_cli_exec_t;
type hostapd_qcmap_t;
type hostapd_qcmap_exec_t;
type qcmap_cm_t;
')

userdebug_or_eng(`
  rw_diag_dev(wlan_scm_t)
')

# Manage files in /var/run/scm
type scm_var_run_t;
files_pid_file(scm_var_run_t)
files_pid_filetrans(wlan_scm_t, scm_var_run_t, { file sock_file dir })
scm_manage_var_run_data_files(wlan_scm_t)
scm_manage_var_run_data_files(hostapd_qcmap_t)
scm_manage_var_run_data_files(hostapd_cli_qcmap_t)
scm_manage_var_run_data_files(NetworkManager_t)

# allow read access /etc/misc/wifi/
networkmanager_read_wifi_sysdata_files(wlan_scm_t)
kernel_read_system_state(wlan_scm_t)
allow wlan_scm_t wifi_system_data_t:dir search;

dev_rw_sysfs(wlan_scm_t)
userdebug_or_eng(`
  dev_write_kmsg(wlan_scm_t)
  mls_file_write_all_levels(wlan_scm_t)
')

networkmanager_domtrans(wlan_scm_t)
networkmanager_read_pid_files(wlan_scm_t)
networkmanager_signal(wlan_scm_t)

# Manage Dbus sockets
ifdef(`init_systemd',`
 dbus_system_bus_client(wlan_scm_t)
 init_dbus_chat(wlan_scm_t)
 rw_sock_files_pattern(wlan_scm_t, systemd_logind_var_run_t, systemd_logind_var_run_t)
 allow wlan_scm_t self:dbus send_msg;
 allow wlan_scm_t system_dbusd_var_run_t:sock_file { write };
 allow wlan_scm_t system_dbusd_var_run_t:dir { search };
')

kernel_rw_net_sysctls(wlan_scm_t)
kernel_search_fs_sysctls(wlan_scm_t)
kernel_rw_fs_sysctls(wlan_scm_t)
kernel_read_network_state(wlan_scm_t)

modutils_domtrans_insmod(wlan_scm_t)
allow kmod_t wlan_scm_t:{ netlink_socket unix_dgram_socket } { read write };
allow kmod_t scm_var_run_t:file { append };

# wpa ctrl socket
manage_sock_files_pattern(wlan_scm_t, NetworkManager_var_run_t, NetworkManager_var_run_t)
allow wlan_scm_t NetworkManager_t:unix_dgram_socket { sendto create_socket_perms };
allow NetworkManager_t wlan_scm_t:unix_dgram_socket { sendto create_socket_perms };

# allow start start_wlan_services
allow init_t etc_wlan_service_exec_t:file { getattr execute };

ifdef(`init_systemd',`
  allow qcmap_cm_t wlan_scm_exec_t:service { start stop status };
  allow wlan_scm_t etc_wlan_service_exec_t:service { status stop };
  allow wlan_scm_t scm_kernel_module_t:service { start stop status };
  allow wlan_scm_t hostapd_cli_qcmap_exec_t:service { status start stop };
  allow wlan_scm_t hostapd_qcmap_exec_t:service { status start stop };
  allow wlan_scm_t wpa_cli_exec_t:service { status start stop };
  allow wlan_scm_t NetworkManager_exec_t:service { status start stop };
')

# nl socket...
allow wlan_scm_t self: { netlink_generic_socket netlink_socket } create_socket_perms;

allow wlan_scm_t self: netlink_route_socket nlmsg_write;
# ifconfig
allow ifconfig_t scm_var_run_t:file write_file_perms;
allow wlan_scm_t self:udp_socket { create ioctl setopt bind write read };
allow wlan_scm_t ifconfig_exec_t:file { read open execute execute_no_trans getattr };

# brctl
allow wlan_scm_t self:tcp_socket connected_stream_socket_perms;

allow wlan_scm_t self:capability2 block_suspend;
allow wlan_scm_t self:capability net_admin;
allow wlan_scm_t self:fifo_file rw_fifo_file_perms;
# qmi ipc socket
allow wlan_scm_t self:socket { create_socket_perms connected_stream_socket_perms };

corecmd_exec_shell(wlan_scm_t)
corecmd_exec_bin(wlan_scm_t)
dontaudit wlan_scm_t default_t:dir { search };
