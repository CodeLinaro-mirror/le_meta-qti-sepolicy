policy_module(mrc_daemon, 1.0)

type mrc_daemon_t;
type mrc_daemon_exec_t;
type mrc_data_t;

gen_require(`
    type sysfs_t;
    type default_t;
    type tmp_t;
    type ubi_device_t;
    type proc_t;
    type socket_device_t;
    type mbim_device_t;
    type mtd_device_t;
')

init_vendor_domain(mrc_daemon_t, mrc_daemon_exec_t)

logging_send_syslog_msg(mrc_daemon_t)
allow mrc_daemon_t self:unix_dgram_socket { write create connect };
allow mrc_daemon_t sysfs_t:dir read;
dev_rw_sysfs(mrc_daemon_t)

user_data_files_type(mrc_data_t)
data_filetrans(mrc_daemon_t, mrc_data_t, { file dir })
manage_user_data_files(mrc_daemon_t, mrc_data_t)
device_search_sockets(mrc_daemon_t, socket_device_t)
allow mrc_daemon_t mrc_data_t:dir { create rw_dir_perms };
allow mrc_daemon_t self:capability sys_resource;
allow mrc_daemon_t sysfs_t:lnk_file read;
allow mrc_daemon_t self:fifo_file { read write };
allow mrc_daemon_t tmp_t:dir search;
allow mrc_daemon_t ubi_device_t:chr_file rw_chr_file_perms;
dontaudit mrc_daemon_t default_t:dir search;

userdebug_or_eng(`
    rw_diag_dev(mrc_daemon_t)
')

allow mrc_daemon_t mbim_device_t:chr_file rw_chr_file_perms;
allow mrc_daemon_t mtd_device_t:chr_file { read write getattr open ioctl };

allow mrc_daemon_t proc_t:file { getattr open read };
allow mrc_daemon_t self:socket { create ioctl read write getattr setopt };
