policy_module(qdmastatsd, 1.0)

type vendor_qdmastatsd_t;
type vendor_qdmastatsd_exec_t;

init_vendor_domain(vendor_qdmastatsd_t, vendor_qdmastatsd_exec_t)

gen_require(`
       type device_t;
       type default_t;
       type vendor_qdma_data_t;
       type vendor_qdma_sock_t;
       type rfs_persist_t;
')

## Data files for qdmastatsd ##
type vendor_qdmastatsd_data_t;
data_filetrans(vendor_qdmastatsd_t, vendor_qdmastatsd_data_t, file)
user_data_files_type(vendor_qdmastatsd_data_t)
manage_user_data_files(vendor_qdmastatsd_t, vendor_qdmastatsd_data_t)
manage_user_data_files(vendor_qdmastatsd_t, vendor_qdma_data_t)
allow vendor_qdmastatsd_t vendor_qdmastatsd_data_t:dir create_dir_perms;

type vendor_qdmastatsd_ramdump_device_t;
dev_node(vendor_qdmastatsd_ramdump_device_t)
read_chr_files_pattern(vendor_qdmastatsd_t, device_t, vendor_qdmastatsd_ramdump_device_t)

userdebug_or_eng(`
   rw_diag_dev(vendor_qdmastatsd_t);
 ')

## Read different files from sys and dev nodes ##
dev_read_sysfs(vendor_qdmastatsd_t)
logging_send_syslog_msg(vendor_qdmastatsd_t)
kernel_read_system_state(vendor_qdmastatsd_t)
kernel_read_vm_overcommit_sysctl(vendor_qdmastatsd_t)
allow vendor_qdmastatsd_t self:unix_dgram_socket { create write connect };
allow vendor_qdmastatsd_t self:fifo_file { write read };
allow vendor_qdmastatsd_t self:socket rw_socket_perms;
allow vendor_qdmastatsd_t self:process {signal};
device_search_sockets(vendor_qdmastatsd_t)

## MPS Collector and Campaign Manager
allow vendor_qdmastatsd_t self:socket create;
allow vendor_qdmastatsd_t rfs_persist_t:file { read_file_perms unlink };

##access qdma socket
rw_vendor_qdma_sock_file(vendor_qdmastatsd_t);
dontaudit vendor_qdmastatsd_t default_t:dir search;
allow vendor_qdmastatsd_t vendor_qdma_sock_t:dir { write remove_name add_name };
allow vendor_qdmastatsd_t vendor_qdma_sock_t:sock_file { create unlink setattr };

allow vendor_qdmastatsd_t self:process { signull };

#For leprop permissions
leprop_rw_props(vendor_qdmastatsd_t);
