policy_module(fs_scrub_daemon, 1.0)

type fs_scrub_daemon_t;
type fs_scrub_daemon_exec_t;
type fs_scrub_data_t;

gen_require(`
    type sysfs_t;
    type socket_device_t;
    type default_t;
    type device_t;
    type tmp_t;
    type ubi_device_t;
    type mtd_device_t;
    type debugfs_t;
')

init_vendor_domain(fs_scrub_daemon_t, fs_scrub_daemon_exec_t)
userdebug_or_eng(`
  rw_diag_dev(fs_scrub_daemon_t);
  allow fs_scrub_daemon_t debugfs_t:dir search;
')
logging_send_syslog_msg(fs_scrub_daemon_t)
allow fs_scrub_daemon_t self:unix_dgram_socket { write create connect };
allow fs_scrub_daemon_t self:socket { create ioctl read write };
allow fs_scrub_daemon_t sysfs_t:dir read;
dev_rw_sysfs(fs_scrub_daemon_t)

type fs_scrub_tmp_t;
files_tmp_file(fs_scrub_tmp_t);

user_data_files_type(fs_scrub_data_t)
data_filetrans(fs_scrub_daemon_t, fs_scrub_data_t, { file dir })
manage_user_data_files(fs_scrub_daemon_t, fs_scrub_data_t)
device_search_sockets(fs_scrub_daemon_t, socket_device_t)
allow fs_scrub_daemon_t fs_scrub_data_t:dir { create rw_dir_perms };
allow fs_scrub_daemon_t self:capability sys_resource;
allow fs_scrub_daemon_t sysfs_t:lnk_file read;
allow fs_scrub_daemon_t self:fifo_file { read write };
allow fs_scrub_daemon_t mtd_device_t:chr_file getattr;
allow fs_scrub_daemon_t tmp_t:dir search;
allow fs_scrub_daemon_t fs_scrub_tmp_t:lnk_file read;
allow fs_scrub_daemon_t ubi_device_t:chr_file { read ioctl open };
dontaudit fs_scrub_daemon_t default_t:dir search;
allow fs_scrub_daemon_t self:socket { getattr setopt };
allow fs_scrub_daemon_t self:qipcrtr_socket create_socket_perms;
