policy_module(data_path_opt, 1.0)


type datadpo_device_t;
dev_node(datadpo_device_t)

#data_path_opt declaration
type data_path_opt_exec_t;
type data_path_opt_t;
init_vendor_domain(data_path_opt_t, data_path_opt_exec_t )


gen_require(`
  type debugfs_t;
  type kmod_t;
')


userdebug_or_eng(`
         dev_write_kmsg(data_path_opt_t)
         mls_file_write_all_levels(data_path_opt_t);
')

#data_path_opt policies
modutils_domtrans(data_path_opt_t)
dev_read_sysfs(data_path_opt_t)
corecmd_exec_shell(data_path_opt_t)

kernel_read_system_state(data_path_opt_t)
dontaudit data_path_opt_t debugfs_t:dir { search };
allow data_path_opt_t data_path_opt_t:chr_file { write getattr };
allow data_path_opt_t data_path_opt_t:fifo_file {  getattr read write };

dontaudit kmod_t self:capability { dac_read_search };
