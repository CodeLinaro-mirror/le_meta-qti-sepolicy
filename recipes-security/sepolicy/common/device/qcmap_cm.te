dev_write_kmsg(data_path_opt_t)
ifdef(`init_systemd',`
    allow qcmap_cm_t data_path_opt_exec_t:service { start stop status reload };
')
kernel_read_system_state(data_path_opt_t)
dontaudit data_path_opt_t debugfs_t:dir { search };
allow data_path_opt_t data_path_opt_t:chr_file { write getattr };
allow data_path_opt_t data_path_opt_t:fifo_file {  getattr read write };
allow qcmap_cm_t data_path_opt_exec_t:file { getattr execute read open execute_no_trans };

#allow exectution of mtd tools
mtd_tools_exec(qcmap_cm_t)
userdebug_or_eng(`
     rw_diag_dev(qcmap_cm_t)
')

#Avahi Policies
rw_sock_files_pattern(avahi_t, systemd_logind_var_run_t, systemd_logind_var_run_t)

#tinyproxy policies
ifdef(`init_systemd',`
    allow qcmap_cm_t tinyproxy_exec_t:service { start stop status reload };
    files_var_filetrans(tinyproxy_t, tinyproxy_tmp_t, { file })
')
read_system_data_files(tinyproxy_t, qcmap_etc_data_t)
allow tinyproxy_t devlog_t:sock_file write_sock_file_perms;
logging_log_file(tinyproxy_log_t)
logging_log_filetrans(tinyproxy_t, tinyproxy_log_t, { dir file lnk_file } )
manage_dirs_pattern(tinyproxy_t, var_log_t, tinyproxy_log_t)
manage_files_pattern(tinyproxy_t, var_log_t, tinyproxy_log_t)
allow tinyproxy_t etc_t:file read_file_perms;
files_tmp_file(tinyproxy_tmp_t)
files_tmp_filetrans(tinyproxy_t, tinyproxy_tmp_t, { file dir })
manage_files_pattern(tinyproxy_t, tmp_t, tinyproxy_tmp_t)
manage_files_pattern(tinyproxy_t, var_run_t, tinyproxy_var_run_t)
files_pid_file(tinyproxy_var_run_t)
files_pid_filetrans(tinyproxy_t, tinyproxy_var_run_t, { file dir })
allow tinyproxy_t var_log_t:lnk_file read_lnk_file_perms;
search_dirs_pattern(tinyproxy_t, qcmap_etc_data_t, qcmap_etc_data_t)
search_dirs_pattern(tinyproxy_t, var_log_t, tinyproxy_log_t)
allow tinyproxy_t self:udp_socket { create ioctl setopt bind write read connect getattr };
allow tinyproxy_t self:tcp_socket { connected_stream_socket_perms connect };
allow tinyproxy_t unreserved_port_t:tcp_socket { name_bind };
allow tinyproxy_t node_t:tcp_socket { node_bind listen };
allow tinyproxy_t self:netlink_route_socket create_socket_perms;
allow tinyproxy_t self:netlink_route_socket { nlmsg_read };
allow tinyproxy_t self:capability { setuid net_bind_service setgid kill net_admin net_raw };
allow tinyproxy_t self:unix_dgram_socket { sendto create_socket_perms };
allow tinyproxy_t syslogd_t:unix_dgram_socket { sendto };
allow tinyproxy_t self:process { signal };
allow tinyproxy_t etc_t:lnk_file read_lnk_file_perms;
allow tinyproxy_t usr_t:file read_file_perms;
allow tinyproxy_t net_conf_t:file read_file_perms;
search_dirs_pattern(tinyproxy_t, init_var_run_t, init_var_run_t)
corenet_tcp_connect_http_cache_port(tinyproxy_t)
manage_files_pattern(tinyproxy_t, systemd_resolved_var_run_t, systemd_resolved_var_run_t)
corenet_tcp_connect_http_port(tinyproxy_t)

#miniupnpd policies
type miniupnp_t;
type miniupnp_exec_t;
type miniupnp_var_run_t;

init_vendor_domain(miniupnp_t, miniupnp_exec_t)

files_pid_file(miniupnp_var_run_t)

gen_require(`
  type ssdp_port_t;
')

ifdef(`init_systemd', `
  allow qcmap_cm_t miniupnp_exec_t:service { start stop status reload };
')

files_rw_qcmap_etc_data_files(miniupnp_t)
kernel_dontaudit_read_system_state(miniupnp_t)
allow miniupnp_t proc_net_t: file { read };
logging_send_syslog_msg(miniupnp_t)
dev_read_sysfs(miniupnp_t)
allow miniupnp_t miniupnp_t: capability { net_admin };
corenet_tcp_bind_generic_node(miniupnp_t)
corenet_udp_bind_generic_node(miniupnp_t)
allow miniupnp_t self:udp_socket create_socket_perms;
allow miniupnp_t miniupnp_t: socket  create_socket_perms;
allow miniupnp_t self:fifo_file rw_fifo_file_perms;
files_pid_filetrans(miniupnp_t, miniupnp_var_run_t, { dir file sock_file })
allow miniupnp_t miniupnp_var_run_t  : dir {create};
allow miniupnp_t self:tcp_socket create_stream_socket_perms;
allow miniupnp_t self:netlink_route_socket { create_socket_perms nlmsg_read };
allow miniupnp_t ssdp_port_t: udp_socket { name_bind };
corenet_udp_bind_all_unreserved_ports(miniupnp_t)
manage_files_pattern(miniupnp_t, miniupnp_var_run_t, miniupnp_var_run_t)
userdebug_or_eng(`
  rw_chr_files_pattern(miniupnp_t, device_t, diag_device_t)
')
dontaudit miniupnp_t default_t : dir search;
dontaudit miniupnp_t self:capability sys_module;
allow miniupnp_t self:qipcrtr_socket { create_socket_perms };
dontaudit miniupnp_t self:process { setcap getcap };
dontaudit miniupnp_t self:capability setpcap;
kernel_read_kernel_sysctls(miniupnp_t)
device_search_sockets(miniupnp_t)

allow qcmap_cm_t self:capability setpcap;
search_dirs_pattern(httpd_t, socket_device_t, webserver_socket_device_t)
corenet_tcp_connect_virt_migration_port(miniupnp_t)
allow miniupnp_t { unreserved_port_t }:tcp_socket { name_connect };
#This is to access symlink created for emac mtd partition
read_lnk_files_pattern(qcmap_cm_t, tmp_t, qcmap_tmp_t);

search_dirs_pattern(qcmap_cm_t, dhcpc_var_run_t, dhcpc_var_run_t)
allow ifconfig_t dhcpc_t:unix_stream_socket rw_socket_perms;
