# allow qcmap_cm_t { init_t kernel_t }:file { read open };
# allow qcmap_cm_t init_t:lnk_file { read };
read_write_qcmap_cm_socket_files(iptables_t)
allow qcmap_cm_t dnsmasq_var_run_t:file manage_file_perms;
allow qcmap_cm_t dnsmasq_t:process { sigkill signal };
allow qcmap_cm_t dnsmasq_tmp_t:file { read_file_perms unlink };
