policy_module(recovery , 1.0)

########################################
#
# Declarations
#
type cache_recoveryupgrade_t;
type data_otapackage_t;
type recovery_initrc_tmp_t;
# recovery initscript
type recovery_initrc_exec_t;
type recovery_initrc_t;
init_script_domain(recovery_initrc_t, recovery_initrc_exec_t)
files_type(cache_recoveryupgrade_t)
user_data_files_type(data_otapackage_t)
files_tmp_file(recovery_initrc_tmp_t)
recovery_upgrade_rw_files(recovery_initrc_t)

allow recovery_initrc_t cache_recoveryupgrade_t:dir { open read write create getattr search add_name };
allow recovery_initrc_t cache_recoveryupgrade_t:file { open read write create getattr };
allow recovery_initrc_t recovery_initrc_tmp_t:file { open read write create getattr };
allow recovery_initrc_t self:fifo_file { read write getattr ioctl};
allow setfiles_t cache_recoveryupgrade_t:{ dir file } relabelto;
