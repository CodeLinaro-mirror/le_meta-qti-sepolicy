policy_module(rebootd, 1.0)

type rebootd_t;
type rebootd_exec_t;

init_vendor_domain(rebootd_t, rebootd_exec_t)

allow rebootd_t self:capability chown;
allow rebootd_t self:capability sys_ptrace;

type rebootd_pipe_t;
dev_node(rebootd_pipe_t)

gen_require(`
    type device_t;
')
type_transition rebootd_t device_t:fifo_file rebootd_pipe_t "rebooterdev";
manage_fifo_files_pattern(rebootd_t, device_t, rebootd_pipe_t)
userdebug_or_eng(`
    gen_require(`
         type var_run_t;
         type init_t;
         type init_var_run_t;
         type unconfined_t;
    ')
    corecmd_exec_shell(rebootd_t)
    #files_read_generic_pids(rebootd_t)
    init_read_state(rebootd_t)
    allow rebootd_t self:capability net_admin;
    #allow rebootd_t var_run_t:sock_file write;
    manage_files_pattern(rebootd_t, init_var_run_t, init_var_run_t)
    manage_sock_files_pattern(rebootd_t, init_var_run_t, init_var_run_t)
    manage_fifo_files_pattern(rebootd_t, init_var_run_t, init_var_run_t)
    manage_dirs_pattern(rebootd_t, init_var_run_t, init_var_run_t)
    shutdown_domtrans(rebootd_t)
    kernel_read_system_state(rebootd_t)
    init_exec(rebootd_t)
    init_rw_initctl(rebootd_t)
    init_read_utmp(rebootd_t)
    allow rebootd_t self:capability setuid;
    allow rebootd_t self:unix_dgram_socket create_socket_perms;
    allow rebootd_t var_run_t:dir create_dir_perms;
    allow unconfined_t rebootd_pipe_t:fifo_file getattr;
')
## reset reboot cookie script ##
type reset_reboot_initrc_exec_t;
type reset_reboot_initrc_t;
type reboot_cookie_data_t;
user_data_files_type(reboot_cookie_data_t)
init_script_domain(reset_reboot_initrc_t, reset_reboot_initrc_exec_t)
manage_user_data_files(reset_reboot_initrc_t, reboot_cookie_data_t)
corecmd_exec_shell(reset_reboot_initrc_t)
#dev_create_null_dev(reset_reboot_initrc_t)
term_read_console(reset_reboot_initrc_t)
kernel_read_system_state(reset_reboot_initrc_t)
files_read_etc_files(reset_reboot_initrc_t)
logging_list_logs(reset_reboot_initrc_t)
auth_manage_login_records(reset_reboot_initrc_t)
gen_require(`
    type var_log_t;
    type system_dbusd_t;
    type kernel_t;
    type qrtr_ns_t;
    type getty_t;
    type udev_t;
    type system_dbusd_t;
    type systemd_logind_t;
    type initrc_t;
    type servicemanager_t;
    type diagrebootapp_t;
    type leprop_t;
    type adbd_t;
    type init_t;
    type unconfined_t;
    type systemd_unit_t;
    type systemd_logind_var_run_t;
    type system_dbusd_var_run_t;
    type power_unit_t;
    type local_login_t;
    class service stop;
    class service status;
    class service start;
    class dbus send_msg;
')
create_lnk_files_pattern(reset_reboot_initrc_t, var_log_t, var_log_t)
data_filetrans(reset_reboot_initrc_t, reboot_cookie_data_t, file)
allow rebootd_t system_dbusd_t:dbus send_msg;
allow rebootd_t kernel_t:dir search;
allow rebootd_t kernel_t:file { read open };
allow rebootd_t kernel_t:lnk_file read;
allow rebootd_t qrtr_ns_t:lnk_file read;
allow rebootd_t qrtr_ns_t:file { read open };
allow rebootd_t qrtr_ns_t:dir search;
allow rebootd_t getty_t:dir search;
allow rebootd_t getty_t:lnk_file read;
allow rebootd_t getty_t:file { read open };
allow rebootd_t udev_t:dir search;
allow rebootd_t udev_t:lnk_file read;
allow rebootd_t udev_t:file { read open };
allow rebootd_t system_dbusd_t:dir search;
allow rebootd_t system_dbusd_t:lnk_file read;
allow rebootd_t system_dbusd_t:file { read open };
allow rebootd_t system_dbusd_t:unix_stream_socket connectto;
allow rebootd_t systemd_logind_t:dir search;
allow rebootd_t systemd_logind_t:lnk_file read;
allow rebootd_t systemd_logind_t:file { read open };
allow rebootd_t initrc_t:dir search;
allow rebootd_t initrc_t:lnk_file read;
allow rebootd_t initrc_t:file { read open };
allow rebootd_t servicemanager_t:dir search;
allow rebootd_t servicemanager_t:lnk_file read;
allow rebootd_t servicemanager_t:file { read open };
allow rebootd_t diagrebootapp_t:dir search;
allow rebootd_t diagrebootapp_t:lnk_file read;
allow rebootd_t diagrebootapp_t:file { read open };
allow rebootd_t local_login_t:dir search;
allow rebootd_t local_login_t:lnk_file read;
allow rebootd_t local_login_t:file { read open };
allow rebootd_t leprop_t:dir search;
allow rebootd_t leprop_t:lnk_file read;
allow rebootd_t leprop_t:file { read open };
allow rebootd_t adbd_t:dir search;
allow rebootd_t adbd_t:lnk_file read;
allow rebootd_t adbd_t:file { read open };
allow rebootd_t init_t:unix_stream_socket connectto;
allow rebootd_t unconfined_t:dir search;
allow rebootd_t unconfined_t:lnk_file read;
allow rebootd_t unconfined_t:file { read open };
allow rebootd_t systemd_unit_t:service { stop status };
allow rebootd_t systemd_logind_var_run_t:sock_file write;
allow rebootd_t system_dbusd_var_run_t:dir search;
allow rebootd_t system_dbusd_var_run_t:lnk_file read;
allow rebootd_t system_dbusd_var_run_t:file { read open };
allow rebootd_t power_unit_t:service {start stop status };
