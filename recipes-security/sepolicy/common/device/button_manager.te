policy_module(button_manager, 1.0)

########################################
#
# Declarations
#

type button_manager_t;
type button_manager_exec_t;
type button_manager_data_t;

# Manage private files inside /data
user_data_files_type(button_manager_data_t)
manage_user_data_files(button_manager_t, button_manager_data_t)
data_filetrans(button_manager_t, button_manager_data_t, { file dir })

init_daemon_domain(button_manager_t, button_manager_exec_t)

gen_require(`
	type event_device_t;
	type voice-ui-app_t;
        type init_var_run_t;
        type syslogd_var_run_t;
')

#============= button_manager_t ==============
allow button_manager_t event_device_t:chr_file { read open };
kernel_read_system_state(button_manager_t)

dev_read_urand(button_manager_t)

use_wakelock(button_manager_t)
allow button_manager_t self:unix_dgram_socket { create connect write };

allow button_manager_t init_var_run_t:dir search; #/run/systemd
allow button_manager_t syslogd_var_run_t:sock_file write; #/run/systemd/journal/dev-log
logging_send_syslog_msg(button_manager_t)

## for DBus
ifdef(`init_systemd', `
    init_dbus_chat(button_manager_t)
    dbus_system_domain(button_manager_t, button_manager_exec_t)
    adk_audio_manager_dbus_chat(button_manager_t);
    init_dbus_send_script(button_manager_t);
    adk_dbus_send_rules_manager(button_manager_t);
    allow button_manager_t voice-ui-app_t:dbus send_msg;
    adk_dbus_send_led_manager(button_manager_t);
    adk_dbus_send_connectivity_manager(button_manager_t);
    unconfined_dbus_chat(button_manager_t)
')
