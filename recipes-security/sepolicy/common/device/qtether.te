policy_module(qtether, 1.0)

type qtether_t;
type qtether_exec_t;
type dataqti_device_t;

init_vendor_domain(qtether_t, qtether_exec_t)
logging_send_syslog_msg(qtether_t)
dev_node(dataqti_device_t)

userdebug_or_eng(`
    rw_diag_dev(qtether_t)
')

gen_require(`
    type default_t;
    type qti_ppp_socket_device_t;
    type dataqti_ppp_t;
')
dontaudit qtether_t default_t:dir { search };

dev_write_kmsg(qtether_t)
dev_read_sysfs(qtether_t)
files_rw_qcmap_etc_data_files(qtether_t)
vendor_kernel_load_exempt(qtether_t)  # TODO: Request init to load the module
kernel_load_module(qtether_t)

allow qtether_t self:{ socket udp_socket } create_socket_perms;
allow qtether_t self:netlink_route_socket { create_socket_perms nlmsg_read nlmsg_write };
allow qtether_t self:fifo_file rw_fifo_file_perms;
allow qtether_t self:capability { net_raw net_admin };

# Don't implicitly load kernel modules
kernel_dontaudit_request_load_module(qtether_t)

type qtether_log_t;
user_data_files_type(qtether_log_t)
data_filetrans(qtether_t, qtether_log_t, file)
manage_user_data_files(qtether_t, qtether_log_t)

dev_write_kmsg(qtether_t)
rw_chr_files_pattern(qtether_t, device_t, dataqti_device_t)
userdebug_or_eng(`
  rw_diag_dev(qtether_t);
')
corecmd_check_exec_shell(qtether_t);

sysnet_exec_ifconfig(qtether_t)
corecmd_exec_shell(qtether_t)
kernel_read_system_state(qtether_t)
ifndef(`init_systemd', `dev_rw_generic_chr_files(qtether_t)')
files_dontaudit_getattr_default_dirs(qtether_t)
kernel_read_network_state(qtether_t)
qcmap_manage_user_data_files(qtether_t)

# Manage socket files inside /dev/socket
type qtether_socket_device_t;
files_type(qtether_socket_device_t)
dev_node(qtether_socket_device_t)
device_manage_socket_file(qtether_t, qtether_socket_device_t)
device_rw_socket_files(qtether_t, qti_ppp_socket_device_t)

allow qtether_t self:netlink_kobject_uevent_socket create_socket_perms;

#Manage private files inside /var/run
type qtether_var_run_t;
files_pid_file(qtether_var_run_t)
allow qtether_t qtether_var_run_t:sock_file { create write };
qcmap_manage_var_run_data_files(qtether_t)
files_pid_filetrans(qtether_t, qtether_var_run_t, { file sock_file dir })
allow qtether_t dataqti_ppp_t:unix_dgram_socket { sendto };

#dont audit setuid and setgid
dontaudit qtether_t self: capability {setuid setgid};
