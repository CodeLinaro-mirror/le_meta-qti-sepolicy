policy_module(diag, 1.0)

########################################
#
# Declarations
#

type diag_t;
type diag_exec_t;
type sdcard_t;
files_mountpoint(sdcard_t)
gen_require(`
   type default_t;
')

init_vendor_domain(diag_t, diag_exec_t)

#============= diag_t ==============
userdebug_or_eng(`
   allow diag_t default_t:lnk_file read;
   rw_diag_dev(diag_t)
   allow diag_t self:capability { setuid setgid };
   allow diag_t self:capability2 block_suspend;
   allow diag_t self:process signal;
   allow diag_t self:tcp_socket { create setopt connect };
   dev_rw_sysfs(diag_t)
   corenet_tcp_connect_all_unreserved_ports(diag_t)
   manage_files_pattern(diag_t, sdcard_t, sdcard_t)
   gen_require(`
      attribute adb_data_conf_t;
   ')
   allow diag_t self:fifo_file rw_fifo_file_perms;
   can_exec(diag_t, diag_exec_t)
   read_user_data_files(diag_t, adb_data_conf_t)
   dev_write_kmsg(diag_t)
   kernel_read_system_state(diag_t)
')
