# Allow relabeling and changing DAC permissions of /dev/socket/* from systemd-tmpfiles
gen_require(`
    type systemd_tmpfiles_t;
')

userdebug_or_eng(`
    allow kmod_t kernel_tests_t:dir search;
')

gen_require(`
    type kmod_t;
')
manage_dirs_pattern(systemd_tmpfiles_t, device_t, socket_device_t)
systemd_tmpfilesd_managed(socket_device_t, dir)

#sepolicy for touch start le script
type touch_script_t;
type touch_script_exec_t;
gen_require(`
    type touch_input_device_t;
')
files_type(touch_script_exec_t)
init_script_domain(touch_script_t, touch_script_exec_t)
modutils_domtrans_insmod(touch_script_t)
userdebug_or_eng(`
    dev_write_kmsg(touch_script_t)
    mls_file_write_all_levels(touch_script_t)
')
files_read_etc_files(touch_script_t)
dev_read_sysfs(touch_script_t)
init_rw_stream_sockets(touch_script_t)
kernel_read_system_state(touch_script_t);
allow touch_script_t self:capability { chown };
allow touch_script_t touch_input_device_t:file { getattr setattr };
corecmd_exec_shell(touch_script_t)
