policy_module(vendor, 1.0)

### common domain policies

allow domain self:unix_dgram_socket { create_socket_perms sendto };

attribute vendor_domain;

# Common neverallows

gen_require(`
    type device_t;
    type unlabeled_t;
    type sysfs_t;
    type proc_t;
    type rebootd_t;
    type mount_runtime_t;
    type fs_t;
    type tmpfs_t;
    type security_t;
    type var_run_t;
    type leprop_sock_t;
    type sysctl_vm_t;
    type sysdevice_sysfs_t;
    type sysfs_vblank_t;
    type setprop_exec_t;
    type sysfs_power_state_t;
    type sysfs_usb_mode_t;
')
# No rw access to generic files in /dev
attribute vendor_device_rw_exception;
neverallow { vendor_domain -vendor_device_rw_exception } device_t:devfile_class_set rw_file_perms;
# No creation of unlabeled directories or files
neverallow vendor_domain unlabeled_t:dir_file_class_set create;
# Restricted permissions
#TODO: Restore mknod?
neverallow vendor_domain self:capability { dac_override };
neverallow vendor_domain self:process { execstack execheap };
# Do not load kernel modules - request init to do this instead
attribute vendor_kernel_load_exception;
neverallow { vendor_domain -vendor_kernel_load_exception } self:system { module_load module_request };
# Do not allow userspace creation of files in kernel managed directories (outside of initscripts)
#   rebootd creates a fifo_file in /dev - allow this for now
neverallow {
    vendor_domain
    -rebootd_t
} { sysfs_t proc_t device_t }:dir { add_name create link remove_name rename reparent rmdir write };
dontaudit vendor_domain { sysfs_t proc_t }:dir write;
kernel_dontaudit_request_load_module(vendor_domain)

# Do not allow communication with unlabeled sockets
neverallow vendor_domain initrc_t:unix_stream_socket connectto;

### tftp server ###

type tftp_server_t;
type tftp_server_exec_t;
init_vendor_domain(tftp_server_t, tftp_server_exec_t)
inittab_domtrans(tftp_server_t, tftp_server_exec_t)
type dumgr_config_t;
allow tftp_server_t dumgr_config_t:dir { search read };
allow tftp_server_t dumgr_config_t:file { getattr open read};
allow initrc_t dumgr_config_t:dir relabelto;
allow initrc_t dumgr_config_t:file relabelto;
allow dumgr_config_t fs_t:filesystem associate;

# /sys/power/wakelock
dev_rw_sysfs(tftp_server_t)
allow tftp_server_t self:capability2 block_suspend;

# /system/rfs/msm/mpss
system_read_link_files(tftp_server_t)

firmware_read_files(tftp_server_t)
logging_send_syslog_msg(tftp_server_t)

allow tftp_server_t self:socket create_socket_perms;
allow tftp_server_t self:process signal;
allow tftp_server_t self:capability net_bind_service;
dontaudit tftp_server_t self:capability net_raw;
kernel_read_vm_overcommit_sysctl(tftp_server_t)

firmware_manage_shared_props(tftp_server_t)
manage_user_data_files(tftp_server_t, mpss_persist_t)
manage_user_data_files(tftp_server_t, adsp_persist_t)

# /run/systemd/journal
mls_file_read_all_levels(tftp_server_t)

allow tftp_server_t self:qipcrtr_socket create_socket_perms;
dontaudit tftp_server_t self:capability { dac_override dac_read_search };

type tombstone_data_t;
user_data_files_type(tombstone_data_t)
userdebug_or_eng(`
    manage_user_data_files(tftp_server_t, tombstone_data_t)
')

type rfs_persist_t;
user_data_files_type(rfs_persist_t)

type tombstone_rfs_data_t;
user_data_files_type(tombstone_rfs_data_t)
allow tftp_server_t tombstone_rfs_data_t:dir setattr;

allow tftp_server_t rfs_persist_t:dir { create setattr };
allow tftp_server_t self:capability { setuid chown setgid setpcap };
allow tftp_server_t self:process setcap;
allow tftp_server_t rfs_persist_t:dir create_dir_perms;
allow tftp_server_t rfs_persist_t:file { create_file_perms write read setattr };
files_read_etc_files(tftp_server_t)

### misc properties ###

type mpss_persist_t;
user_data_files_type(mpss_persist_t)
type adsp_persist_t;
user_data_files_type(adsp_persist_t)
type kernel_tests_t;
files_type(kernel_tests_t)

### misc files ###

type target_etc_t;
files_type(target_etc_t)

### init.post_boot.sh

type post_boot_script_t;
type post_boot_script_exec_t;
files_type(post_boot_script_exec_t)
init_script_domain(post_boot_script_t, post_boot_script_exec_t)
corecmd_exec_shell(post_boot_script_t)

dev_rw_sysfs(post_boot_script_t)
kernel_rw_kernel_sysctl(post_boot_script_t)
fstools_domtrans(post_boot_script_t)
mount_exec(post_boot_script_t)
init_rw_stream_sockets(post_boot_script_t)
type tvmapploader_ramdisk_t;
dev_node(tvmapploader_ramdisk_t);
files_list_mnt(post_boot_script_t)
type tvmapp_t;
files_type(tvmapp_t)
allow post_boot_script_t mount_runtime_t:dir { read write getattr search };
allow post_boot_script_t tvmapp_t:dir { getattr mounton };
kernel_read_system_state(post_boot_script_t)
allow post_boot_script_t tvmapploader_ramdisk_t:blk_file { getattr };
allow post_boot_script_t fs_t:filesystem { mount relabelfrom };
allow post_boot_script_t tvmapp_t:filesystem { mount relabelfrom };
allow post_boot_script_t self:capability sys_admin;
allow post_boot_script_t var_run_t:dir { getattr search };
allow post_boot_script_t var_run_t:lnk_file read;

allow post_boot_script_t leprop_sock_t:sock_file write;
allow post_boot_script_t self:fifo_file rw_file_perms;
allow post_boot_script_t self:unix_stream_socket { create connect };
allow post_boot_script_t socket_device_t:dir search;
allow post_boot_script_t sysctl_vm_t:dir search;
allow post_boot_script_t sysctl_vm_t:file write_file_perms;
allow post_boot_script_t sysdevice_sysfs_t:file read_file_perms;
allow post_boot_script_t sysfs_vblank_t:file read_file_perms;
allow post_boot_script_t setprop_exec_t:file getattr;

seutil_read_config(post_boot_script_t)
allow post_boot_script_t security_t:filesystem { getattr };

dontaudit post_boot_script_t domain:filesystem { getattr };
dontaudit post_boot_script_t tmpfs_t:filesystem getattr;
dontaudit post_boot_script_t kernel_t:process setsched;

allow post_boot_script_t etc_t:file read_file_perms;
allow post_boot_script_t sysfs_power_state_t:file { getattr_file_perms setattr_file_perms };
allow post_boot_script_t sysfs_usb_mode_t:file { getattr_file_perms setattr_file_perms };
allow post_boot_script_t self:capability chown;

