policy_module(connectivity_manager, 1.0)

########################################
#
# Declarations
#

type connectivity_manager_t;
type connectivity_manager_exec_t;
type connectivity_manager_data_t;

# Manage private files inside /data
user_data_files_type(connectivity_manager_data_t)
manage_user_data_files(connectivity_manager_t, connectivity_manager_data_t)
data_filetrans(connectivity_manager_t, connectivity_manager_data_t, { file dir })

init_daemon_domain(connectivity_manager_t, connectivity_manager_exec_t)

gen_require(`
	type var_t;
	type proc_net_t;
')

corecmd_exec_shell(connectivity_manager_t)
dev_read_urand(connectivity_manager_t)

#============= connectivity_manager_t ==============
files_search_default(connectivity_manager_t)
userdebug_or_eng(`
  rw_diag_dev(connectivity_manager_t);
')
allow connectivity_manager_t proc_net_t:file { open read getattr };
kernel_read_system_state(connectivity_manager_t)
allow connectivity_manager_t self:socket { getattr read write create };
allow connectivity_manager_t self:unix_dgram_socket { create connect };

## for DBus
ifdef(`init_systemd', `
    init_dbus_chat(connectivity_manager_t)
    dbus_system_domain(connectivity_manager_t, connectivity_manager_exec_t)
    unconfined_dbus_chat(connectivity_manager_t);
    allow connectivity_manager_t initrc_t:dbus send_msg;
    adk_audio_manager_dbus_chat(connectivity_manager_t);
    adk_led_manager_dbus_chat(connectivity_manager_t);
    adk_rules_manager_dbus_chat(connectivity_manager_t);
    allow connectivity_manager_t self:dbus send_msg;
    adk_voice_ui_dbus_chat(connectivity_manager_t);
')
