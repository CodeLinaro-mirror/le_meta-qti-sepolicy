### tftp server ###

/usr/sbin/tftp_server     --    gen_context(system_u:object_r:tftp_server_exec_t,s0)
/data/tombstones(/.*)?       gen_context(system_u:object_r:tombstone_data_t,s0)
/data/vendor/pddump(/.*)?       gen_context(system_u:object_r:vendor_pddump_rfs_data_t,s0)

### misc properties ###

/data/data/vendor/tombstones(/.*)? gen_context(system_u:object_r:tombstone_rfs_data_t,s0)
/data/persist/rfs(/.*)?            gen_context(system_u:object_r:rfs_persist_t,s0)
/data/persist/hlos_rfs(/.*)?       gen_context(system_u:object_r:rfs_persist_t,s0)
/data/persist/rfs/mdm/mpss(/.*)?   gen_context(system_u:object_r:mpss_persist_t,s0)
/data/persist/rfs/msm/mpss(/.*)?   gen_context(system_u:object_r:mpss_persist_t,s0)
/data/persist/rfs/mdm/adsp(/.*)?   gen_context(system_u:object_r:adsp_persist_t,s0)
/data/persist/rfs/msm/adsp(/.*)?   gen_context(system_u:object_r:adsp_persist_t,s0)
/kernel-tests(/.*)?                gen_context(system_u:object_r:kernel_tests_t,s0)
/kernel-tests/modules/lib/modules(/.*)?  gen_context(system_u:object_r:modules_object_t,s0)
/data/kernel-tests/modules/lib/modules(/.*)? gen_context(system_u:object_r:kerneltests_modules_data_t,s0)

### misc files ###

/target -- gen_context(system_u:object_r:target_etc_t,s0)
/etc/init.post_boot.sh  --      gen_context(system_u:object_r:post_boot_script_exec_t,s0)
/mnt/tvmapp                     gen_context(system_u:object_r:tvmapp_t,s0)
/dev/ram5                       gen_context(system_u:object_r:tvmapploader_ramdisk_t, s0)

### dev nodes ###

/dev/subsys_modem    gen_context(system_u:object_r:subsys_modem_device_t,s0)
/dev/subsys_wcnss    gen_context(system_u:object_r:subsys_ssr_device_t,s0)

/dev/msm_.*                 gen_context(system_u:object_r:audio_device_t,s0)
/dev/wcd_dsp0_control   --  gen_context(system_u:object_r:audio_device_t,s0)
/dev/wcd-dsp-glink      --  gen_context(system_u:object_r:audio_device_t,s0)
/dev/aud_pasthru_adsp   -c  gen_context(system_u:object_r:audio_device_t,s0)
/dev/media([0-9])+    -c    gen_context(system_u:object_r:video_device_t,s0)
/dev/v4l-subdev.*          gen_context(system_u:object_r:video_device_t,s0)
/dev/video([0-44])+   -c    gen_context(system_u:object_r:video_device_t,s0)
/dev/smem_log         -c    gen_context(system_u:object_r:shared_log_device_t,s0)
/dev/socket(/.*)?           gen_context(system_u:object_r:socket_device_t,s0)
/dev/smd([0-44])+     -c    gen_context(system_u:object_r:smd_device_t,s0)
/dev/diag             -c    gen_context(system_u:object_r:diag_device_t,s0)
#/dev/log              -s     gen_context(system_u:object_r:logd_socket_t,s0)
/dev/ubi.*             -c    gen_context(system_u:object_r:ubi_device_t,mls_systemhigh)
/dev/iio:device([0-9])+     -c   gen_context(system_u:object_r:iio_device,s0)
/dev/ion               -c  gen_context(system_u:object_r:ion_device_t,s0)
/dev/smcinvoke          -c  gen_context(system_u:object_r:smcinvoke_device_t,s0)
/dev/qti-smmu-proxy     -c  gen_context(system_u:object_r:smmu_proxy_device_t,s0)
/dev/qseecom            -c  gen_context(system_u:object_r:qseecom_device_t,s0)
/dev/mtd[0-9]+          -c   gen_context(system_u:object_r:mtd_device_t,s0)
/dev/adsprpc-smd            -c  gen_context(system_u:object_r:qdsp_device_t,s0)
/dev/adsprpc-smd-secure            -c  gen_context(system_u:object_r:xdsp_device_t,s0)

### DMA HEAPS ###
/dev/dma_heap/qcom,tui    -c   gen_context(system_u:object_r:vendor_dmabuf_tui_heap_device_t,s0)
/dev/dma_heap/qcom,system -c   gen_context(system_u:object_r:vendor_dmabuf_system_heap_device_t,s0)
/dev/dma_heap/system -c   gen_context(system_u:object_r:system_dmabuf_device_t,s0)
/dev/dma_heap/qcom,system-uncached -c   gen_context(system_u:object_r:system_uncached_dmabuf_device_t,s0)
/dev/dma_heap/qcom,qseecom -c  gen_context(system_u:object_r:vendor_dmabuf_qseecom_heap_device_t,s0)
/dev/dma_heap/qcom,ms1     -c   gen_context(system_u:object_r:vendor_dmabuf_ms1_heap_device_t,s0)
/dev/dma_heap/qcom,ms2     -c   gen_context(system_u:object_r:vendor_dmabuf_ms2_heap_device_t,s0)
/dev/dma_heap/qcom,ms3     -c   gen_context(system_u:object_r:vendor_dmabuf_ms3_heap_device_t,s0)

### MEM_BUF_VM devices ###
/dev/mem_buf_vm/qcom,trusted_vm -c gen_context(system_u:object_r:vendor_vm_trusted_device_t,s0)
/dev/mem_buf_vm/qcom,hlos       -c gen_context(system_u:object_r:vendor_vm_hlos_device_t,s0)
/dev/mem_buf_vm/qcom,oemvm      -c gen_context(system_u:object_r:vendor_vm_oem_device_t,s0)
/dev/mem_buf_vm/qcom,self       -c gen_context(system_u:object_r:vendor_vm_self_device_t,s0)
/dev/mem_buf_vm/qcom,cp_pixel   -c gen_context(system_u:object_r:vendor_vm_cp_pixel_device_t,s0)
/dev/qti_virtio_mem       -c gen_context(system_u:object_r:vendor_virtio_mem_device_t,s0)

### Touch script ###
/usr/sbin/initscripts/start_touch_le -- gen_context(system_u:object_r:touch_script_exec_t,s0)
