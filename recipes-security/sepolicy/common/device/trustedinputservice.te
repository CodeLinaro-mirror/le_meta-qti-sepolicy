policy_module(trustedinputservice, 1.0)

########################################
#
# Declarations
#

type trustedinputservice_t;
type trustedinputservice_exec_t;

init_vendor_domain(trustedinputservice_t, trustedinputservice_exec_t)

gen_require(`
type socket_device_t;
type sysfs_t;
type touch_input_device_t;
type systemd_tmpfiles_t;
')

corecmd_exec_shell(trustedinputservice_t)
connect_to_tui_coresvc(trustedinputservice_t)
allow trustedinputservice_t socket_device_t:dir search;
dev_read_input(trustedinputservice_t)
allow trustedinputservice_t touch_input_device_t:file { read write open };
allow trustedinputservice_t sysfs_t:dir read;
kernel_read_system_state(trustedinputservice_t)
allow trustedinputservice_t self:fifo_file rw_fifo_file_perms;
allow trustedinputservice_t self:unix_stream_socket create_stream_socket_perms;
dontaudit systemd_tmpfiles_t touch_input_device_t:file { getattr setattr relabelfrom };
