policy_module(chg-policy, 1.0)

########################################
#
# Declarations
#

type chg-policy_t;
type chg-policy_exec_t;
init_vendor_domain(chg-policy_t, chg-policy_exec_t)

type chg-policy-persist_data_t;
user_data_files_type(chg-policy-persist_data_t)

type qg_device_t;
dev_node(qg_device_t);

#============= chg-policy_t ==============
ifndef(`init_systemd', `
    allow chg-policy_t self:process setcap;
    allow chg-policy_t self:capability setpcap;
')
allow chg-policy_t self:capability net_admin;
allow chg-policy_t self:capability2 wake_alarm;
allow chg-policy_t self:capability2 block_suspend;
allow chg-policy_t self:{ socket netlink_kobject_uevent_socket } create_socket_perms;
allow chg-policy_t self:fifo_file rw_fifo_file_perms;
allow chg-policy_t qg_device_t:chr_file rw_chr_file_perms;
dontaudit chg-policy_t self:process setcap;

userdebug_or_eng(`
   mls_file_write_all_levels(chg-policy_t)
   dev_write_kmsg(chg-policy_t)
')

dev_rw_sysfs(chg-policy_t)
leprop_rw_props(chg-policy_t)
device_search_sockets(chg-policy_t)
data_filetrans(chg-policy_t, chg-policy-persist_data_t, file)
manage_user_data_files(chg-policy_t, chg-policy-persist_data_t)

#============= chg-policy_initrc_t ==============
ifndef(`init_systemd', `
    type chg-policy-initrc_t;
    type chg-policy-initrc_exec_t;

    init_script_domain(chg-policy-initrc_t, chg-policy-initrc_exec_t)
    domtrans_pattern(chg-policy-initrc_t, chg-policy_exec_t, chg-policy_t)
    data_filetrans(chg-policy-initrc_t, chg-policy-persist_data_t, file)
    manage_user_data_files(chg-policy-initrc_t, chg-policy-persist_data_t)
    dev_rw_sysfs(chg-policy-initrc_t)
    unconfined_domain(chg-policy-initrc_t)
')
