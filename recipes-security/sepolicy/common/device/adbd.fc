/usr/sbin/adbd          --      gen_context(system_u:object_r:adbd_exec_t,s0)
/usr/sbin/launch_adbd   --      gen_context(system_u:object_r:adbd_initrc_exec_t,s0)

/etc/rc\.d/init\.d/usb  --      gen_context(system_u:object_r:adbd_initrc_exec_t,s0)
/etc/initscripts/usb    --      gen_context(system_u:object_r:adbd_initrc_exec_t,s0)

/etc/adb_devid            --    gen_context(system_u:object_r:adbd_system_data_t,s0)
/etc/usb/boot_hsusb_comp  --    gen_context(system_u:object_r:adbd_system_data_t,s0)
/etc/usb/boot_hsic_comp   --    gen_context(system_u:object_r:adbd_system_data_t,s0)
/systemrw/adb_devid       --    gen_context(system_u:object_r:adbd_system_data_t,s0)
/systemrw/boot_hsusb_comp --    gen_context(system_u:object_r:adbd_system_data_t,s0)
/systemrw/boot_hsic_comp  --    gen_context(system_u:object_r:adbd_system_data_t,s0)

/etc/start_pcie           --    gen_context(system_u:object_r:pcie_initrc_exec_t,s0)
/data/adb.conf            --    gen_context(system_u:object_r:adb_data_conf_t,s0)
/data/debug_transport.conf--    gen_context(system_u:object_r:adb_data_conf_t,s0)

/usr/sbin/start_usb       --    gen_context(system_u:object_r:usb_exec_t,s0)
/usr/sbin/usb_composition --    gen_context(system_u:object_r:usb_exec_t,s0)
/usr/sbin/usb(/.*)?       --    gen_context(system_u:object_r:usb_exec_t,s0)
