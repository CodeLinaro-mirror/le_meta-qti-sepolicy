policy_module(atfwd, 1.0)

type atfwd_t;
type atfwd_exec_t;
gen_require(`
       type default_t;
       type init_var_run_t;
       type systemd_logind_var_run_t;
       type system_dbusd_t;
       type system_dbusd_var_run_t;
       type socket_device_t;
       type devlog_t;
       type syslogd_t;
       type sysfs_t;
')

init_vendor_domain(atfwd_t, atfwd_exec_t)

corecmd_exec_bin(atfwd_t)
shutdown_domtrans(atfwd_t)
allow atfwd_t self:socket create_socket_perms;
allow atfwd_t self:fifo_file rw_fifo_file_perms;
dontaudit atfwd_t default_t:dir { search };
corecmd_exec_shell(atfwd_t)
kernel_read_system_state(atfwd_t)
allow atfwd_t init_var_run_t:dir { search getattr };
init_read_state(atfwd_t)
allow atfwd_t systemd_logind_var_run_t:sock_file write;
allow atfwd_t system_dbusd_t:unix_stream_socket connectto;
allow atfwd_t system_dbusd_var_run_t:dir search;
ifdef(`init_systemd', `
    init_dbus_chat(atfwd_t)
    systemd_dbus_chat_logind(atfwd_t)
    dbus_system_bus_client(atfwd_t)
')
allow atfwd_t self:dir { search write create };
allow atfwd_t self:sock_file { write create };
allow atfwd_t self:netlink_generic_socket { create bind write };
allow atfwd_t socket_device_t:dir { search write add_name remove_name };
allow atfwd_t devlog_t:sock_file write;
allow atfwd_t syslogd_t:unix_dgram_socket sendto;
allow atfwd_t socket_device_t:sock_file { create write unlink setattr};
allow atfwd_t sysfs_t:file { open read };#/sys/module/diagchar/parameters/timestamp_switch
allow atfwd_t self:capability net_admin;
userdebug_or_eng(`
    gen_require(`
          type diag_device_t;
    ')
    allow atfwd_t diag_device_t:chr_file { open read write ioctl };
')
