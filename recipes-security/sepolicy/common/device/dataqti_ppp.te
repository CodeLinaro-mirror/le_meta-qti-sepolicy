policy_module(dataqti_ppp, 1.0)

type dataqti_ppp_t;
type dataqti_ppp_exec_t;
type dataqti_ppp_device_t;

init_daemon_domain(dataqti_ppp_t, dataqti_ppp_exec_t)
logging_send_syslog_msg(dataqti_ppp_t)
dev_node(dataqti_ppp_device_t)

userdebug_or_eng(`
    rw_diag_dev(dataqti_ppp_t)
')

gen_require(`
    type qcmap_etc_data_t;
    type sysfs_t;
    type default_t;
')

dontaudit dataqti_ppp_t default_t:dir { search };

dev_write_kmsg(dataqti_ppp_t)

allow dataqti_ppp_t self:fifo_file { getattr read write };
corecmd_exec_shell(dataqti_ppp_t)
read_system_data_files(dataqti_ppp_t, qcmap_etc_data_t)
allow dataqti_ppp_t sysfs_t:file { read open };
allow dataqti_ppp_t self:socket { write read create ioctl };
allow dataqti_ppp_t self:netlink_route_socket { create bind write nlmsg_read read };
rw_chr_files_pattern(dataqti_ppp_t, dataqti_ppp_device_t, dataqti_ppp_device_t)
kernel_dontaudit_read_system_state(dataqti_ppp_t)

type dataqti_ppp_var_run_t;
files_pid_file(dataqti_ppp_var_run_t)
allow dataqti_ppp_t dataqti_ppp_var_run_t:sock_file manage_sock_file_perms;
manage_dirs_pattern(dataqti_ppp_t, dataqti_ppp_var_run_t, dataqti_ppp_var_run_t)
files_pid_filetrans(dataqti_ppp_t, dataqti_ppp_var_run_t, { sock_file dir })

