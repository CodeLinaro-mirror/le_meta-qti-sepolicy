policy_module(data, 1.0)

gen_require(`
    type mount_t;
    type init_t;
    type initrc_t;
    type setfiles_t;
    attribute mountpoint;
    attribute domain;
')

attribute user_data;
attribute domain_can_read_userdata;
attribute domain_can_write_userdata;

type data_t;
typeattribute data_t mountpoint;  # Can't use files_mountpoint here
user_data_files_type(data_t)

type sxr_data_t;
user_data_files_type(sxr_data_t);
allow initrc_t data_t:dir manage_dir_perms;
allow initrc_t sxr_data_t:dir manage_dir_perms;
allow initrc_t sxr_data_t:file manage_file_perms;
allow setfiles_t sxr_data_t:dir relabelto;

type qvr_data_t;
user_data_files_type(qvr_data_t);
allow initrc_t qvr_data_t:dir manage_dir_perms;
allow initrc_t qvr_data_t:file manage_file_perms;
allow setfiles_t qvr_data_t:dir relabelto;

type gst_data_t;
user_data_files_type(gst_data_t);
allow initrc_t gst_data_t:file manage_file_perms;
allow initrc_t gst_data_t:dir manage_dir_perms;

#To support coredump in userdebug variant
type coredump_data_t;
user_data_files_type(coredump_data_t)
userdebug_or_eng(`
    allow domain data_t:dir search_dir_perms;
    allow { domain -initrc_t } coredump_data_t:dir manage_dir_perms;
    allow { domain -initrc_t } coredump_data_t:file manage_file_perms;

    # qcvirtio-gpu-op has no dedicated domain and runs under initrc_t; it writes its
    # own core dump directly, so grant the exact perms observed instead of full manage_*.
    allow initrc_t coredump_data_t:dir { search write add_name };
    allow initrc_t coredump_data_t:file { create write open };
')

type sdcard_data_t;
user_data_files_type(sdcard_data_t)

# Disallow generic reads/writes to userdata from the regular files API
#Except coredump in userdebug variant
neverallow ~{
    domain_can_read_userdata
    domain_can_write_userdata
    mount_t
    init_t
} { user_data -coredump_data_t -sxr_data_t -qvr_data_t -gst_data_t }:file read_file_perms;
neverallow ~{
    domain_can_write_userdata
    mount_t
    init_t
} { user_data -coredump_data_t -sxr_data_t -qvr_data_t -gst_data_t }:file { create setattr write append rename link unlink };

attribute system_data;
attribute domain_can_read_systemdata;
attribute domain_can_write_systemdata;

type system_data_t;
typeattribute system_data_t mountpoint;  # Can't use files_mountpoint here
system_data_files_type(system_data_t)

# Disallow generic reads/writes to writable system data from the regular files API
neverallow ~{
    domain_can_read_systemdata
    domain_can_write_systemdata
    mount_t
    init_t
} system_data:file read_file_perms;
neverallow ~{
    domain_can_write_systemdata
    mount_t
    init_t
} system_data:file { create setattr write append rename link unlink };

# Disallow execution from any writable partition (except from unconfined context)
#  The unconfined_domain attribute includes the default initrc_t context so use
#  the more specific unconfined_t context instead.
gen_require(`
     type unconfined_t;
')
neverallow { domain -unconfined_t } { user_data system_data }:file { execute execute_no_trans };
userdebug_or_eng(`
    allow unconfined_t { user_data system_data }:file { execute execute_no_trans };
')
