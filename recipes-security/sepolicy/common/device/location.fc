/usr/bin/loc_launcher      -- gen_context(system_u:object_r:loc_exec_t,s0)
/usr/bin/xtwifi-inet-agent -- gen_context(system_u:object_r:xtwifi_agent_exec_t,s0)
/usr/bin/xtwifi-client     -- gen_context(system_u:object_r:xtwifi_client_exec_t,s0)
/usr/bin/location_hal_daemon -- gen_context(system_u:object_r:loc_hald_exec_t,s0)
/usr/bin/xtra-daemon       -- gen_context(system_u:object_r:xtra_daemon_exec_t,s0)
/usr/bin/edgnss-daemon       -- gen_context(system_u:object_r:edgnss_daemon_exec_t,s0)
/usr/bin/lowi-server       -- gen_context(system_u:object_r:lowi_server_exec_t,s0)
/usr/bin/engine-service    -- gen_context(system_u:object_r:engine_service_exec_t,s0)
/usr/bin/slim_daemon       -- gen_context(system_u:object_r:slim_daemon_exec_t,s0)

## location startup script for systemd systems
ifdef(`init_systemd', `
    /usr/bin/location_hald_preinit_handler.sh -- gen_context(system_u:object_r:loc_initrc_exec_t,s0)
')

## location startup script for sysvinit systems
ifndef(`init_systemd', `
    /etc/rc\.d/init\.d/start_loc_launcher           --  gen_context(system_u:object_r:loc_initrc_exec_t,s0)
    /etc/rc\.d/init\.d/location_hal_initializer     --  gen_context(system_u:object_r:loc_initrc_exec_t,s0)
')

## location data files
/data/vendor/location(/.*)?             gen_context(system_u:object_r:loc_data_t,s0)
/data/vendor/location-partner(/.*)?     gen_context(system_u:object_r:loc_data_t,s0)

## socket files
/dev/socket/location(/.*)?          gen_context(system_u:object_r:loc_socket_t,s0)
/dev/socket/loc_client/hal_daemon   gen_context(system_u:object_r:loc_socket_t,s0)

#location tmp files
/var/tmp/location(/.*)?             gen_context(system_u:object_r:loc_tmp_t,s0)

## location conf files
/etc/gps.conf       -- gen_context(system_u:object_r:loc_etc_t,s0)
/etc/izat.conf      -- gen_context(system_u:object_r:loc_etc_t,s0)
/etc/xtwifi.conf    -- gen_context(system_u:object_r:loc_etc_t,s0)
/etc/flp.conf       -- gen_context(system_u:object_r:loc_etc_t,s0)
/etc/lowi.conf      -- gen_context(system_u:object_r:loc_etc_t,s0)
