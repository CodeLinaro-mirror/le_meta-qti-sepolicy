policy_module(rules_manager, 1.0)

########################################
#
# Declarations
#

type rules_manager_t;
type rules_manager_exec_t;
type rules_manager_data_t;
type rules_manager_tmp_t;

# Manage private files inside /data
user_data_files_type(rules_manager_data_t)
manage_user_data_files(rules_manager_t, rules_manager_data_t)
data_filetrans(rules_manager_t, rules_manager_data_t, { file dir })

init_vendor_domain(rules_manager_t, rules_manager_exec_t)

#============= rules_manager_t ==============
kernel_read_system_state(rules_manager_t)

# Manage private files inside /tmp
#allow rules_manager_t tmp_t:dir { write add_name };
#allow rules_manager_t tmp_t:file { read write create open };
#allow rules_manager_t tmp_t:lnk_file read;
files_tmp_filetrans(rules_manager_t, rules_manager_tmp_t, { file dir })

#allow rules_manager_t var_t:dir { write add_name };
#allow rules_manager_t var_t:file { read write create open };
files_var_filetrans(rules_manager_t, rules_manager_tmp_t, { file dir })

dev_read_urand(rules_manager_t)

## for DBus
ifdef(`init_systemd', `
    init_dbus_chat(rules_manager_t)
    dbus_system_domain(rules_manager_t, rules_manager_exec_t)
    unconfined_dbus_chat(rules_manager_t);
    adk_connectivity_manager_dbus_chat(rules_manager_t);
    adk_audio_manager_dbus_chat(rules_manager_t)
    allow rules_manager_t initrc_t:dbus send_msg;
    adk_dbus_send_led_manager(rules_manager_t);
    allow rules_manager_t self:dbus send_msg;
    adk_voice_ui_dbus_chat(rules_manager_t);
')
