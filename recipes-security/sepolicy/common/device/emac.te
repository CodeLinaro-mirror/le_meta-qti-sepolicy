policy_module(emac, 1.0)

type emac_t;
type emac_exec_t;
init_vendor_domain(emac_t, emac_exec_t)

type emac_start_t;
type emac_start_exec_t;
init_script_domain(emac_start_t, emac_start_exec_t)

type emac_dev_t;
dev_node(emac_dev_t)

type emac_etc_t;
files_type(emac_etc_t);

gen_require(`
     type sysdevice_sysfs_t;
')

# *** Type enforcements for emac.sh ***
dev_write_kmsg(emac_t)    #emac.sh allow to write to kmsg
iptables_domtrans(emac_t) #emac.sh allowed into iptables domain
sysnet_domtrans_ifconfig(emac_t) #emac.sh allowed into ifconfig domain
files_read_etc_files(emac_t)     #emac.sh can read files under /etc/
kernel_read_system_state(emac_t) #emac.sh can read files under /proc/
dev_read_sysfs(emac_t)           #emac.sh can read files under /sys/
dev_read_sysfs(emac_start_t)     #adapt can read files under /sys/

allow emac_t emac_etc_t:file { read open getattr };
allow emac_t self:capability net_admin;
allow emac_t self:tcp_socket { bind create ioctl getattr listen write read};
allow emac_t self:fifo_file { write read getattr };
allow emac_t emac_dev_t:chr_file {open read write};

allow emac_start_t sysdevice_sysfs_t:file { read open getattr };
allow emac_t sysdevice_sysfs_t:file { read open getattr };

# *** Type enforcement for start_eth-adapt ***
userdebug_or_eng(`
     dev_write_kmsg(emac_start_t)
     mls_file_write_all_levels(emac_start_t)
 ')

kernel_read_system_state(emac_start_t)
dev_read_sysfs(emac_start_t)
modutils_domtrans(emac_start_t) #Allow emac_start_t to insert kmods.

allow emac_start_t emac_etc_t:file read_file_perms;
allow emac_start_t self:fifo_file {read write getattr};
