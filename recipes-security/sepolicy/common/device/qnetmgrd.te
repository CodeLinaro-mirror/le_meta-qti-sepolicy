policy_module(qnetmgrd, 1.0)

type qnetmgrd_t;
type qnetmgrd_exec_t;
type lptd_connect_socket_t;

init_vendor_domain(qnetmgrd_t, qnetmgrd_exec_t)
logging_send_syslog_msg(qnetmgrd_t)

userdebug_or_eng(`
    rw_diag_dev(qnetmgrd_t)
')
gen_require(`
      type default_t;
      type socket_device_t;
')

allow qnetmgrd_t self:capability { net_admin net_raw chown fsetid setpcap setgid setuid };
allow qnetmgrd_t self:process { setcap getcap signal };
dontaudit qnetmgrd_t default_t:dir { search };
allow qnetmgrd_t self:{
    socket
    udp_socket
    netlink_socket
    netlink_route_socket
} create_socket_perms;
allow qnetmgrd_t self:fifo_file rw_fifo_file_perms;
allow qnetmgrd_t self:netlink_route_socket { setopt write getattr read bind create nlmsg_read nlmsg_write };
allow qnetmgrd_t self:qipcrtr_socket { create getattr write read setopt };
allow qnetmgrd_t self:unix_stream_socket { connectto sendto listen accept };
allow iptables_t qnetmgrd_t:unix_stream_socket { read write };

dev_read_sysfs(qnetmgrd_t)
files_rw_qcmap_etc_data_files(qnetmgrd_t)
vendor_kernel_load_exempt(qnetmgrd_t)  # TODO: Request init to load the module
kernel_load_module(qnetmgrd_t)
kernel_rw_net_sysctls(qnetmgrd_t)
kernel_read_vm_overcommit_sysctl(qnetmgrd_t)
sysnet_domtrans_ifconfig(qnetmgrd_t)

# Don't implicitly load kernel modules
kernel_dontaudit_request_load_module(qnetmgrd_t)

type qnetmgrd_data_t;
user_data_files_type(qnetmgrd_data_t)
data_filetrans(qnetmgrd_t, qnetmgrd_data_t, { dir sock_file })
manage_user_data_files(qnetmgrd_t, qnetmgrd_data_t)
allow qnetmgrd_t self:tcp_socket { create ioctl };
kernel_read_system_state(qnetmgrd_t)
kernel_read_network_state(qnetmgrd_t)

type netmgrd_socket_device_t;
files_type(netmgrd_socket_device_t);
dev_node(netmgrd_socket_device_t);
allow qnetmgrd_t netmgrd_socket_device_t:dir { search write create read add_name };
allow qnetmgrd_t netmgrd_socket_device_t:sock_file { create setattr unlink};
filetrans_pattern( qnetmgrd_t, socket_device_t, netmgrd_socket_device_t, { sock_file dir })

gen_require(`
    type default_t;
    type initrc_var_run_t;
    type iptables_t;
    type system_dir_t;

')
dontaudit qnetmgrd_t default_t:dir { search };
dontaudit qnetmgrd_t iptables_t : process { sigkill };
dontaudit qnetmgrd_t self:capability { kill };
dontaudit qnetmgrd_t self : process { sigkill };
dontaudit qnetmgrd_t system_dir_t:dir { search };

iptables_domtrans(qnetmgrd_t)
allow qnetmgrd_t lptd_connect_socket_t:sock_file  write;
filetrans_pattern( qnetmgrd_t, initrc_var_run_t, lptd_connect_socket_t, sock_file )
allow qnetmgrd_t lptd_connect_socket_t:unix_stream_socket connectto;
filetrans_pattern( qnetmgrd_t, initrc_t, lptd_connect_socket_t, unix_stream_socket)
