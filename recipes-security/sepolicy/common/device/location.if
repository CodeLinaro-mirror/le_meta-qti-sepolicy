## <summary>location daemon</summary>

########################################
## <summary>
##       Read location data  files
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed access.
##      </summary>
## </param>
## <param name="type">
##      <summary>
##      File type allowed to read
##      </summary>
## </param>
#
interface(`location_read_loc_data_files',`
    gen_require(`
        attribute user_data;
        type loc_data_t;
        attribute domain_can_read_userdata;
    ')
    typeattribute $1 domain_can_read_userdata;
    read_files_pattern($1, user_data, loc_data_t)
    read_lnk_files_pattern($1, user_data, loc_data_t)
')

########################################
## <summary>
##    Read location conf files in /etc.
## </summary>
## <desc>
##    <p>
##    Allow the specified domain to read location conf
##    files in /etc. These files are location framework
##    related system configuration files
##    </p>
## </desc>
## <param name="domain">
##    <summary>
##    Domain allowed access for location conf files.
##    </summary>
## </param>
#
interface(`files_read_loc_etc_files',`
    gen_require(`
        type etc_t, loc_etc_t;
    ')

    allow $1 etc_t:dir list_dir_perms;
    read_files_pattern($1, etc_t, loc_etc_t)
    read_lnk_files_pattern($1, etc_t, loc_etc_t)
')

########################################
## <summary>
##    Rules for accessing location boot kpi node.
## </summary>
## <desc>
##    <p>
##    Allow the specified domain to access location
##    boot kpi node. Required only for userdebug or
##    debug builds.
##    </p>
## </desc>
## <param name="domain">
##    <summary>
##    Rules for accessing location boot kpi node.
##    </summary>
## </param>
#
interface(`location_access_loc_bootkpi',`
    userdebug_or_eng(`
        gen_require(`
            type debugfs_t;
            type boot_kpi_values_t;
        ')
        allow $1 debugfs_t:dir search;
        allow $1 debugfs_t:file { write open getattr };
        allow $1 boot_kpi_values_t:file { write open getattr };
    ')
')

########################################
## <summary>
##    Generic rules for location clients.
## </summary>
## <desc>
##    <p>
##    Generic rules for location clients. Single
##    macro to include to all location client
##    related rules.
##    </p>
## </desc>
## <param name="domain">
##    <summary>
##    Generic rules for location clients.
##    </summary>
## </param>
#
interface(`location_client_generic_rules',`
    gen_require(`
        type loc_hald_t, loc_socket_t, loc_data_t;
    ')
    location_read_loc_data_files($1);
    files_read_loc_etc_files($1);
    location_access_loc_bootkpi($1);
    manage_sock_files_pattern($1, loc_socket_t, loc_socket_t)
    dgram_send_pattern($1, loc_socket_t, loc_socket_t, loc_hald_t)
    allow loc_hald_t $1:unix_dgram_socket sendto;
')
