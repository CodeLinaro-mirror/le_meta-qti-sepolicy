policy_module(dataadpl, 1.0)

type dataadpl_t;
type dataadpl_exec_t;
type dataadpl_device_t;
type dataadpl_odl_device_t;

init_vendor_domain(dataadpl_t, dataadpl_exec_t)
dev_node(dataadpl_device_t)

userdebug_or_eng(`
    rw_diag_dev(dataadpl_t)
')

gen_require(`
    type system_data_t;
    type qcmap_etc_data_t;
    type default_t;
    type event_device_t;
    type socket_device_t;
    type dataqti_device_t;
')

logging_send_syslog_msg(dataadpl_t);
dev_read_sysfs(dataadpl_t)
allow dataadpl_t self:unix_dgram_socket { create connect write sendto };
allow dataadpl_t self:socket create_socket_perms;
rw_chr_files_pattern(dataadpl_t, device_t, dataadpl_device_t)
allow dataadpl_t self:fifo_file { write read getattr };
corecmd_exec_shell(dataadpl_t)
dev_write_kmsg(dataadpl_t)

allow dataadpl_t system_data_t:dir { read watch };
data_rw_system_data_files(dataadpl_t, qcmap_etc_data_t)
kernel_read_system_state(dataadpl_t)

dontaudit dataadpl_t default_t:dir { search };
allow dataadpl_t self:sock_file rw_sock_file_perms;

allow dataadpl_t event_device_t:chr_file { read write };
allow dataadpl_t socket_device_t:dir { search };

allow dataadpl_t self:qipcrtr_socket { setopt create getattr write read };
dev_node(dataadpl_odl_device_t)

# Manage private files inside /var/run
type dataadpl_var_run_t;
files_runtime_file(dataadpl_var_run_t)
allow dataadpl_t dataadpl_var_run_t:sock_file { create write };
qcmap_manage_var_run_data_files(dataadpl_t)
files_runtime_filetrans(dataadpl_t, dataadpl_var_run_t, { file sock_file dir })

# Manage socket files inside /dev/socket
type dataadpl_socket_device_t;
files_type(dataadpl_socket_device_t)
dev_node(dataadpl_socket_device_t)
device_manage_socket_file(dataadpl_t, dataadpl_socket_device_t)

#dont audit setuid and setgid
dontaudit dataadpl_t self: capability {setuid setgid};

rw_chr_files_pattern(dataadpl_t, device_t, dataqti_device_t)
rw_chr_files_pattern(dataadpl_t, device_t, dataadpl_odl_device_t)
userdebug_or_eng(`
        dev_write_kmsg(dataadpl_t)
        mls_file_write_all_levels(dataadpl_t);
')
