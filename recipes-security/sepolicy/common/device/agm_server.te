policy_module(agm_server, 1.0)

type agm_server_t;
type agm_server_exec_t;
gen_require(`
    type default_t;
    type sound_device_t;
    type socket_device_t;
    type audio_hal_etc_t;
    type audio_hal_etc_acdb_t;
    type debugfs_t;
    type audio_device_t;
    type ion_device_t;
    type proc_t;
    type hal_play_test_t;
    type debugfs_t;
    type csd_device_t;
    type aud_dev_sysfs_t;
    type csd_sysfs_t;
        ifdef(`init_systemd', `
            class dbus send_msg;
        ')

')
init_vendor_domain(agm_server_t, agm_server_exec_t)

#dev_node(agm_device_t)
userdebug_or_eng(`
    rw_diag_dev(agm_server_t)
    allow agm_server_t debugfs_t:dir search_dir_perms;
    allow agm_server_t debugfs_t:dir read_file_perms;
')
allow agm_server_t self:socket create_socket_perms;
logging_send_syslog_msg(agm_server_t)
allow agm_server_t self:capability { kill net_bind_service };
dontaudit agm_server_t { socket_device_t default_t }:dir search_dir_perms;
allow agm_server_t self:fifo_file rw_fifo_file_perms;
allow agm_server_t sound_device_t:chr_file rw_chr_file_perms;
dev_read_sysfs(agm_server_t)
allow agm_server_t audio_hal_etc_t:file read_file_perms;
allow agm_server_t audio_hal_etc_acdb_t:dir list_dir_perms;
allow agm_server_t audio_hal_etc_acdb_t:file read_file_perms;
allow agm_server_t audio_device_t:chr_file rw_chr_file_perms;
allow agm_server_t ion_device_t:chr_file read_chr_file_perms;
allow agm_server_t self:{ socket qipcrtr_socket } create_socket_perms;
allow agm_server_t self:process signal;
allow agm_server_t self:qipcrtr_socket create_socket_perms;
allow agm_server_t sound_device_t:chr_file map;
allow agm_server_t aud_dev_sysfs_t:file write_file_perms;
allow agm_server_t csd_device_t:chr_file rw_chr_file_perms;
kernel_read_system_state(agm_server_t)
dontaudit hal_play_test_t socket_device_t:dir search_dir_perms;
dontaudit agm_server_t self:capability { dac_read_search dac_override };

## for DBus
ifdef(`init_systemd', `
    init_dbus_chat(agm_server_t)
    dbus_system_domain(agm_server_t, agm_server_exec_t)
    unconfined_dbus_chat(agm_server_t);
    allow agm_server_t initrc_t:dbus send_msg;
    init_dbus_send_script(agm_server_t)

    allow agm_server_t self:dbus send_msg;
')

