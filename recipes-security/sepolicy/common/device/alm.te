policy_module(alm, 1.0)

########################################
#
# Declarations
#

type alm_service_t;
type alm_service_exec_t;
type alm_service_device_t;

init_vendor_domain(alm_service_t, alm_service_exec_t)

gen_require(`
        type leprop_sock_t;
        type firmware_t;
        type leprop_t;
        type devlog_t;
        type syslogd_t;
        type device_t;
        type ion_device_t;
        type smcinvoke_device_t;
        type qseecom_device_t;
        type init_var_run_t;
')

# self
allow alm_service_t self:unix_dgram_socket { create connect write };

files_type(alm_service_device_t)
dev_node(alm_service_device_t)
device_manage_socket_file(alm_service_t, alm_service_device_t, "almservice")
allow alm_service_t alm_service_device_t:dir { search write add_name };
allow alm_service_t alm_service_device_t:sock_file { create write setattr };

rw_chr_files_pattern(alm_service_t, device_t, ion_device_t);
rw_chr_files_pattern(alm_service_t, device_t, smcinvoke_device_t);
rw_chr_files_pattern(alm_service_t, device_t, qseecom_device_t);

allow alm_service_t firmware_t:dir search;
allow alm_service_t firmware_t:file { read getattr open };

allow alm_service_t leprop_sock_t:sock_file write;
allow alm_service_t leprop_t:unix_stream_socket connectto;

allow alm_service_t devlog_t:sock_file write;
allow alm_service_t syslogd_t:unix_dgram_socket sendto;

allow alm_service_t init_var_run_t:dir search;
