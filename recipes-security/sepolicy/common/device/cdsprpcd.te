policy_module(cdsprpcd , 1.0)

########################################
#
# Declarations
#

type cdsprpcd_t;
type cdsprpcd_exec_t;
files_type(cdsprpcd_exec_t);

init_daemon_domain(cdsprpcd_t, cdsprpcd_exec_t)
gen_require(`
    type ion_device_t;
    type qdsp_device_t;
    type xdsp_device_t;
    type system_dmabuf_device_t;
    type device_t;
')

allow cdsprpcd_t self:unix_dgram_socket { read write create bind listen ioctl connect };
userdebug_or_eng(`
        gen_require(`
             type debugfs_t;
        ')
        allow cdsprpcd_t debugfs_t:dir search_dir_perms;
')

files_search_mnt(cdsprpcd_t)
files_search_default(cdsprpcd_t)
device_search_sockets(cdsprpcd_t)

adsprpcd_files_access(cdsprpcd_t);

#allow cdsprpcd_t to acces /dev/ion
rw_chr_files_pattern(cdsprpcd_t, device_t, ion_device_t);
#allow cdsprpcd_t to acces /dev/adsprpcd-smd
rw_chr_files_pattern(cdsprpcd_t, device_t, qdsp_device_t);
#allow cdsprpcd_t to acces /dev/adsprpcd-smd-secure
rw_chr_files_pattern(cdsprpcd_t, device_t, xdsp_device_t);

#allow cdsprpcd_t to access /dev/dma_heap/system
allow cdsprpcd_t system_dmabuf_device_t:chr_file read_chr_file_perms;
