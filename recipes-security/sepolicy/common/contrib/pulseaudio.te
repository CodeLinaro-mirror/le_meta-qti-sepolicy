#policy_module(pulseaudio, 1.0)

########################################
#
# Declarations
#

files_mountpoint(pulseaudio_var_lib_t)

files_type(pulseaudio_tmp_t);

init_daemon_domain(pulseaudio_t, pulseaudio_exec_t);

gen_require(`
	type debugfs_t;
	type systemd_logind_var_run_t;
')

allow pulseaudio_t self:capability { chown fowner fsetid setgid setuid sys_nice sys_resource sys_tty_config };
allow pulseaudio_t self:process { getcap getsched setcap setrlimit setsched signal signull };

allow pulseaudio_t self:fifo_file rw_fifo_file_perms;
allow pulseaudio_t self:unix_stream_socket { accept connectto listen };
allow pulseaudio_t self:unix_dgram_socket sendto;
allow pulseaudio_t self:tcp_socket { accept listen };
allow pulseaudio_t self:netlink_kobject_uevent_socket create_socket_perms;

audio_hal_access(pulseaudio_t)

non_audio_hal_access(pulseaudio_t)

allow pulseaudio_t systemd_logind_var_run_t:sock_file write; # /run/dbus/system_bus_socket

# For almservice
alm_write_sock_file(pulseaudio_t)

###########################
# Files / Dirs

files_type(pulseaudio_var_lib_t)
files_manage_etc_dirs(pulseaudio_t);
files_manage_urandom_seed(pulseaudio_t);
files_read_var_lib_symlinks(pulseaudio_t);
files_search_var_lib(pulseaudio_t);
files_getattr_var_lib_dirs(pulseaudio_t);

allow pulseaudio_t debugfs_t:dir search;
allow pulseaudio_t init_var_run_t:file { read open write getattr};
allow pulseaudio_t init_var_run_t:sock_file { open read write getattr };

leprop_rw_props(pulseaudio_t);

corecmd_exec_shell(pulseaudio_t)

allow pulseaudio_t self:process { signal getsched };

## for DBus
ifdef(`init_systemd', `
    init_dbus_chat(pulseaudio_t)
')
