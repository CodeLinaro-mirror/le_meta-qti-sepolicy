userdebug_or_eng(`
    optional_policy(`
        gen_require(`
            attribute user_data;
            attribute system_data;
        ')
        manage_user_data_files(unconfined_t, user_data)
        manage_system_data_files(unconfined_t, system_data)
    ')

    dev_write_kmsg(unconfined_t)
    mls_file_write_all_levels(unconfined_t)
    mls_file_read_all_levels(unconfined_t)

# todo: cleanup comented line. The line is giving error #"Conflicting type rules
# (scontext=unconfined_t tcontext=wlan_initrc_exec_t tclass=process result=initrc_t), existing=wlan_initrc_t
# Expanded from type rule (scontext=unconfined_t tcontext=init_script_file_type tclass=process result=initrc_t)"
#    wlan_start_stop(unconfined_t)

    # Audio test app
    optional_policy(`
        gen_require(`
            type alogd_t;
        ')
        servicemanager_binder_use(unconfined_t)
        audio_binder_call_transfer(unconfined_t)
        allow unconfined_t self:capability2 block_suspend;
        allow unconfined_t alogd_t:dir search;
        shutdown_domtrans(unconfined_t)
    ')

    allow domain unconfined_t:unix_dgram_socket sendto;
    allow unconfined_t self:process execmem;

    ifdef(`init_systemd', `
        gen_require(`
            type init_t;
            type systemd_unit_t;
            type etc_t;
            type power_unit_t;
            class service { start status stop enable disable reload };
        ')

        # Allow unconfined type full access to systemctl commands
        allow unconfined_domain_type {
            init_t
            systemd_unit_t
            power_unit_t
            etc_t
        }:{ system service } { start stop status enable disable reload };
        allow unconfined_domain_type init_t:system { reboot halt };
    ')

    # Ping from shell
    optional_policy(`
        gen_require(`
            type node_t;
        ')
        allow unconfined_t node_t:icmp_socket node_bind;
    ')
    # Run iperf from shell
    optional_policy(`
        gen_require(`
            type data_t;
        ')
        allow unconfined_t data_t:file map;
    ')

    #Cat gpu soc from shell
    optional_policy(`
        gen_require(`
            type soc0_gpu_sysfs_t;
        ')
        allow unconfined_t soc0_gpu_sysfs_t:file read_file_perms;
    ')

    #Run df -h
    optional_policy(`
        gen_require(`
            type usb_dev_t;
        ')
        allow unconfined_t usb_dev_t:dir search;
    ')
    gen_require(`
        type sysdevice_sysfs_t;
        type sysfs_vblank_t;
    ')
    allow unconfined_t sysdevice_sysfs_t:file { getattr open read };
    allow unconfined_t sysfs_vblank_t:file read_file_perms;
    gen_require(`
      type brightness_t;
      type power_control_t;
      type encryption_control_t;
    ')
    allow unconfined_t brightness_t:file read_file_perms;
    allow unconfined_t power_control_t:file read_file_perms;
    allow unconfined_t encryption_control_t:file { rw_file_perms };

    #Run wifi commands
    optional_policy(`
        gen_require(`
            type wlan_hsp_sysfs_t;
        ')
        allow unconfined_t wlan_hsp_sysfs_t:dir { getattr search_dir_perms rw_dir_perms };
        allow unconfined_t wlan_hsp_sysfs_t:file { rw_file_perms };
    ')
    optional_policy(`
        gen_require(`
            type gpumodel_t;
        ')
        allow unconfined_t gpumodel_t:file read_file_perms;
    ')
    #Collect kmsg
    gen_require(`
        type proc_kmsg_t;
    ')
    allow unconfined_t proc_kmsg_t:file read_file_perms;

    optional_policy(`
        gen_require(`
            type unconfined_t;
            type binderfs_t;
            type hwbinder_device_t;
            type vndbinder_device_t;
        ')

        allow unconfined_t binderfs_t:dir { getattr open read search };
        allow unconfined_t hwbinder_device_t:chr_file getattr;
        allow unconfined_t vndbinder_device_t:chr_file getattr;
    ')

    optional_policy(`
        gen_require(`
            type kerneltests_modules_data_t;
        ')
        allow unconfined_t self:lockdown { integrity };
        allow unconfined_t kerneltests_modules_data_t:dir { read_file_perms search };
        allow unconfined_t kerneltests_modules_data_t:file { read_file_perms };
    ')

    optional_policy(`
        gen_require(`
            type cpu_scaling_freq_t;
            type cpu_sysfs_t;
            type sysfs_cpu_present;
        ')

        allow unconfined_t cpu_scaling_freq_t:file manage_file_perms;
        allow unconfined_t cpu_sysfs_t:dir { rw_dir_perms search };
        allow unconfined_t cpu_sysfs_t:file manage_file_perms;
        allow unconfined_t sysfs_cpu_present:file read_file_perms;
    ')

    # For test app to access qesdk
    optional_policy(`
        qesdk_adk_access(unconfined_t)
    ')
    logging_send_syslog_msg(unconfined_t)
')

#### workaround for FOTA /usr/bin/recovery

userdebug_or_eng(`
optional_policy(`
    gen_require(`
        type qmmf_server_t;
    ')

    servicemanager_binder_call(unconfined_t, qmmf_server_t)

    gen_require(`
        type usb_dev_t;
        type auditd_etc_t;
        type data_t;
        type policy_config_t;
        type proc_kmsg_t;
        type rebootd_pipe_t;
        type webserver_t;
        type weston_runtime_t;
        type camera_data_t;
        type sysfs_cpu_capacity;
    ')

    mls_file_read_all_levels(unconfined_t)
    mls_file_write_all_levels(unconfined_t)
    storage_raw_read_fixed_disk(unconfined_t)
    storage_raw_write_fixed_disk(unconfined_t)
    dev_read_kmsg(unconfined_t)
    kernel_mounton_message_if(unconfined_t)
    allow unconfined_t self:binder { call transfer };
    allow unconfined_t self:lockdown { confidentiality integrity };
    allow unconfined_t auditd_etc_t:dir { getattr read search };
    allow unconfined_t auditd_etc_t:file getattr;
    allow unconfined_t data_t:chr_file getattr;
    # allow map the files in /data/misc/camera
    allow unconfined_t camera_data_t:file map;
    allow unconfined_t policy_config_t:dir { getattr read search };
    allow unconfined_t policy_config_t:file getattr;
    allow unconfined_t rebootd_pipe_t:fifo_file getattr;
    allow unconfined_t usb_dev_t:dir { getattr read search open };
    allow unconfined_t webserver_t:dir { read search open };
    allow unconfined_t webserver_t:file getattr;
    allow unconfined_t weston_runtime_t:sock_file { getattr setattr write };
    allow unconfined_t weston_runtime_t:file { getattr setattr };
    allow unconfined_t self:lockdown { confidentiality };

    allow unconfined_t sysfs_cpu_capacity:file read_file_perms;
    gen_require(`
        type recovery_exec_t;
        type aud_dev_sysfs_t;
        type snd_card_state_t;
        type rfsa_adsp_lib_t;
        type binderfs_t;
        type data_t;
        type overlay_t;
        type qmmf_server_t;
        type servicemanager_t;
        type tuicoreservice_dev_t;
        type pulseaudio_t;
    ')
    allow unconfined_t recovery_exec_t:file exec_file_perms;
    allow unconfined_t aud_dev_sysfs_t:file { write_file_perms };
    allow unconfined_t snd_card_state_t:file { rw_file_perms };
    allow unconfined_t rfsa_adsp_lib_t:dir { list_dir_perms watch };
    allow unconfined_t rfsa_adsp_lib_t:file read_file_perms;
    allow unconfined_t binderfs_t:filesystem getattr;
    allow unconfined_execmem_t binderfs_t:dir search;
    allow unconfined_execmem_t data_t:dir { add_name write };
    #allow unconfined_execmem_t data_t:file { create getattr open write };
    manage_user_data_files(unconfined_execmem_t, data_t)
    allow unconfined_execmem_t overlay_t:dir { add_name search write };
    allow unconfined_execmem_t qmmf_server_t:binder { call transfer };
    allow unconfined_execmem_t servicemanager_t:binder call;
    allow unconfined_t tuicoreservice_dev_t:chr_file read_chr_file_perms;
    allow unconfined_t pulseaudio_t:binder { call transfer };
')
')
