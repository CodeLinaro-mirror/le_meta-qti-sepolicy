ifdef(`init_systemd',`
    # This should respect systemd_tmpfiles_manage_all tunable, but
    #  typeattribute does not work in that context.
    gen_require(`
        attribute user_data;
    ')
    manage_user_data_files(systemd_tmpfiles_t, user_data)
    relabel_all_data_files(systemd_tmpfiles_t)

    # systemd-journal catalog functionality
    files_map_etc_files(systemd_tmpfiles_t)

    # Update sysfs file access permissions
    gen_require(`
        type sysfs_t;
    ')
    allow systemd_tmpfiles_t sysfs_t:{ lnk_file dir file } setattr;

    # Update boot_kpi_values_t(sysfs node) file access permissions
    gen_require(`
        type boot_kpi_values_t;
    ')
    allow systemd_tmpfiles_t boot_kpi_values_t:{ lnk_file dir file } { setattr getattr };
    dontaudit systemd_tmpfiles_t boot_kpi_values_t:file { relabelfrom };

    # Relabel /tmp partition
    gen_require(`
        type tmp_t;
    ')
    allow systemd_tmpfiles_t tmp_t:dir create;
    fs_relabelfrom_tmpfs_dirs(systemd_tmpfiles_t)

    # tmpfiles does initial setup on behalf of other daemons, so exempt
    #  this from mls range constraints.
    mls_file_relabel(systemd_tmpfiles_t)
    mls_file_read_all_levels(systemd_tmpfiles_t)
    mls_file_write_all_levels(systemd_tmpfiles_t)
    mls_file_upgrade(systemd_tmpfiles_t)
    mls_file_downgrade(systemd_tmpfiles_t)

    # Open and read /etc/machine-id. This is mounted as a ro tmpfs
    gen_require(`
        type init_var_run_t;
    ')
    allow systemd_tmpfiles_t init_var_run_t:file read_file_perms;

    # /var/lib/dbus/machine-id
    gen_require(`
        type system_dbusd_var_lib_t;
        type tmpfs_t;
        type user_tmpfs_t;
    ')
    allow systemd_tmpfiles_t system_dbusd_var_lib_t:dir { read write add_name };
    allow systemd_tmpfiles_t system_dbusd_var_lib_t:lnk_file create;
    systemd_tmpfilesd_managed(systemd_resolved_var_run_t)
    allow systemd_tmpfiles_t systemd_resolved_var_run_t:file { write getattr open };

    gen_require(`
        type persist_t;
    ')
    allow systemd_tmpfiles_t persist_t:dir { getattr search read write add_name };

    # /data/vendor/display is relabeled to weston_runtime_t by tmpfiles.d rules
    gen_require(`
        type weston_runtime_t;
    ')
    allow systemd_tmpfiles_t weston_runtime_t:dir { getattr relabelfrom relabelto setattr };

    dev_read_sysfs(systemd_tmpfiles_t);
')

gen_require(`
    type udev_t;
    type tftp_server_t;
    type kernel_t;
    type systemd_tmpfiles_t;
    type system_dbusd_var_lib_t;
    type systemd_sysctl_t;
    type configfs_t;
    type usr_t;
    type syslogd_t;
    type syslogd_var_run_t;
    type cpu_sysfs_t;
    type sysfs_devcoredump_t;
    type power_control_t;
    type encryption_control_t;
    type overlay_t;
    type multicast_querier_sysfs_t;
    type proc_psi_t;
    type tmpfs_t;
    type leprop_system_data_t;
    type wifi_system_data_t;
    type storage_disk_device_t;
    type drm_card_sysfs_t;
    type dosfs_t;
    type init_runtime_t;
')

mls_trusted_socket(kernel_t)
mls_trusted_socket(systemd_tmpfiles_t)

allow udev_t kernel_t:unix_dgram_socket sendto;
allow udev_t configfs_t:dir list_dir_perms;
allow udev_t configfs_t:file { getattr setattr };
allow udev_t cpu_sysfs_t:dir { search getattr };
allow udev_t cpu_sysfs_t:file { rw_file_perms };
allow udev_t sysfs_devcoredump_t:file { read_file_perms setattr };
allow udev_t sysfs_devcoredump_t:dir { read_file_perms setattr search };
allow udev_t power_control_t:file { read_file_perms getattr setattr };
allow udev_t encryption_control_t:file { read_file_perms getattr setattr };
allow tftp_server_t kernel_t:unix_dgram_socket sendto;
allow systemd_tmpfiles_t kernel_t:unix_dgram_socket sendto;
allow systemd_tmpfiles_t etc_t:file relabelfrom;
allow systemd_tmpfiles_t system_dbusd_var_lib_t:dir create_dir_perms;
allow systemd_tmpfiles_t usr_t:file read_file_perms;
allow systemd_sysctl_t kernel_t:unix_dgram_socket sendto;
allow syslogd_t kernel_t:netlink_audit_socket rw_socket_perms;
allow syslogd_t syslogd_var_run_t:sock_file unlink;
allow udev_t overlay_t:dir search;
allow udev_t multicast_querier_sysfs_t:file { setattr_file_perms getattr_file_perms };

# systemd_modules_load

type systemd_gpt_generator_t;

gen_require(`
 type syslogd_var_run_t;
 type kmsg_device_t;
 type sysctl_kernel_t;
 type modules_object_t;
 type sysctl_t;
 type proc_t;
 type init_t;
 type devlog_t;
 type syslogd_t;
 type etc_t;
 type var_run_t;
 type kernel_t;
 type debugfs_t;
')

allow systemd_logind_t syslogd_var_run_t:dir search_dir_perms;
mls_file_read_all_levels(systemd_gpt_generator_t)
mls_file_write_all_levels(systemd_gpt_generator_t)
allow systemd_gpt_generator_t sysctl_kernel_t:dir search;
allow systemd_gpt_generator_t sysctl_kernel_t:file { read getattr open ioctl };
allow systemd_gpt_generator_t sysctl_t:dir search;
storage_raw_read_fixed_disk(systemd_gpt_generator_t)
dev_write_kmsg(systemd_gpt_generator_t)
dev_write_kmsg(systemd_modules_load_t)

mls_file_write_all_levels(systemd_modules_load_t)
mls_key_write_to_clearance(systemd_modules_load_t)

modutils_read_module_deps(systemd_modules_load_t)
allow systemd_modules_load_t modules_object_t:dir search;
allow systemd_modules_load_t init_var_run_t:dir search;
allow systemd_modules_load_t proc_t:file read_file_perms;
allow systemd_modules_load_t kernel_t:key manage_key_perms;
allow systemd_modules_load_t kernel_t:process setsched;
allow systemd_modules_load_t sysctl_t:dir search;
allow systemd_modules_load_t init_t:dir search;
allow systemd_modules_load_t init_t:file read_file_perms;
allow systemd_modules_load_t sysctl_kernel_t:dir search;
allow systemd_modules_load_t sysctl_kernel_t:file read_file_perms;
allow systemd_modules_load_t syslogd_var_run_t:dir search_dir_perms;
allow systemd_modules_load_t devlog_t:sock_file write;
allow systemd_modules_load_t syslogd_t:unix_dgram_socket sendto;
allow systemd_modules_load_t etc_t:file read_file_perms;

allow systemd_modules_load_t self:capability sys_module;
allow systemd_modules_load_t var_run_t:dir { read_file_perms getattr search };
allow systemd_modules_load_t debugfs_t:dir search;
allow systemd_modules_load_t modules_object_t:system module_load;
allow systemd_modules_load_t sysfs_t:file { open read };
allow systemd_modules_load_t kernel_t:system module_request;
allow systemd_modules_load_t systemd_modules_load_exec_t:file { execute read };

#systemd_update_done

allow systemd_update_done_t etc_t:file { open read write create setattr getattr unlink rename };
allow systemd_update_done_t kmsg_device_t:chr_file write;
allow systemd_update_done_t default_context_t:dir search;
allow systemd_update_done_t devlog_t:sock_file write;
allow systemd_update_done_t file_context_t:dir search;
allow systemd_update_done_t file_context_t:file { getattr map open read };
allow systemd_update_done_t init_t:dir search;
allow systemd_update_done_t init_t:file { getattr ioctl open read };
allow systemd_update_done_t init_var_run_t:dir search;
allow systemd_update_done_t self:process setfscreate;
allow systemd_update_done_t sysctl_kernel_t:dir search;
allow systemd_update_done_t sysctl_kernel_t:file { getattr ioctl open read };
allow systemd_update_done_t sysctl_t:dir search;
allow systemd_update_done_t syslogd_t:unix_dgram_socket sendto;
allow systemd_update_done_t syslogd_var_run_t:dir search;
allow systemd_update_done_t var_run_t:dir search;

allow systemd_sysctl_t overlay_t:dir search;
allow systemd_modules_load_t overlay_t:dir search;
allow systemd_update_done_t overlay_t:dir list_dir_perms;

allow systemd_logind_t overlay_t:dir search_dir_perms;
allow systemd_logind_t proc_psi_t:dir search_dir_perms;
allow systemd_logind_t proc_psi_t:file read_file_perms;
allow systemd_logind_t drm_card_sysfs_t:dir search_dir_perms;
allow systemd_logind_t drm_card_sysfs_t:file read_file_perms;

allow systemd_modules_load_t self:capability sys_nice;
allow systemd_sysctl_t tmpfs_t:dir search_dir_perms;

manage_system_data_files(systemd_tmpfiles_t, leprop_system_data_t)
allow systemd_tmpfiles_t wifi_system_data_t:dir manage_dir_perms;

mls_file_read_all_levels(systemd_sysctl_t);

allow systemd_generator_t storage_disk_device_t:blk_file read_file_perms;

mls_process_write_to_clearance(systemd_modules_load_t)
mls_process_write_all_levels(systemd_modules_load_t)

allow udev_t proc_psi_t:dir list_dir_perms;
allow udev_t proc_psi_t:file rw_file_perms;
allow udev_t drm_card_sysfs_t:dir list_dir_perms;
allow udev_t drm_card_sysfs_t:file read_file_perms;
allow systemd_logind_t proc_psi_t:file { read open getattr write };
allow syslogd_t proc_psi_t:dir { read open getattr search watch };
allow syslogd_t proc_psi_t:file { read open getattr write };
allow tftp_server_t dosfs_t:dir { search open read getattr };
allow tftp_server_t dosfs_t:file { open read getattr };
allow udev_t init_runtime_t:file { open read getattr };
