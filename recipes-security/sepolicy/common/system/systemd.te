ifdef(`init_systemd',`
    init_use_script_ptys(systemd_passwd_agent_t)

    allow systemd_passwd_agent_t init_var_run_t:dir { create open read add_name write getattr search };
    allow systemd_passwd_agent_t proc_t:file { read open };

    # Since we use systemd-tmpfiles to populate "/data", we have the systemd_tmpfiles_manage_all
    # flag enabled, we may as well let it manage "/data" too.
    tunable_policy(`systemd_tmpfiles_manage_all',`
        gen_require(`
            attribute user_data;
            type data_t;
        ')
        ## Note: Adding macro manage_user_data_files(systemd_tmpfiles_t, user_data); was giving
        ## compilation error. Instead of using macro, we add the changes for that macro directly
        ## here and comment the two lines which is causing compilation error.
        ## Original definition of macro manage_user_data_files is - sepolicy/common/device/data.if
        ## In expanding macro here, commented the below lines from that macro which was causing
        ## errors.
        ##  - read_user_data_files(systemd_tmpfiles_t, user_data)
        ##  - typeattribute systemd_tmpfiles_t domain_can_write_userdata;
        allow systemd_tmpfiles_t data_t:dir create;
        manage_dirs_pattern(systemd_tmpfiles_t, user_data, user_data)
        manage_files_pattern(systemd_tmpfiles_t, user_data, user_data)
        manage_lnk_files_pattern(systemd_tmpfiles_t, user_data, user_data)
        manage_sock_files_pattern(systemd_tmpfiles_t, user_data, user_data)
    ')
    files_manage_var_dirs(systemd_tmpfiles_t)
    files_read_generic_tmp_symlinks(systemd_tmpfiles_t)
    allow daemon init_t:unix_dgram_socket sendto;
    fs_getattr_cgroup(systemd_logind_t)
    fs_read_cgroup_files(systemd_logind_t)
    init_dgram_send(systemd_cgroups_t)
    init_stream_connect(systemd_cgroups_t)
    seutil_read_file_contexts(systemd_logind_t)
    allow systemd_logind_t init_t:system { start status stop };
    allow systemd_logind_t self:process { getcap setfscreate };
    userdebug_or_eng(`
        gen_require(`
                attribute unconfined_domain_type;
                class service { start status stop } ;
        ')
        allow unconfined_domain_type power_unit_t:service { start status stop };
    ')

    gen_require(`
        type init_var_run_t;
        type udev_var_run_t;
    ')
    # init_write_pid_socket
    read_sock_files_pattern(systemd_logind_t, init_var_run_t, init_var_run_t)
    # init_create_pid_dirs
    create_dirs_pattern(systemd_logind_t, init_var_run_t, init_var_run_t)
    # udev_list_pids
    allow systemd_logind_t udev_var_run_t:dir { read };
')
