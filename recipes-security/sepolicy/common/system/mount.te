optional_policy(`
    fs_relabelfrom_firmware(mount_t)
')
optional_policy(`
    fs_relabelfrom_dsp(mount_t)
')
optional_policy(`
    data_mount_user_dir(mount_t)
    data_mount_volatile_bind(mount_t)
')
optional_policy(`
    persist_mount_dir(mount_t)
')

# Needed when launched from mount-copybind
optional_policy(`
    search_system_data_dir(mount_t)
')

# /dev/ubi*
optional_policy(`
    device_read_ubi_device(mount_t)
')

### mount-copybind ###

type mount_copybind_t;
type mount_copybind_exec_t;
init_system_domain(mount_copybind_t, mount_copybind_exec_t)
term_use_all_terms(mount_copybind_t)
kernel_read_system_state(mount_copybind_t)
allow mount_copybind_t self:process setfscreate;

files_search_runtime(mount_copybind_t)
seutil_read_config(mount_copybind_t)
selinux_get_fs_mount(mount_copybind_t)
seutil_domtrans_setfiles(mount_copybind_t)

gen_require(`
    type var_lib_t;
    type var_t;
    attribute vendor_domain;
    type etc_t;
    type init_var_run_t;
    type mount_runtime_t;
')

allow mount_copybind_t var_t:dir { write add_name create };
allow mount_copybind_t var_lib_t:dir { getattr };

# Do not allow access to mount-copybind from a vendor domain
neverallow vendor_domain mount_copybind_exec_t:file { execute execute_no_trans };

# Copy files from /etc to /systemrw while preserving attributes
corecmd_exec_bin(mount_copybind_t)
files_read_etc_files(mount_copybind_t)
allow mount_copybind_t self:capability { chown fowner dac_read_search fsetid dac_override };
optional_policy(`
    data_manage_generic_system_files(mount_copybind_t)
    relabel_all_data_files(mount_copybind_t)
')

# Mount-copybind /systemrw/bluetooth /etc/bluetooth
optional_policy(`
    gen_require(`
        type bluetooth_conf_t;
    ')
    allow mount_copybind_t bluetooth_conf_t:dir list_dir_perms;
    bluetooth_read_config(mount_copybind_t)
    allow mount_t bluetooth_conf_t:file { read_file_perms mounton };
')

# Perform a bind mount with the real mount context
mount_domtrans(mount_copybind_t)

optional_policy(`
    files_read_alexa_data_files(mount_copybind_t)
')

# Files made writable using mount-copybind must have a unique label
neverallow mount_copybind_t etc_t:file { create relabelto };
fs_blk_getattr_tmpfs(mount_t)

#todo: cleanup commented lines
# TODO: Transition the login shells to unconfined_u:unconfined_r?
#userdebug_or_eng('
role system_r types unconfined_mount_t;
#')

optional_policy(`
    gen_require(`
        type sdcard_t;
    ')
    allow mount_t sdcard_t:filesystem relabelfrom;
')
manage_files_pattern(mount_t, mount_runtime_t, mount_runtime_t)
allow mount_copybind_t self:fifo_file rw_fifo_file_perms;
allow mount_t init_var_run_t:file getattr;
allow mount_copybind_t self:capability kill;

optional_policy(`
    gen_require(`
        type binderfs_t;
    ')

    allow mount_t binderfs_t:dir { getattr mounton };
    allow mount_t binderfs_t:filesystem mount;
')

gen_require(`
    type overlay_t;
')
allow mount_t overlay_t:chr_file delete_chr_file_perms;
allow mount_t var_t:chr_file unlink;
