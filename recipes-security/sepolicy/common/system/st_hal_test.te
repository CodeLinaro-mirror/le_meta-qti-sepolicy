policy_module(st_hal_test, 1.0)

gen_require(`
	type tracefs_t;
	type trace_marker_t;
')

#============= st_hal_test_t ================================================

type st_hal_test_t;
type st_hal_test_exec_t;

init_daemon_domain(st_hal_test_t, st_hal_test_exec_t)
unconfined_domtrans_to(st_hal_test_t, st_hal_test_exec_t)

# Manage private files inside /data
type st_hal_test_data_t;
user_data_files_type(st_hal_test_data_t)
manage_user_data_files(st_hal_test_t, st_hal_test_data_t)
data_filetrans(st_hal_test_t, st_hal_test_data_t, { file })

# self
allow st_hal_test_t self:unix_dgram_socket create_socket_perms ;

non_audio_hal_access(st_hal_test_t)
audio_hal_access(st_hal_test_t)

allow st_hal_test_t tracefs_t:filesystem mount;
allow st_hal_test_t tracefs_t:dir search;
allow st_hal_test_t trace_marker_t:file { write open };

audio_data_files_access(st_hal_test_t)



