type init_user_data_t;
user_data_files_type(init_user_data_t)

dev_relabelto_irsc_util(kernel_t)

allow init_t initrc_t:binder { transfer call };
allow init_t self:binder { transfer call set_context_mgr };
binder_call_transfer(initrc_t)

allow init_t self:system { reboot halt };

# Included in later upstream versions
kernel_load_module(initrc_t)

# ADB policies

# /dev/usb-ffs/adb
fs_search_functionfs_dirs(initrc_t)
fs_rw_functionfs_files(initrc_t)
# /etc/adb_devid & /etc/build.prop
adb_read_files(initrc_t)
# /dev/socket/leprop-service
adb_rw_sockets(initrc_t)

# Systemd policies
ifdef(`init_systemd',`
    ifdef(`enable_mls',`
        mls_process_set_level(kernel_t)
        mls_file_upgrade(init_t)
    ')
    
    # Should be included in later upstream versions
    allow init_t {
        systemd_unit_t
        init_var_run_t
        power_unit_t
    }:service { status start stop };
    
    term_create_devpts_dirs(init_t)
    fs_search_cgroup_dirs(daemon)
    allow init_t daemon:unix_stream_socket create_stream_socket_perms;
    allow initrc_t init_t:system { start status reboot halt reload };

    # For /data/usb
    manage_user_data_files(init_t, init_user_data_t)

    # Needed for now to allow access to /data/usb on first boot. Once files
    #   are moved or a restorecon call is made, this policy can be removed.
    gen_require(`
        type data_t;
    ')
    manage_user_data_files(init_t, data_t)
    auditallow init_t data_t:file { read write };
')

# find_partitions
manage_default_user_data_dirs(initrc_t)
mount_domtrans(initrc_t)
seutil_domtrans_setfiles(initrc_t)

#this access is needed by servicemanager
allow initrc_t self:binder set_context_mgr;

manage_user_data_files(initrc_t, init_user_data_t)
auditallow initrc_t init_user_data_t:file { read write };

# Allow with warning
gen_require(`
    type system_data_t;
')
read_system_data_files(initrc_t, system_data_t);
auditallow initrc_t system_data_t:file { read };
