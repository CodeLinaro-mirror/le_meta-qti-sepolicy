type wifi_data_t;
user_data_files_type(wifi_data_t)
manage_user_data_files(NetworkManager_t, wifi_data_t)

type wifi_system_data_t;
system_data_files_type(wifi_system_data_t)
manage_system_data_files(NetworkManager_t, wifi_system_data_t)

# this rules are for wpa_supplicant which run in NetworkManger context
rw_shared_memory_dev(NetworkManager_t)
userdebug_or_eng(`
    rw_diag_dev(NetworkManager_t)
')
dev_rw_null(NetworkManager_t)

manage_user_data_files(wpa_cli_t, wifi_data_t)
manage_user_data_files(dhcpc_t, wifi_data_t)

# this needs to have for qcmap_cm context
read_write_qcmap_cm_socket_files(NetworkManager_t)
qcmap_cm_rw_sock_files(NetworkManager_t)
qcmap_cm_sendto_unix_dgram_socket(NetworkManager_t);

### WLAN initscript ###

type wlan_initrc_exec_t;
type wlan_initrc_t;
init_script_domain(wlan_initrc_t, wlan_initrc_exec_t)

userdebug_or_eng(`
    mls_file_write_all_levels(wlan_initrc_t)
')

corecmd_exec_shell(wlan_initrc_t)
corecmd_exec_bin(wlan_initrc_t)
dev_write_kmsg(wlan_initrc_t)
kernel_read_system_state(wlan_initrc_t)  # uname
sysnet_domtrans_ifconfig(wlan_initrc_t)
modutils_domtrans(wlan_initrc_t)
# The above rule doesn't seem to grant read permissions
modutils_exec(wlan_initrc_t)

allow wlan_initrc_t self:fifo_file rw_file_perms;
qcmap_cm_rw_unix_dgram_socket(NetworkManager_t)
userdebug_or_eng(`
    rw_diag_dev(dhcpc_t)
')
qcmap_cm_rw_unix_netlink_socket(dhcpc_t)
qcmap_cm_rw_unix_netlink_socket(NetworkManager_t)
qcmap_manage_var_run_qcmap_dir(NetworkManager_t)
qcmap_delete_qcmap_pid(NetworkManager_t)

allow wlan_initrc_t self:fifo_file rw_file_perms;
allow wlan_initrc_t NetworkManager_exec_t:file { execute read_file_perms execute_no_trans map };
files_search_default(NetworkManager_t);
files_rw_qcmap_etc_data_files(NetworkManager_t)
read_write_qcmap_cm_socket_files(wlan_initrc_t)

qcmap_manage_qcmap_pid(NetworkManager_t)
userdebug_or_eng(`
    networkmanager_wifi_data_filetrans(NetworkManager_t, file, "wpa_supplicant.log")
    networkmanager_wifi_data_filetrans(NetworkManager_t, file, "hostapd.log")
    networkmanager_wifi_data_filetrans(NetworkManager_t, file, "hostapd1.log")
    networkmanager_wifi_data_filetrans(NetworkManager_t, file, "hostapd2.log")
')
# dhcpc_t access systemd_resolved_var_run_t, init_var_run_t
gen_require(`
    type systemd_resolved_var_run_t;
    type init_var_run_t;
    type var_run_t;
    type chronyd_conf_t;
    type initrc_var_run_t;
    type udev_var_run_t;
    type init_t;
    type initrc_runtime_t;
')
logging_send_syslog_msg(dhcpc_t)
allow dhcpc_t systemd_resolved_var_run_t:file { open write };
allow dhcpc_t init_var_run_t:file { getattr setattr open write };
allow dhcpc_t self:unix_stream_socket listen;
allow dhcpc_t var_run_t:sock_file { create setattr unlink };
allow dhcpc_t self:capability kill;
allow dhcpc_t chronyd_conf_t:file { rw_file_perms };
allow dhcpc_t initrc_var_run_t:file { setattr };
allow dhcpc_t self:netlink_kobject_uevent_socket create_socket_perms;
allow dhcpc_t udev_var_run_t:file { rw_file_perms setattr };
allow dhcpc_t init_t:system { status };
allow dhcpc_t initrc_runtime_t:dir { rw_dir_perms create };
allow dhcpc_t initrc_runtime_t:file { create_file_perms unlink };
allow dhcpc_t initrc_runtime_t:sock_file { create_sock_file_perms setattr };
#TODO properly con_mode node
dev_rw_sysfs(wlan_initrc_t)
gen_require(`
    type firmware_t;
    type hostapd_var_run_t;
')
allow wlan_initrc_t firmware_t:dir { search getattr open };
allow wlan_initrc_t firmware_t:file read_file_perms;
files_search_home(wlan_initrc_t)
kernel_search_debugfs(wlan_initrc_t)
getty_use_fds(wlan_initrc_t)
term_use_unallocated_ttys(wlan_initrc_t)

gen_require(`
    type qcmap_var_run_t;
')
allow wpa_cli_t qcmap_var_run_t:file { write getattr };
dev_read_urand(wpa_cli_t)
allow wpa_cli_t hostapd_var_run_t:sock_file { write };
allow wpa_cli_t hostapd_var_run_t:dir search_dir_perms;
allow wpa_cli_t qcmap_var_run_t:file { read };
allow NetworkManager_t hostapd_var_run_t:dir search_dir_perms;
allow NetworkManager_t hostapd_var_run_t:dir { add_name write search remove_name };
allow NetworkManager_t hostapd_var_run_t:sock_file { create read write setattr };
allow NetworkManager_t system_data_t:file manage_file_perms;

# unused pipes
gen_require(`
    type httpd_t;
    type random_device_t;
    type cert_t;
    type proc_net_t;
    type sysctl_net_t;
    type wireless_device_t;
    type sysctl_t;
    type urandom_device_t;
    type hostapd_t;
    type unreserved_port_t;
    type kmod_t;
')
dontaudit NetworkManager_t httpd_t:fd use;
dontaudit wpa_cli_t httpd_t:fd use;
apache_dontaudit_rw_fifo_file(wpa_cli_t)
manage_sock_files_pattern(wpa_cli_t, NetworkManager_var_run_t, NetworkManager_var_run_t)
files_runtime_filetrans(wpa_cli_t, NetworkManager_var_run_t, { dir file sock_file })
allow NetworkManager_t unreserved_port_t:udp_socket { name_bind };

allow wlan_initrc_t NetworkManager_var_run_t:dir { add_name create remove_name search write };
allow wlan_initrc_t NetworkManager_var_run_t:file { create getattr open read unlink write };
manage_sock_files_pattern(wlan_initrc_t, NetworkManager_var_run_t, NetworkManager_var_run_t)
files_runtime_filetrans(wlan_initrc_t, NetworkManager_var_run_t, { dir file sock_file })

userdom_write_user_tmp_sockets(wlan_initrc_t)

allow wlan_initrc_t init_t:unix_stream_socket { read write getattr };
allow wlan_initrc_t kmod_t:file read;
allow wlan_initrc_t random_device_t:chr_file read_chr_file_perms;
allow wlan_initrc_t wifi_data_t:dir search;
allow wlan_initrc_t cert_t:dir search;
allow wlan_initrc_t cert_t:file { getattr open read };
allow wlan_initrc_t proc_net_t:file read;
allow wlan_initrc_t sysctl_net_t:dir search;
allow wlan_initrc_t sysctl_net_t:file { open read write };
allow wlan_initrc_t self:capability { net_admin net_raw};
allow wlan_initrc_t self:netlink_generic_socket { bind create getattr read setopt write };
allow wlan_initrc_t self:netlink_route_socket { bind create read nlmsg_write write };
allow wlan_initrc_t self:packet_socket { bind create ioctl setopt read write };
allow wlan_initrc_t self:udp_socket { create ioctl };
allow wlan_initrc_t urandom_device_t:chr_file { getattr ioctl open read };
allow wlan_initrc_t sysctl_t:dir search;
allow wlan_initrc_t wireless_device_t:chr_file { open read };
manage_user_data_files(wlan_initrc_t, wifi_data_t)

dontaudit wpa_cli_t kmsg_device_t:chr_file { write_file_perms };
dontaudit wpa_cli_t self:capability { setgid setpcap };
allow wpa_cli_t self:capability { setuid };
allow wpa_cli_t self:process { getcap setcap };
allow wpa_cli_t self:unix_stream_socket { create_stream_socket_perms };
allow wpa_cli_t hostapd_t:unix_dgram_socket { sendto };
corecmd_exec_shell(wpa_cli_t)

allow NetworkManager_t self:qipcrtr_socket create_socket_perms;

gen_require(`
  type hostapd_tmp_t;
')

allow NetworkManager_t hostapd_tmp_t:file { rw_file_perms };
dontaudit NetworkManager_t self:capability { sys_admin };

###Ezmesh Initscripts###
type wlan_ezmesh_initrc_exec_t;
type wlan_ezmesh_initrc_t;
init_script_domain(wlan_ezmesh_initrc_t, wlan_ezmesh_initrc_exec_t)

# /dev/kmsg
userdebug_or_eng(`
    dev_write_kmsg(NetworkManager_t);
    mls_file_write_all_levels(NetworkManager_t);
    mls_file_write_all_levels(wlan_ezmesh_initrc_t);
    kernel_search_debugfs(wlan_ezmesh_initrc_t);
')

corecmd_exec_shell(wlan_ezmesh_initrc_t)
corecmd_exec_bin(wlan_ezmesh_initrc_t)
dev_write_kmsg(wlan_ezmesh_initrc_t)
kernel_read_system_state(wlan_ezmesh_initrc_t)  # uname
sysnet_domtrans_ifconfig(wlan_ezmesh_initrc_t)
modutils_domtrans(wlan_ezmesh_initrc_t)
# The above rule doesn't seem to grant read permissions
modutils_exec(wlan_ezmesh_initrc_t)

allow wlan_ezmesh_initrc_t self:fifo_file rw_file_perms;
allow wlan_ezmesh_initrc_t self:fifo_file rw_file_perms;
allow wlan_ezmesh_initrc_t NetworkManager_exec_t:file { read_file_perms exec_file_perms };

#TODO properly con_mode node
dev_rw_sysfs(wlan_ezmesh_initrc_t)
allow wlan_ezmesh_initrc_t firmware_t:dir search_dir_perms;
allow wlan_ezmesh_initrc_t firmware_t:file read_file_perms;
files_search_home(wlan_ezmesh_initrc_t)
getty_use_fds(wlan_ezmesh_initrc_t)
term_use_unallocated_ttys(wlan_ezmesh_initrc_t)

allow wlan_ezmesh_initrc_t NetworkManager_var_run_t:dir rw_dir_perms;
allow wlan_ezmesh_initrc_t NetworkManager_var_run_t:file { create rw_file_perms };
manage_sock_files_pattern(wlan_ezmesh_initrc_t, NetworkManager_var_run_t, NetworkManager_var_run_t)
files_runtime_filetrans(wlan_ezmesh_initrc_t, NetworkManager_var_run_t, { dir file sock_file })

userdom_write_user_tmp_sockets(wlan_ezmesh_initrc_t)

allow wlan_ezmesh_initrc_t init_t:unix_stream_socket rw_socket_perms;
allow wlan_ezmesh_initrc_t kmod_t:file read_file_perms;
allow wlan_ezmesh_initrc_t random_device_t:chr_file read_chr_file_perms;
allow wlan_ezmesh_initrc_t wifi_data_t:dir search_dir_perms;
allow wlan_ezmesh_initrc_t cert_t:dir search_dir_perms;
allow wlan_ezmesh_initrc_t cert_t:file read_file_perms;
allow wlan_ezmesh_initrc_t proc_net_t:file read_file_perms;
allow wlan_ezmesh_initrc_t sysctl_net_t:dir search_dir_perms;
allow wlan_ezmesh_initrc_t sysctl_net_t:file rw_file_perms;
allow wlan_ezmesh_initrc_t self:capability { net_admin net_raw};
allow wlan_ezmesh_initrc_t self:netlink_generic_socket create_socket_perms;
allow wlan_ezmesh_initrc_t self:netlink_route_socket create_netlink_socket_perms;
allow wlan_ezmesh_initrc_t self:packet_socket create_socket_perms;
allow wlan_ezmesh_initrc_t self:udp_socket { create ioctl };
allow wlan_ezmesh_initrc_t urandom_device_t:chr_file read_chr_file_perms;
allow wlan_ezmesh_initrc_t sysctl_t:dir search_dir_perms;
allow wlan_ezmesh_initrc_t wireless_device_t:chr_file read_chr_file_perms;
manage_user_data_files(wlan_ezmesh_initrc_t, wifi_data_t)
