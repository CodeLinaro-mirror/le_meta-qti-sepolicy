type hostapd_cli_qcmap_t;
type hostapd_cli_exec_t;
init_vendor_domain(hostapd_cli_qcmap_t, hostapd_cli_exec_t)
gen_require(`
 type data_t;
 type etc_t;
 type devlog_t;
 type syslogd_t;
 type wireless_device_t;
 type proc_net_t;
 type qcmap_data_t;
 type wifi_system_data_t;
 type qcmap_socket_device_t;
 type socket_device_t;
 type kmsg_device_t;
 type syslogd_var_run_t;
 type user_tmp_t;
 type wpa_cli_t;
 type NetworkManager_tmp_t;
 type system_data_t;
 type unreserved_port_t;
 type node_t;
 type cert_t;
')
type hostapd_tmp_t;
allow hostapd_cli_qcmap_t qcmap_socket_device_t:sock_file write;
allow hostapd_cli_qcmap_t var_run_t:sock_file { create write unlink };
allow hostapd_cli_qcmap_t var_run_t:dir { write add_name remove_name };
allow hostapd_cli_qcmap_t hostapd_var_run_t:dir search;
allow hostapd_cli_qcmap_t socket_device_t:dir search;
dev_read_urand(hostapd_cli_qcmap_t)
allow hostapd_t wpa_cli_t:unix_dgram_socket { sendto };
allow hostapd_t NetworkManager_tmp_t:sock_file { write };
allow hostapd_t NetworkManager_tmp_t:file rw_file_perms;
allow hostapd_t cert_t:dir { read open search };
allow hostapd_t cert_t:file { getattr open read };
files_tmp_file(hostapd_tmp_t);
files_tmp_filetrans(hostapd_t, hostapd_tmp_t, { file dir })
manage_files_pattern(hostapd_t, hostapd_tmp_t, hostapd_tmp_t)

user_data_files_type(qcmap_data_t)

data_filetrans(hostapd_t, qcmap_data_t, file)

allow hostapd_t var_run_t:sock_file { create write setattr unlink};
manage_user_data_files(hostapd_t, qcmap_data_t)
allow hostapd_t etc_t:file { getattr open read };
allow hostapd_t wireless_device_t:chr_file { open read };
allow hostapd_t proc_net_t:file { read };
allow hostapd_t wifi_system_data_t:dir { search };
allow init_t system_data_t:lnk_file { read };
allow hostapd_t unreserved_port_t:udp_socket { name_bind };
allow hostapd_t node_t:udp_socket { node_bind };
dontaudit hostapd_t self:capability { sys_module };

userdebug_or_eng('
        allow hostapd_t kmsg_device_t:chr_file { write getattr ioctl };
        mls_file_write_all_levels(kmsg_device_t);
')
allow hostapd_t etc_t:file { map };
allow hostapd_t syslogd_var_run_t:dir { search  };
allow hostapd_t user_tmp_t:sock_file{ write };

qcmap_manage_var_run_data_files(hostapd_t)
networkmanager_read_wifi_sysdata_files(hostapd_t)
allow hostapd_t self:udp_socket connected_socket_perms;

gen_require(`
    type tmp_t;
    type qcmap_tmp_t;
    type kmsg_device_t;
')
rw_sock_files_pattern(hostapd_t, tmp_t, qcmap_tmp_t)

type hostapd_unit_t;
init_unit_file(hostapd_unit_t)

# CLI

type hostapd_cli_qcmap_unit_t;
init_unit_file(hostapd_cli_qcmap_unit_t)
corecmd_exec_shell(hostapd_cli_qcmap_unit_t)

# /dev/kmsg
userdebug_or_eng(`
    dev_write_kmsg(hostapd_t);
    mls_file_write_all_levels(hostapd_t);
')

dontaudit hostapd_t kmsg_device_t:chr_file { getattr };
dontaudit hostapd_t etc_t:file { map };
