#seems nbd driver need to do
#need to invistagate check
gen_require(`
    type mount_t;
    type  kernel_t;
    type post_boot_script_t;
    type initrc_t;
    type unconfined_t;
    class dbus send_msg;
    type leprop_system_data_t;
    type sysfs_power_state_t;
    type cpu_scaling_freq_sys_t;
    type cpu_parameters_sys_t;
    type mmc_host_sys_t;
')
#set scheduling parameters for a kernel domain task.
allow mount_t  kernel_t:process {setsched } ;

# set access to mhi pipes in post-boot-script
allow post_boot_script_t mhi_pipe_device_t:chr_file { getattr open read write };

### MHI PIPE TYPE ###
type mhi_pipe_device_t;
dev_node(mhi_pipe_device_t);

allow initrc_t unconfined_t:dbus send_msg;
dontaudit initrc_t leprop_system_data_t:file getattr;
allow post_boot_script_t setprop_exec_t:file { open read };
allow post_boot_script_t sysfs_power_state_t:file { getattr_file_perms setattr_file_perms };

allow post_boot_script_t cpu_scaling_freq_sys_t:dir write;
allow post_boot_script_t cpu_parameters_sys_t:dir write;
allow post_boot_script_t mmc_host_sys_t:dir write;
