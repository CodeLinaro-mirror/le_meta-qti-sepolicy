policy_module(fbe-service, 1.0)

########################################
#
# Declarations
#

type fbe_service_t;
type fbe_service_exec_t;
type hwfde_conf_file_t;
type install_evict_t;
type hwfde_service_t;
type fbe_secure_data_t;

init_daemon_domain(fbe_service_t, fbe_service_exec_t)

gen_require(`
        type urandom_device_t;
        type init_var_run_t;
        type overlay_t;
        type syslogd_var_run_t;
        type fs_t;
        type syslogd_t;
        type devlog_t;
        type fbe_secure_data_t;
        type smcinvoke_device_t;
        type proc_t;
        type socket_device_t;
        type mount_t;
        type data_t;
        type kernel_t;
')

kernel_dontaudit_read_system_state(fbe_service_t)
logging_send_syslog_msg(fbe_service_t)
mls_file_read_all_levels(fbe_service_t);
mls_file_write_all_levels(fbe_service_t);
fs_mount_xattr_fs(fbe_service_t)
files_polyinstantiate_all(fbe_service_t)
overlay_mount_user_dir(fbe_service_t)
leprop_rw_props(fbe_service_t)
allow initrc_t fbe_secure_data_t:dir create_dir_perms;
allow initrc_t overlay_t:dir manage_dir_perms;

#  Allow creation of /unencrypted dir inside /overlay.
allow fbe_secure_data_t fs_t:filesystem  { associate };

#Allow fbe_service_t to check if unencrypted folder already exists in /overlay
allow fbe_service_t overlay_t:dir manage_dir_perms;

allow fbe_service_t urandom_device_t:chr_file read_chr_file_perms;
allow fbe_service_t init_var_run_t:dir search_dir_perms;
allow fbe_service_t proc_t:file read_file_perms;
allow fbe_service_t fbe_secure_data_t:dir manage_dir_perms;
allow fbe_service_t devlog_t:sock_file write_sock_file_perms;
allow fbe_service_t fbe_secure_data_t:file rw_file_perms;
allow fbe_service_t fbe_service_t:key { search };
allow fbe_service_t smcinvoke_device_t:chr_file rw_chr_file_perms;
allow fbe_service_t socket_device_t:dir search_dir_perms;
allow fbe_service_t hwfde_conf_file_t:file read_file_perms;
allow fbe_service_t fbe_secure_data_t:file { create };
allow fbe_service_t data_t:dir { read ioctl };
#Allow fbe_service_t to request for openssl encryption
allow fbe_service_t kernel_t:system module_request;
