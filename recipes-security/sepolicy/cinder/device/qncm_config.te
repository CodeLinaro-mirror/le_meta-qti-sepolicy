policy_module(qncm_config, 1.0)

type qncm_config_initrc_t;
type qncm_config_initrc_exec_t;

gen_require(`
  type persist_t;
  type qnetcfgmgr_persist_qncm_t;
  type shell_exec_t;
  type init_t;
')

init_script_domain(qncm_config_initrc_t, qncm_config_initrc_exec_t)

filetrans_pattern(qncm_config_initrc_t, persist_t, qnetcfgmgr_persist_qncm_t, { file dir })
allow qncm_config_initrc_t qnetcfgmgr_persist_qncm_t:dir manage_dir_perms;
allow qncm_config_initrc_t shell_exec_t:file { read execute map};
allow qncm_config_initrc_t init_t:unix_stream_socket  rw_stream_socket_perms ;

