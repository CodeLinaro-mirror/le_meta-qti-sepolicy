policy_module(qnetcfgmgr, 1.0)
type qnetcfgmgr_t;
type qnetcfgmgr_exec_t;

type qnetcfgmgr_macsec_t;
type qnetcfgmgr_macsec_exec_t;
type qnetcfgmgr_cfm_t;
type qnetcfgmgr_cfm_exec_t;

type qnetcfgmgr_dig_exec_t;
type qnetcfgmgr_dig_t;

type qnetcfgmgr_dhcp_exec_t;
type qnetcfgmgr_dhcp_t;

type qnetcfgmgr_etc_data_t;
type qnetcfgmgr_var_t;
type qnetcfgmgr_rt_table_t;
type qnetcfgmgr_ipv6_net_t;
type qnetcfgmgr_chip_t;
type qnetcfgmgr_run_qncm_t;
type qnetcfgmgr_persist_qncm_t;

init_vendor_domain(qnetcfgmgr_t, qnetcfgmgr_exec_t)
init_script_domain(qnetcfgmgr_macsec_t, qnetcfgmgr_macsec_exec_t)
init_script_domain(qnetcfgmgr_cfm_t, qnetcfgmgr_cfm_exec_t)

userdebug_or_eng(`
  dev_write_kmsg(qnetcfgmgr_t);
  rw_diag_dev(qnetcfgmgr_t);
  kernel_manage_debugfs(qnetcfgmgr_t);
  ')

gen_require(`
  type default_t;
  type data_t;
  type etc_t;
  type sysctl_t;
  type mount_t;
  type setfiles_t;
  type ifconfig_t;
  type proc_net_t;
  type proc_t;
  type qrtr_ns_t;
  type kernel_t;
  type udev_t;
  type tftp_server_t;
  type init_var_run_t;
  type mount_copybind_t;
  type systemd_logind_var_run_t;
  type system_dbusd_t;
  type sdcard_t;
  type mnt_t;
  type event_device_t;
  type NetworkManager_t;
  type NetworkManager_exec_t;
  type sysctl_net_t;
  type initrc_var_run_t;
  type dhcpc_t;
  type ping_exec_t;
  type time_daemon_t;
  type initrc_t;
  type qcmap_etc_data_t;
  type unconfined_t;
  type dnsmasq_t;
  type qnetcfgmgr_dig_exec_t;
  type dumgr_config_t;
  type net_conf_t;
  type home_root_t;
  type cert_t;
  type user_home_dir_t;
  type node_t;
  type persist_t;
  type pmsg0_t;
  type system_dbusd_var_run_t;
  type faultmgr_t;
  class dbus send_msg;
  class dbus acquire_svc;
  class service stop;
')

system_data_files_type(qnetcfgmgr_etc_data_t)
files_read_etc_files(qnetcfgmgr_t)
data_rw_system_data_files(qnetcfgmgr_dhcp_t, qnetcfgmgr_etc_data_t)
data_rw_system_data_files(qnetcfgmgr_t, qnetcfgmgr_etc_data_t)
data_rw_system_data_files(qnetcfgmgr_macsec_t, qnetcfgmgr_etc_data_t)
manage_system_data_files(qnetcfgmgr_t, qnetcfgmgr_etc_data_t, qnetcfgmgr_etc_data_t)

allow qnetcfgmgr_t qnetcfgmgr_macsec_exec_t:file { read open getattr };
allow qnetcfgmgr_t dumgr_config_t:dir { search getattr };
allow qnetcfgmgr_t dumgr_config_t:file { read open write getattr };
read_system_data_files(NetworkManager_t, qnetcfgmgr_etc_data_t)
networkmanager_domtrans(qnetcfgmgr_t)
allow qnetcfgmgr_t NetworkManager_exec_t:file { getattr execute read open execute_no_trans };

allow qnetcfgmgr_t NetworkManager_t:unix_dgram_socket { sendto };
allow NetworkManager_t qnetcfgmgr_t:netlink_route_socket { read write };

# Ifconfig and IP commands
sysnet_domtrans_ifconfig(qnetcfgmgr_t)
iptables_domtrans(qnetcfgmgr_t)
sysnet_domtrans_dhcpc(qnetcfgmgr_t)


# Netlink sockets
allow qnetcfgmgr_t self:{ netlink_route_socket netlink_generic_socket netlink_socket } create_socket_perms;

# Need to create socket context & provide access directly
type qnetcfgmgr_socket_device_t;
files_type(qnetcfgmgr_socket_device_t)
dev_node(qnetcfgmgr_socket_device_t)
device_manage_socket_file(qnetcfgmgr_t, qnetcfgmgr_socket_device_t)
device_rw_socket_files(qnetcfgmgr_t, qnetcfgmgr_socket_device_t)

allow qnetcfgmgr_t self:socket { rw_socket_perms create };
allow qnetcfgmgr_t self:unix_dgram_socket { sendto };

#system_data_files_type(qnetcfgmgr_rt_table_t);

allow qnetcfgmgr_rt_table_t fs_t:filesystem associate;

read_lnk_files_pattern(qnetcfgmgr_t, proc_net_t, qnetcfgmgr_t)
read_files_pattern(qnetcfgmgr_t, proc_net_t, qnetcfgmgr_t);

read_lnk_files_pattern(qnetcfgmgr_t, proc_t, qnetcfgmgr_t)
read_files_pattern(qnetcfgmgr_t, proc_t, qnetcfgmgr_t)

allow qnetcfgmgr_t qrtr_ns_t:dir { getattr search };
allow qnetcfgmgr_t qrtr_ns_t:file { read open };
allow qnetcfgmgr_t self:fifo_file ioctl;
allow qnetcfgmgr_t self:netlink_route_socket { nlmsg_read nlmsg_write};
allow qnetcfgmgr_t self:qipcrtr_socket { write create getattr read };
allow qnetcfgmgr_t self:tcp_socket { getattr create ioctl read write };
allow qnetcfgmgr_t self:udp_socket { create ioctl read write };
allow qnetcfgmgr_t syslogd_t:dir { getattr search };
allow qnetcfgmgr_t syslogd_t:file { read open write };
allow qnetcfgmgr_t tftp_server_t:dir { search getattr read };
allow qnetcfgmgr_t tftp_server_t:file { read open };
allow qnetcfgmgr_t udev_t:dir { getattr search };
allow qnetcfgmgr_t udev_t:file { read open };
allow qnetcfgmgr_t initrc_var_run_t:dir { search write add_name create remove_name unlink};
allow qnetcfgmgr_t initrc_var_run_t:file { create read write open getattr unlink };

userdebug_or_eng('
# To support systemctl stop qnet_config_managerd
allow unconfined_t qnetcfgmgr_exec_t:service stop;
')

allow dhcpc_t initrc_var_run_t:dir { search write add_name };
allow dhcpc_t initrc_var_run_t:file { map create };
allow dhcpc_t qnetcfgmgr_t:netlink_route_socket { read write };
allow dhcpc_t qnetcfgmgr_t:unix_stream_socket { read write };
allow dhcpc_t qnetcfgmgr_persist_qncm_t:file { read write create open getattr map};
allow dhcpc_t persist_t:dir search;

# Permissions added for DNSmasq to support hosting RU local management port
allow dnsmasq_t initrc_var_run_t:dir { search write add_name };
allow dnsmasq_t initrc_var_run_t:file { create read open };
allow dnsmasq_t qnetcfgmgr_run_qncm_t:file { append write };

allow qnetcfgmgr_t self:process { setcap};
allow qnetcfgmgr_t self:icmp_socket { create setopt write read ioctl getopt };
allow qnetcfgmgr_t self:udp_socket { setopt connect getattr bind getopt };
allow qnetcfgmgr_t ping_exec_t:file { getattr execute read open map execute_no_trans };
allow qnetcfgmgr_t kernel_t:dir { search open };
allow qnetcfgmgr_t kernel_t:file { read };
allow qnetcfgmgr_t initrc_t:file { read open };
allow qnetcfgmgr_t initrc_t:dir { search };
allow qnetcfgmgr_t time_daemon_t:dir { search };
allow qnetcfgmgr_t time_daemon_t:file { read open };
allow qnetcfgmgr_t system_dbusd_t:dir { search };
allow qnetcfgmgr_t system_dbusd_t:file { read open};

allow ifconfig_t qnetcfgmgr_rt_table_t:file { read getattr open write };
allow ifconfig_t qnetcfgmgr_t:netlink_route_socket { read write };
allow ifconfig_t qnetcfgmgr_t:unix_stream_socket { read write };

dontaudit qnetcfgmgr_t domain:file getattr;
dontaudit qnetcfgmgr_t domain:dir getattr;

#Ethernet CFM rules
data_rw_system_data_files(qnetcfgmgr_cfm_t, qnetcfgmgr_etc_data_t)
allow qnetcfgmgr_t qnetcfgmgr_cfm_exec_t:file { read open getattr };
allow qnetcfgmgr_t proc_net_t:file {open read getattr};
allow qnetcfgmgr_t proc_net_t:dir {search open read};
allow NetworkManager_t initrc_var_run_t:dir { search write add_name create remove_name unlink};
allow NetworkManager_t initrc_var_run_t:sock_file { create read write open unlink getattr setattr};
allow qnetcfgmgr_t self:packet_socket { read write ioctl bind getopt setopt map  create};
allow qnetcfgmgr_t self:capability net_raw;
allow qnetcfgmgr_t initrc_t:file {open read };
allow qnetcfgmgr_t initrc_t:dir search;
allow qnetcfgmgr_t time_daemon_t:dir search;
allow qnetcfgmgr_t time_daemon_t:file {open read };
allow qnetcfgmgr_t kernel_t:file { read open};
allow qnetcfgmgr_t kernel_t:dir search;

# QNet_Config_Manager conf files
type qcm_etc_t;
files_type(qcm_etc_t)
logging_send_syslog_msg(qnetcfgmgr_t)
allow qnetcfgmgr_t self:fifo_file { read getattr write };
allow qnetcfgmgr_t self:netlink_kobject_uevent_socket { create bind setopt read };
corecmd_exec_shell(qnetcfgmgr_t)
allow qnetcfgmgr_t sysctl_t:dir search;
allow qnetcfgmgr_t sysctl_net_t:dir search;
allow qnetcfgmgr_t sysctl_net_t:file { write open };

#QNCM rt_tables
allow initrc_t qcmap_etc_data_t:dir search;
allow initrc_t qnetcfgmgr_rt_table_t:file getattr;
allow mount_copybind_t qnetcfgmgr_rt_table_t:file { getattr read };
allow setfiles_t qnetcfgmgr_rt_table_t:file getattr;
allow mount_copybind_t qnetcfgmgr_rt_table_t:file open;
allow mount_t qnetcfgmgr_rt_table_t:file getattr;
allow mount_t qnetcfgmgr_rt_table_t:file mounton;
allow mount_copybind_t qnetcfgmgr_rt_table_t:file create;
allow initrc_t qnetcfgmgr_rt_table_t:file setattr;
userdebug_or_eng('
allow unconfined_t qnetcfgmgr_rt_table_t:file { read getattr append open write setattr };
')
allow qnetcfgmgr_t qnetcfgmgr_rt_table_t:file { getattr append open read write };

#QNCM DNS support
allow unconfined_t qnetcfgmgr_dig_exec_t:file { getattr read open execute map execute_no_trans };
allow qnetcfgmgr_t qnetcfgmgr_dig_exec_t:file { getattr read open execute map execute_no_trans };
allow qnetcfgmgr_t net_conf_t:file { getattr read open };
allow qnetcfgmgr_t cert_t:dir search;
allow qnetcfgmgr_t cert_t:file {getattr open read };
allow qnetcfgmgr_t home_root_t:dir search;
allow qnetcfgmgr_t user_home_dir_t:dir search;
allow qnetcfgmgr_t node_t:udp_socket { node_bind };

#QNCM IP2MACv6
allow qnetcfgmgr_t self:rawip_socket{ create setopt write read };

#/persist/qncm/ files
user_data_files_type(qnetcfgmgr_persist_qncm_t)
manage_user_data_files(qnetcfgmgr_t, qnetcfgmgr_persist_qncm_t)
allow qnetcfgmgr_t persist_t:dir search;
allow initrc_t qnetcfgmgr_persist_qncm_t:dir setattr;
allow qnetcfgmgr_t qnetcfgmgr_persist_qncm_t:file map;

#  Dbus Client
allow qnetcfgmgr_t pmsg0_t:chr_file write;
allow qnetcfgmgr_t system_dbusd_var_run_t:dir search;
allow qnetcfgmgr_t system_dbusd_var_run_t:sock_file write;
allow qnetcfgmgr_t system_dbusd_t:unix_stream_socket connectto;
allow qnetcfgmgr_t system_dbusd_t:dbus { send_msg acquire_svc };
allow qnetcfgmgr_t faultmgr_t:dbus send_msg;

kernel_read_system_state(qnetcfgmgr_t)
allow qnetcfgmgr_t mnt_t:dir search;
allow qnetcfgmgr_t self:process { sigkill };
allow qnetcfgmgr_t dhcpc_t:process sigkill;
files_read_etc_files(qnetcfgmgr_t)
files_read_etc_files(qcm_etc_t)
allow qcm_etc_t qcm_etc_t:file rw_file_perms;
dontaudit qnetcfgmgr_t self:capability2 block_suspend;
init_read_state(qnetcfgmgr_t)
allow qnetcfgmgr_t init_t:unix_stream_socket connectto;
allow qnetcfgmgr_t init_var_run_t:sock_file write;
allow qnetcfgmgr_t self:capability { kill net_admin };
systemd_status_power_units(qnetcfgmgr_t)
systemd_start_power_units(qnetcfgmgr_t)
allow qnetcfgmgr_t sysctl_t:file { getattr open write };
allow qnetcfgmgr_t systemd_logind_var_run_t:sock_file write;
dontaudit qnetcfgmgr_t default_t:dir { search };
allow qnetcfgmgr_t self:process { getcap signal };
dev_rw_sysfs(qnetcfgmgr_t)
dontaudit qnetcfgmgr_t event_device_t:chr_file { getattr read open write ioctl };
mls_file_read_all_levels(qnetcfgmgr_t)
