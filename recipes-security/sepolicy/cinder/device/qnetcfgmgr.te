policy_module(qnetcfgmgr, 1.0)
type qnetcfgmgr_t;
type qnetcfgmgr_exec_t;

type qnetcfgmgr_macsec_t;
type qnetcfgmgr_macsec_exec_t;

type qnetcfgmgr_dig_exec_t;
type qnetcfgmgr_dig_t;

type qnetcfgmgr_dhcp_exec_t;
type qnetcfgmgr_dhcp_t;

type qnetcfgmgr_etc_data_t;
type qnetcfgmgr_var_t;
type qnetcfgmgr_rt_table_t;
type qnetcfgmgr_ipv6_net_t;
type qnetcfgmgr_chip_t;

init_vendor_domain(qnetcfgmgr_t, qnetcfgmgr_exec_t)
init_script_domain(qnetcfgmgr_macsec_t, qnetcfgmgr_macsec_exec_t)

userdebug_or_eng(`
  dev_write_kmsg(qnetcfgmgr_t);
  rw_diag_dev(qnetcfgmgr_t);
  kernel_manage_debugfs(qnetcfgmgr_t);
  ')

gen_require(`
  type default_t;
  type data_t;
  type etc_t;
  type sysctl_t;
  type mount_t;
  type setfiles_t;
  type ifconfig_t;
  type proc_net_t;
  type proc_t;
  type qrtr_ns_t;
  type kernel_t;
  type udev_t;
  type tftp_server_t;
  type init_var_run_t;
  type mount_copybind_t;
  type systemd_logind_var_run_t;
  type system_dbusd_t;
  type sdcard_t;
  type mnt_t;
  type event_device_t;
  type NetworkManager_t;
  type NetworkManager_exec_t;
  type sysctl_net_t;
')

system_data_files_type(qnetcfgmgr_etc_data_t)
files_read_etc_files(qnetcfgmgr_t)
data_rw_system_data_files(qnetcfgmgr_dhcp_t, qnetcfgmgr_etc_data_t)
data_rw_system_data_files(qnetcfgmgr_t, qnetcfgmgr_etc_data_t)
data_rw_system_data_files(qnetcfgmgr_macsec_t, qnetcfgmgr_etc_data_t)
manage_system_data_files(qnetcfgmgr_t, qnetcfgmgr_etc_data_t, qnetcfgmgr_etc_data_t)

allow qnetcfgmgr_t qnetcfgmgr_macsec_exec_t:file { read open getattr };

read_system_data_files(NetworkManager_t, qnetcfgmgr_etc_data_t)
networkmanager_domtrans(qnetcfgmgr_t)
allow qnetcfgmgr_t NetworkManager_exec_t:file { getattr execute read open execute_no_trans };

allow qnetcfgmgr_t NetworkManager_t:unix_dgram_socket { sendto };
allow NetworkManager_t qnetcfgmgr_t:netlink_route_socket { read write };

# Ifconfig and IP commands
sysnet_domtrans_ifconfig(qnetcfgmgr_t)
iptables_domtrans(qnetcfgmgr_t)
sysnet_domtrans_dhcpc(qnetcfgmgr_t)


# Netlink sockets
allow qnetcfgmgr_t self:{ netlink_route_socket netlink_generic_socket netlink_socket } create_socket_perms;

# Need to create socket context & provide access directly
type qnetcfgmgr_socket_device_t;
files_type(qnetcfgmgr_socket_device_t)
dev_node(qnetcfgmgr_socket_device_t)
device_manage_socket_file(qnetcfgmgr_t, qnetcfgmgr_socket_device_t)
device_rw_socket_files(qnetcfgmgr_t, qnetcfgmgr_socket_device_t)

allow qnetcfgmgr_t self:socket { rw_socket_perms create };
allow qnetcfgmgr_t self:unix_dgram_socket { sendto };

system_data_files_type(qnetcfgmgr_rt_table_t);

allow qnetcfgmgr_rt_table_t fs_t:filesystem associate;

allow qnetcfgmgr_t proc_net_t:file read;
read_lnk_files_pattern(qnetcfgmgr_t, proc_net_t, qnetcfgmgr_t)
read_files_pattern(qnetcfgmgr_t, proc_net_t, qnetcfgmgr_t);

read_lnk_files_pattern(qnetcfgmgr_t, proc_t, qnetcfgmgr_t)
read_files_pattern(qnetcfgmgr_t, proc_t, qnetcfgmgr_t)

allow qnetcfgmgr_t qnetcfgmgr_rt_table_t:file getattr;
allow qnetcfgmgr_t qrtr_ns_t:dir { getattr search };
allow qnetcfgmgr_t qrtr_ns_t:file { read open };
allow qnetcfgmgr_t self:fifo_file ioctl;
allow qnetcfgmgr_t self:netlink_route_socket nlmsg_read;
allow qnetcfgmgr_t self:qipcrtr_socket { write create getattr read };
allow qnetcfgmgr_t self:tcp_socket { create ioctl read write };
allow qnetcfgmgr_t self:udp_socket { create ioctl read write };
allow qnetcfgmgr_t syslogd_t:dir { getattr search };
allow qnetcfgmgr_t syslogd_t:file { read open write };
allow qnetcfgmgr_t tftp_server_t:dir { search getattr read };
allow qnetcfgmgr_t tftp_server_t:file { read open };
allow qnetcfgmgr_t udev_t:dir { getattr search };
allow qnetcfgmgr_t udev_t:file { read open };

allow ifconfig_t qnetcfgmgr_rt_table_t:file { read getattr open write };
allow ifconfig_t qnetcfgmgr_t:netlink_route_socket { read write };

dontaudit qnetcfgmgr_t domain:file getattr;
dontaudit qnetcfgmgr_t domain:dir getattr;

# QNet_Config_Manager conf files
type qcm_etc_t;
files_type(qcm_etc_t)
logging_send_syslog_msg(qnetcfgmgr_t)
allow qnetcfgmgr_t self:fifo_file { read getattr write };
allow qnetcfgmgr_t self:netlink_kobject_uevent_socket { create bind setopt read };
corecmd_exec_shell(qnetcfgmgr_t)
allow qnetcfgmgr_t sysctl_t:dir search;
allow qnetcfgmgr_t sysctl_net_t:dir search;
allow qnetcfgmgr_t sysctl_net_t:file { write open };

kernel_read_system_state(qnetcfgmgr_t)
allow qnetcfgmgr_t mnt_t:dir search;
allow qnetcfgmgr_t self:process { sigkill };
files_read_etc_files(qnetcfgmgr_t)
files_read_etc_files(qcm_etc_t)
allow qcm_etc_t qcm_etc_t:file rw_file_perms;
dontaudit qnetcfgmgr_t self:capability2 block_suspend;
init_read_state(qnetcfgmgr_t)
allow qnetcfgmgr_t init_t:unix_stream_socket connectto;
allow qnetcfgmgr_t init_var_run_t:sock_file write;
allow qnetcfgmgr_t self:capability { kill net_admin };
systemd_status_power_units(qnetcfgmgr_t)
systemd_start_power_units(qnetcfgmgr_t)
allow qnetcfgmgr_t sysctl_t:file { getattr open write };
allow qnetcfgmgr_t systemd_logind_var_run_t:sock_file write;
dontaudit qnetcfgmgr_t default_t:dir { search };
allow qnetcfgmgr_t self:process { getcap signal };
dev_rw_sysfs(qnetcfgmgr_t)
dontaudit qnetcfgmgr_t event_device_t:chr_file { getattr read open write ioctl };
