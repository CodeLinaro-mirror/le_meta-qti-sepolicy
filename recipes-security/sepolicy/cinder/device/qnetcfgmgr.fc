# QNet executables
/usr/bin/QNet_Config_Manager       		-- gen_context(system_u:object_r:qnetcfgmgr_exec_t,s0)
/usr/bin/QNet_Config_Manager_Client     --  gen_context(system_u:object_r:qnetcfgmgr_exec_t,s0)

# Script files
/etc/data/macsec_eth01\.sh       		-- gen_context(system_u:object_r:qnetcfgmgr_macsec_exec_t,s0)
/etc/data/ethernetcfm\.sh       		-- gen_context(system_u:object_r:qnetcfgmgr_cfm_exec_t,s0)

# /etc/data Files
/etc/data/qnetmgr_cfg_qdu\.xml       		-- gen_context(system_u:object_r:qnetcfgmgr_etc_data_t,s0)
/etc/data/qnetmgr_cfg_qru\.xml       		-- gen_context(system_u:object_r:qnetcfgmgr_etc_data_t,s0)
/etc/data/qnetmgr_persistent_cfg_qru\.xml       		-- gen_context(system_u:object_r:qnetcfgmgr_etc_data_t,s0)
/etc/data/wpa_supplicant\.conf   		-- gen_context(system_u:object_r:qnetcfgmgr_etc_data_t,s0)
/etc/data/dhcp/* 				 		  -- gen_context(system_u:object_r:qnetcfgmgr_etc_data_t,s0)

# Files
/var/run/dhclient*\.pid\.*				-- gen_context(system_u:object_r:qnetcfgmgr_var_t,s0)
/var/run/data/rt_tables\.tmp				-- gen_context(system_u:object_r:qnetcfgmgr_rt_table_t,s0)
/etc/data/iproute2/rt_tables			-- gen_context(system_u:object_r:qnetcfgmgr_rt_table_t,s0)
/proc/sys/net/ipv6/conf/				-- gen_context(system_u:object_r:qnetcfgmgr_ipv6_net_t,s0)
/sys/devices/soc0/chip_id				 --  gen_context(system_u:object_r:qnetcfgmgr_chip_t,s0)

# Tools
/usr/bin/dig							-- gen_context(system_u:object_r:qnetcfgmgr_dig_exec_t,s0)
/usr/bin/dhclient						-- gen_context(system_u:object_r:qnetcfgmgr_dhcp_exec_t,s0)
/usr/sbin/wpa_supplicant-2\.9			-- gen_context(system_u:object_r:NetworkManager_exec_t,s0)
