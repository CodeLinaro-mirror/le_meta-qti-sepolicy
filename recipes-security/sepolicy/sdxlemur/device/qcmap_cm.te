allow qcmap_cm_t tmpfs_t:dir { search };
auditallow qcmap_cm_t tmpfs_t:dir { search };
userdebug_or_eng(`
    gen_require(`
        type debugfs_t;
    ')

    allow qcmap_cm_t debugfs_t:file {rw_file_perms};
')

gen_require(`
    type pmip_service_exec_t;
    type pmip_service_t;
')

ifdef(`init_systemd',`
    allow qcmap_cm_t pmip_service_exec_t:service { start stop status };
')

allow qcmap_cm_t pmip_service_t:unix_dgram_socket sendto;
allow qcmap_cm_t socket_device_t:sock_file write;
read_lnk_files_pattern(qcmap_cm_t, proc_t, pmip_service_t)
read_files_pattern(qcmap_cm_t, proc_t, pmip_service_t)
device_rw_socket_files(qcmap_cm_t, socket_device_t)