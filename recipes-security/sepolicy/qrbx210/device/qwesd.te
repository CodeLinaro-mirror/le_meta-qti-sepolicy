policy_module(qwesd, 1.0)

type qwesd_t;
type qwesd_exec_t;
init_script_domain(qwesd_t, qwesd_exec_t)

gen_require(`
  type init_t;
  type persist_t;
  type qseecomd_persist_t;
  type data_t;
')

mls_file_read_all_levels(qwesd_t)
mls_file_write_all_levels(qwesd_t)
dev_write_kmsg(qwesd_t)
allow qwesd_t data_t:dir { read getattr };
filetrans_pattern(qwesd_t, persist_t, qseecomd_persist_t, { file dir })
allow qwesd_t qseecomd_persist_t:dir manage_dir_perms;
allow qwesd_t self:fifo_file rw_fifo_file_perms;
dev_read_sysfs(qwesd_t)
kernel_read_system_state(qwesd_t)
