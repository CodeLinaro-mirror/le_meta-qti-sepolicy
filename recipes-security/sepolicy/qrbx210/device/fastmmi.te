policy_module(fastmmi, 1.0)

########################################
#
# Declarations
#

type fastmmi_t;
type fastmmi_exec_t;

init_daemon_domain(fastmmi_t, fastmmi_exec_t)
servicemanager_binder_use(fastmmi_t)

type fastmmi_data_file_t;
user_data_files_type(fastmmi_data_file_t)

type fastmmi_config_file_t;

userdebug_or_eng(`
    gen_require(`
        type fastmmi_data_file_t;
        type socket_device_t;
        type proc_t;
        type fastmmi_t;
        type sysfs_t;
        type alogd_t;
        type removable_device_t;
        type btprop_exec_t;
        type devlog_t;
        type init_var_run_t;
        type shell_exec_t;
        type syslogd_t;
        type syslogd_var_run_t;
        type target_etc_t;
    ')

    type fastmmi_sock_t;
    files_type(fastmmi_sock_t)
    dev_node(fastmmi_sock_t)
    device_search_sockets(fastmmi_t)

    data_filetrans(fastmmi_t, fastmmi_data_file_t, { file dir })
    manage_user_data_files(fastmmi_t, fastmmi_data_file_t)
    manage_fastmmi_data_files(fastmmi_t)
    device_manage_socket_file(fastmmi_t, fastmmi_sock_t, "mmi")

    allow fastmmi_t alogd_t:unix_stream_socket connectto;
    allow fastmmi_t btprop_exec_t:file { read map execute open execute_no_trans };
    allow fastmmi_t devlog_t:sock_file write;
    allow fastmmi_t fastmmi_data_file_t:fifo_file create;
    allow fastmmi_t fastmmi_config_file_t:dir { search_dir_perms read };
    allow fastmmi_t fastmmi_config_file_t:file read_file_perms;
    allow fastmmi_t init_var_run_t:dir search;
    allow fastmmi_t proc_t:file read_file_perms;
    allow fastmmi_t removable_device_t:blk_file { open read write };
    allow fastmmi_t self:capability { dac_override sys_nice };
    allow fastmmi_t self:capability2 block_suspend;
    allow fastmmi_t self:fifo_file rw_fifo_file_perms;
    allow fastmmi_t self:process setsched;
    allow fastmmi_t self:unix_stream_socket { listen accept connectto };
    allow fastmmi_t sysfs_t:dir { read };
    allow fastmmi_t sysfs_t:file read_file_perms;
    allow fastmmi_t sysfs_t:lnk_file { read };
    allow fastmmi_t syslogd_t:unix_dgram_socket sendto;
    allow fastmmi_t syslogd_var_run_t:dir search;
    allow fastmmi_t target_etc_t:file { getattr read open };
')
