policy_module(iotedge, 1.0)

########################################
#
# Declarations
#

type iotedge_t;
type iotedge_exec_t;

init_daemon_domain(iotedge_t, iotedge_exec_t)

type iotedge_config_t;
files_config_file(iotedge_config_t)

type iotedge_unit_t;
init_unit_file(iotedge_unit_t)

type iotedge_run_t;
files_pid_file(iotedge_run_t)

init_named_socket_activation(iotedge_t, iotedge_run_t)

type iotedge_data_t;
files_type(iotedge_data_t)

########################################
#
# IoT Edge local policy
#

gen_require(`
        type data_t;
        type systemd_resolved_var_run_t;
')

allow iotedge_t self:fifo_file rw_fifo_file_perms;
allow iotedge_t self:process getsched;

allow iotedge_t data_t:dir search_dir_perms;

files_search_boot(iotedge_t)

miscfiles_read_generic_certs(iotedge_t)

files_read_etc_files(iotedge_t)
files_search_var_lib(iotedge_t)

read_files_pattern(iotedge_t, systemd_resolved_var_run_t, systemd_resolved_var_run_t)

corenet_tcp_connect_http_port(iotedge_t)

init_search_run(iotedge_t)

sysnet_dns_name_resolve(iotedge_t)

docker_stream_connect(iotedge_t)

manage_dirs_pattern(iotedge_t, iotedge_config_t, iotedge_config_t)
manage_files_pattern(iotedge_t, iotedge_config_t, iotedge_config_t)

manage_dirs_pattern(iotedge_t, iotedge_run_t, iotedge_run_t)
manage_fifo_files_pattern(iotedge_t, iotedge_run_t, iotedge_run_t)
manage_files_pattern(iotedge_t, iotedge_run_t, iotedge_run_t)
manage_lnk_files_pattern(iotedge_t, iotedge_run_t, iotedge_run_t)
manage_sock_files_pattern(iotedge_t, iotedge_run_t, iotedge_run_t)
files_pid_filetrans(iotedge_t, iotedge_run_t, { dir file lnk_file sock_file })

manage_dirs_pattern(iotedge_t, iotedge_data_t, iotedge_data_t)
manage_files_pattern(iotedge_t, iotedge_data_t, iotedge_data_t)
