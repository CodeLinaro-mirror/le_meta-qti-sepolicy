policy_module(docker, 1.0)

########################################
#
# Declarations
#

type docker_t;
type docker_exec_t;

init_daemon_domain(docker_t, docker_exec_t)
can_exec(docker_t, docker_exec_t)

type docker_config_t;
files_config_file(docker_config_t)

type docker_unit_t;
init_unit_file(docker_unit_t)

type docker_run_t;
files_pid_file(docker_run_t)

init_named_socket_activation(docker_t, docker_run_t)

type docker_data_t;
files_type(docker_data_t)

type docker_data_ro_t;
files_mountpoint(docker_data_ro_t)

type docker_tmp_t;
files_tmp_file(docker_tmp_t)

type docker_tmpfs_t;
files_tmpfs_file(docker_tmpfs_t)

type docker_devpts_t;
term_pty(docker_devpts_t)

########################################
#
# Docker local policy
#

gen_require(`
        type data_t;
        type init_var_run_t;
        type sysctl_irq_t;
        type sysctl_t;
        type systemd_logind_var_run_t;
        type systemd_resolved_var_run_t;
')

allow docker_t self:capability { chown dac_override dac_read_search fowner fsetid kill net_admin setfcap setgid setpcap setuid sys_admin sys_chroot sys_resource };
allow docker_t self:fifo_file { getattr ioctl lock read setattr write };
allow docker_t self:key { setattr search view };
allow docker_t self:netlink_netfilter_socket { bind create getattr read setopt write };
allow docker_t self:netlink_route_socket nlmsg_write;
allow docker_t self:netlink_xfrm_socket { bind create setopt };
allow docker_t self:process { execmem getcap getsched getsession setcap setpgid setsched sigkill signal signull };
allow docker_t self:tcp_socket { accept listen };
allow docker_t self:unix_stream_socket connectto;

allow docker_t data_t:dir search_dir_perms;

allow docker_t docker_data_ro_t:file mounton;
allow docker_t docker_data_t:{ dir file } mounton;
allow docker_t docker_run_t:file mounton;
allow docker_t docker_tmpfs_t:dir mounton;
allow docker_t proc_t:file mounton;
allow docker_t sysctl_irq_t:dir mounton;
allow docker_t sysctl_t:{ dir file } mounton;

miscfiles_read_generic_certs(docker_t)

corenet_tcp_bind_all_unreserved_ports(docker_t)
corenet_tcp_bind_amqp_port(docker_t)
corenet_tcp_bind_generic_node(docker_t)
corenet_tcp_bind_http_port(docker_t)
corenet_tcp_connect_amqp_port(docker_t)
corenet_tcp_connect_http_port(docker_t)
corenet_udp_bind_generic_node(docker_t)

files_read_etc_files(docker_t)

init_read_script_state(docker_t)
init_read_state(docker_t)
init_search_run(docker_t)

read_files_pattern(docker_t, systemd_resolved_var_run_t, systemd_resolved_var_run_t)

write_sock_files_pattern(docker_t, init_var_run_t, init_var_run_t)
write_sock_files_pattern(docker_t, systemd_logind_var_run_t, systemd_logind_var_run_t)

sysnet_dns_name_resolve(docker_t)

iotedge_stream_connect(docker_t)

manage_dirs_pattern(docker_t, docker_config_t, docker_config_t)
manage_files_pattern(docker_t, docker_config_t, docker_config_t)

manage_dirs_pattern(docker_t, docker_run_t, docker_run_t)
manage_fifo_files_pattern(docker_t, docker_run_t, docker_run_t)
manage_files_pattern(docker_t, docker_run_t, docker_run_t)
manage_lnk_files_pattern(docker_t, docker_run_t, docker_run_t)
manage_sock_files_pattern(docker_t, docker_run_t, docker_run_t)
files_pid_filetrans(docker_t, docker_run_t, { dir file lnk_file sock_file })

manage_blk_files_pattern(docker_t, docker_data_t, docker_data_t)
manage_dirs_pattern(docker_t, docker_data_t, docker_data_t)
manage_fifo_files_pattern(docker_t, docker_data_t, docker_data_t)
manage_files_pattern(docker_t, docker_data_t, docker_data_t)
manage_lnk_files_pattern(docker_t, docker_data_t, docker_data_t)
manage_sock_files_pattern(docker_t, docker_data_t, docker_data_t)
can_exec(docker_t, docker_data_t)

manage_files_pattern(docker_t, docker_data_ro_t, docker_data_ro_t)
filetrans_pattern(docker_t, docker_data_t, docker_data_ro_t, file, "hostname")
filetrans_pattern(docker_t, docker_data_t, docker_data_ro_t, file, "hosts")

manage_dirs_pattern(docker_t, docker_tmp_t, docker_tmp_t)
manage_files_pattern(docker_t, docker_tmp_t, docker_tmp_t)
manage_lnk_files_pattern(docker_t, docker_tmp_t, docker_tmp_t)
manage_sock_files_pattern(docker_t, docker_tmp_t, docker_tmp_t)
files_tmp_filetrans(docker_t, docker_tmp_t, { dir file lnk_file })

manage_chr_files_pattern(docker_t, docker_tmpfs_t, docker_tmpfs_t)
manage_dirs_pattern(docker_t, docker_tmpfs_t, docker_tmpfs_t)
manage_files_pattern(docker_t, docker_tmpfs_t, docker_tmpfs_t)
manage_lnk_files_pattern(docker_t, docker_tmpfs_t, docker_tmpfs_t)
fs_tmpfs_filetrans(docker_t, docker_tmpfs_t, { dir file })

read_chr_files_pattern(docker_t, docker_devpts_t, docker_devpts_t)
setattr_chr_files_pattern(docker_t, docker_devpts_t, docker_devpts_t)
term_create_pty(docker_t, docker_devpts_t)

modutils_exec_insmod(docker_t)
modutils_manage_module_config(docker_t)
modutils_read_module_deps(docker_t)

kernel_getattr_message_if(docker_t)
kernel_mounton_proc(docker_t)
kernel_read_all_sysctls(docker_t)
kernel_read_network_state(docker_t)
kernel_read_system_state(docker_t)
kernel_rw_net_sysctls(docker_t)

fs_getattr_tmpfs(docker_t)
fs_getattr_xattr_fs(docker_t)
fs_manage_cgroup_dirs(docker_t)
fs_manage_cgroup_files(docker_t)
fs_mount_all_fs(docker_t)
fs_read_cgroup_files(docker_t)
fs_read_nsfs_files(docker_t)
fs_remount_all_fs(docker_t)
fs_unmount_all_fs(docker_t)
fs_unmount_xattr_fs(docker_t)

dev_mounton_sysfs(docker_t)
dev_read_sysfs(docker_t)

files_mounton_root(docker_t)
files_read_kernel_symbol_table(docker_t)

optional_policy(`
        iptables_domtrans(docker_t)
')

optional_policy(`
        dbus_system_bus_client(docker_t)
        init_dbus_chat(docker_t)

        optional_policy(`
                systemd_dbus_chat_logind(docker_t)
        ')
')
