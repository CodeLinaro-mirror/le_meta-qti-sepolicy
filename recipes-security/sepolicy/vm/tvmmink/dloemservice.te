policy_module(dloemservice, 1.0)

########################################
#
# Declarations
#

type dloemservice_t;
type dloemservice_exec_t;

init_vendor_domain(dloemservice_t, dloemservice_exec_t)

gen_require(`
type tvmmink_t;
type tvmmink_sock_t;
type tvmapploader_data_t;
type tvmroot_tmpfs_t;
type socket_device_t;
')

manage_user_data_files(dloemservice_t, tvmapploader_data_t)
platform_container_domain_type(dloemservice_t, dloemservice_exec_t)

# Downloadable TPs domain transition
allow dloemservice_t socket_device_t:dir search;

# For tuiapp
allow dloemservice_t self:capability2 block_suspend;
allow dloemservice_t tvmapploader_data_t:file { getattr read open };

# permissions for /sys/power/wake_lock /sys/power/wake_unlock
dev_rw_sysfs(dloemservice_t)

# Enable backtrace handler
allow dloemservice_t self:process signal;

type dloemservice_tmpfs_t;
files_tmpfs_file(dloemservice_tmpfs_t)

fs_tmpfs_filetrans(dloemservice_t, dloemservice_tmpfs_t, file)
allow dloemservice_t dloemservice_tmpfs_t:file { manage_file_perms mounton };
