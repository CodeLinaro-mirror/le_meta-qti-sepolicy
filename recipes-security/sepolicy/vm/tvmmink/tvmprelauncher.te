policy_module(tvmprelauncher, 1.0)

########################################
#
# Declarations
#

type tvmprelauncher_t;
type tvmprelauncher_exec_t;
type tvmprelauncher_sock_t;

init_vendor_domain(tvmprelauncher_t, tvmprelauncher_exec_t)
device_manage_socket_file(tvmprelauncher_t, tvmprelauncher_sock_t)

gen_require(`
type device_t;
type smcinvoke_device_t;
type tvmmink_t;
type tvmmink_tmpfs_t;
type tvmroot_t;
type tvmroot_sock_t;
')

allow tvmprelauncher_t self:process signal;
allow tvmprelauncher_t self:qipcrtr_socket { create setopt getattr write read connect shutdown };
allow tvmprelauncher_t self:unix_stream_socket { listen accept };
allow tvmprelauncher_t smcinvoke_device_t:chr_file { getattr read write open ioctl };
allow tvmprelauncher_t tvmmink_t:fd use;
allow tvmprelauncher_t tvmroot_t:unix_stream_socket { read write connectto };
allow tvmprelauncher_t tvmroot_sock_t:sock_file write;
platform_container_domain_type(tvmprelauncher_t, tvmprelauncher_exec_t)

allow tvmprelauncher_sock_t device_t:filesystem associate;

# /tmp/minijail.dev.xxx/smcinvoke
gen_require(`
    bool allow_minijail_mount;
')
type tvmprelauncher_tmpfs_t;
files_tmpfs_file(tvmprelauncher_tmpfs_t)
if (allow_minijail_mount) {
    fs_tmpfs_filetrans(tvmprelauncher_t, tvmprelauncher_tmpfs_t, file)
    allow tvmprelauncher_t tvmprelauncher_tmpfs_t:file { manage_file_perms mounton };
}

# For sem
allow tvmprelauncher_t tvmprelauncher_tmpfs_t:file { map };
allow tvmprelauncher_t tvmmink_tmpfs_t:file { open getattr map read write };

# Only mink can access the socket for prelauncher
gen_require(`
    type tvmmink_t;
')
neverallow { domain -tvmprelauncher_t -tvmmink_t } tvmprelauncher_sock_t:sock_file rw_sock_file_perms;

gen_require(`
    type socket_device_t;
')
platform_container_bind_mount(tvmprelauncher_t, smcinvoke_device_t, chr_file)
platform_container_bind_mount(tvmprelauncher_t, socket_device_t, dir)
