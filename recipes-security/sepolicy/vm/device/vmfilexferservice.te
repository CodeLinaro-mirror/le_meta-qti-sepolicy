gen_require(`
  type socket_device_t;
  type tvmroot_t;
  type tvmmink_sock_t;
')

allow vmfilexferservice_t tvmmink_sock_t:sock_file getattr;
allow vmfilexferservice_t socket_device_t:dir { search getattr };
allow vmfilexferservice_t self:process { setsched signal };

logging_send_syslog_msg(vmfilexferservice_t)
platform_container_domain_type(vmfilexferservice_t, vmfilexferservice_exec_t);
dontaudit vmfilexferservice_t tvmroot_t:unix_stream_socket { read write };

#permissions for /sys/power/wake_lock /sys/power/wake_unlock
dev_rw_sysfs(vmfilexferservice_t)
allow vmfilexferservice_t self:capability2 block_suspend;

platform_container_domain_type(vmfilexferservice_t, vmfilexferservice_exec_t)

# /dev/membuf
gen_require(`
    type tuicoreservice_dev_t;
')
platform_container_bind_mount(vmfilexferservice_t, tuicoreservice_dev_t, chr_file)
