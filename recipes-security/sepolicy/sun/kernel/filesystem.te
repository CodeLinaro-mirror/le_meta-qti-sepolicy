type sys_power_sysfs_t;
genfscon sysfs /power  gen_context(system_u:object_r:sys_power_sysfs_t,s0)
dev_associate_sysfs(sys_power_sysfs_t);

type ts_hugepage_sysfs_t;
genfscon sysfs /kernel/mm/transparent_hugepage gen_context(system_u:object_r:ts_hugepage_sysfs_t,s0)
genfscon sysfs /kernel/mm/transparent_hugepage/khugepaged gen_context(system_u:object_r:ts_hugepage_sysfs_t,s0)
dev_associate_sysfs(ts_hugepage_sysfs_t);
