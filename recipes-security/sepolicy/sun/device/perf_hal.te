dontaudit perf_hal_t self:capability sys_admin;

gen_require(`
    type sysfs_cpu_capacity;
    type soc0_gpu_sysfs_t;
    type drm_card_sysfs_t;
')

allow perf_hal_t sysfs_cpu_capacity:file read_file_perms;
allow perf_hal_t soc0_gpu_sysfs_t:file read_file_perms;
allow perf_hal_t drm_card_sysfs_t:dir search;
allow perf_hal_t drm_card_sysfs_t:file read_file_perms;
